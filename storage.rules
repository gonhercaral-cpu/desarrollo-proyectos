rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return signedIn()
        && firestore.exists(userPath());
    }

    function userDoc() {
      return firestore.get(userPath());
    }

    function hasProfile() {
      return hasUserDoc()
        && userDoc().data.active == true;
    }

    function hasUserArea() {
      return hasProfile()
        && userDoc().data.area is string;
    }

    function isAdmin() {
      return hasProfile()
        && userDoc().data.role == "admin";
    }

    function isPrintshopUser() {
      return hasProfile()
        && hasUserArea()
        && (
          userDoc().data.area == "Imprenta" ||
          userDoc().data.area == "Impresión" ||
          userDoc().data.area == "Impresion"
        );
    }

    function isTechnicalSupportUser() {
      return hasProfile()
        && hasUserArea()
        && (
          userDoc().data.area == "Soporte Técnico" ||
          userDoc().data.area == "Soporte tecnico" ||
          userDoc().data.area == "Soporte técnico"
        );
    }

    function canAccessPrintshop() {
      return isAdmin()
        || isPrintshopUser()
        || isTechnicalSupportUser();
    }

    function canAccessTechnicalSupport() {
      return isAdmin() || isTechnicalSupportUser();
    }

    function printRequestPath(requestId) {
      return /databases/(default)/documents/printRequests/$(requestId);
    }

    function printRequestExists(requestId) {
      return firestore.exists(printRequestPath(requestId));
    }

    function printRequestData(requestId) {
      return firestore.get(printRequestPath(requestId)).data;
    }

    function profileEmailMatches(value) {
      return hasProfile()
        && value is string
        && userDoc().data.email is string
        && value == userDoc().data.email;
    }

    function profileNameMatches(value) {
      return hasProfile()
        && value is string
        && userDoc().data.name is string
        && value == userDoc().data.name;
    }

    function isPrintRequestAssignedData(printRequest) {
      return hasProfile()
        && (
          ("responsibleUid" in printRequest && printRequest.responsibleUid is string && printRequest.responsibleUid == request.auth.uid) ||
          ("assignedToUid" in printRequest && printRequest.assignedToUid is string && printRequest.assignedToUid == request.auth.uid) ||
          ("productionAssigneeUid" in printRequest && printRequest.productionAssigneeUid is string && printRequest.productionAssigneeUid == request.auth.uid) ||
          ("assignedCollaboratorUid" in printRequest && printRequest.assignedCollaboratorUid is string && printRequest.assignedCollaboratorUid == request.auth.uid) ||
          ("responsibleId" in printRequest && printRequest.responsibleId is string && printRequest.responsibleId == request.auth.uid) ||
          ("responsibleEmail" in printRequest && profileEmailMatches(printRequest.responsibleEmail)) ||
          ("assignedToEmail" in printRequest && profileEmailMatches(printRequest.assignedToEmail)) ||
          ("productionAssigneeEmail" in printRequest && profileEmailMatches(printRequest.productionAssigneeEmail)) ||
          ("responsibleName" in printRequest && profileNameMatches(printRequest.responsibleName)) ||
          ("assignedToName" in printRequest && profileNameMatches(printRequest.assignedToName)) ||
          ("productionAssigneeName" in printRequest && profileNameMatches(printRequest.productionAssigneeName))
        );
    }

    function isPrintRequestSupportData(printRequest) {
      return hasProfile()
        && (
          ("collaboratorUid" in printRequest && printRequest.collaboratorUid is string && printRequest.collaboratorUid == request.auth.uid) ||
          ("collaboratorId" in printRequest && printRequest.collaboratorId is string && printRequest.collaboratorId == request.auth.uid) ||
          ("supportCollaboratorUid" in printRequest && printRequest.supportCollaboratorUid is string && printRequest.supportCollaboratorUid == request.auth.uid) ||
          ("productionSupportUid" in printRequest && printRequest.productionSupportUid is string && printRequest.productionSupportUid == request.auth.uid) ||
          ("supportUid" in printRequest && printRequest.supportUid is string && printRequest.supportUid == request.auth.uid) ||
          ("supportCollaboratorIds" in printRequest && printRequest.supportCollaboratorIds is list && request.auth.uid in printRequest.supportCollaboratorIds) ||
          ("supportCollaborators" in printRequest && printRequest.supportCollaborators is list && request.auth.uid in printRequest.supportCollaborators) ||
          ("collaboratorUids" in printRequest && printRequest.collaboratorUids is list && request.auth.uid in printRequest.collaboratorUids) ||
          ("collaboratorIds" in printRequest && printRequest.collaboratorIds is list && request.auth.uid in printRequest.collaboratorIds) ||
          ("collaboratorEmail" in printRequest && profileEmailMatches(printRequest.collaboratorEmail)) ||
          ("supportCollaboratorEmail" in printRequest && profileEmailMatches(printRequest.supportCollaboratorEmail)) ||
          ("productionSupportEmail" in printRequest && profileEmailMatches(printRequest.productionSupportEmail)) ||
          ("supportEmail" in printRequest && profileEmailMatches(printRequest.supportEmail)) ||
          ("collaboratorName" in printRequest && profileNameMatches(printRequest.collaboratorName)) ||
          ("supportCollaboratorName" in printRequest && profileNameMatches(printRequest.supportCollaboratorName)) ||
          ("productionSupportName" in printRequest && profileNameMatches(printRequest.productionSupportName)) ||
          ("supportName" in printRequest && profileNameMatches(printRequest.supportName))
        );
    }

    function isPrintRequestMemberData(printRequest) {
      return isPrintRequestAssignedData(printRequest) || isPrintRequestSupportData(printRequest);
    }

    function canAccessPrintRequest(requestId) {
      return canAccessPrintshop()
        || (
          hasProfile()
          && printRequestExists(requestId)
          && isPrintRequestMemberData(printRequestData(requestId))
        );
    }

    function projectPath(projectId) {
      return /databases/(default)/documents/projects/$(projectId);
    }

    function projectExists(projectId) {
      return firestore.exists(projectPath(projectId));
    }

    function projectData(projectId) {
      return firestore.get(projectPath(projectId)).data;
    }

    function isAssignedToProject(projectId) {
      return hasProfile()
        && projectExists(projectId)
        && (
          projectData(projectId).assignedToUid == request.auth.uid ||
          projectData(projectId).assignedToId == request.auth.uid ||
          projectData(projectId).assignedTo == request.auth.uid ||
          projectData(projectId).responsibleUid == request.auth.uid ||
          projectData(projectId).responsibleId == request.auth.uid
        );
    }

    function isCollaboratorInProject(projectId) {
      return hasProfile()
        && projectExists(projectId)
        && (
          (
            projectData(projectId).collaboratorIds is list
            && request.auth.uid in projectData(projectId).collaboratorIds
          )
          ||
          (
            projectData(projectId).collaboratorUids is list
            && request.auth.uid in projectData(projectId).collaboratorUids
          )
        );
    }

    function isCreatorOfProject(projectId) {
      return hasProfile()
        && projectExists(projectId)
        && (
          projectData(projectId).createdByUid == request.auth.uid ||
          projectData(projectId).createdBy == request.auth.uid
        );
    }

    function canAccessProject(projectId) {
      return hasProfile()
        && projectExists(projectId)
        && (
          isAdmin() ||
          isAssignedToProject(projectId) ||
          isCollaboratorInProject(projectId) ||
          isCreatorOfProject(projectId)
        );
    }

    function validEvidenceSize() {
      return request.resource.size < 25 * 1024 * 1024;
    }



    function ideaDocumentPath(ideaId) {
      return /databases/(default)/documents/ideas/$(ideaId);
    }

    function ideaDocumentExists(ideaId) {
      return firestore.exists(ideaDocumentPath(ideaId));
    }

    function ideaDocumentData(ideaId) {
      return firestore.get(ideaDocumentPath(ideaId)).data;
    }

    function canReadIdeaEvidence(ideaId) {
      return hasProfile()
        && ideaDocumentExists(ideaId)
        && (
          isAdmin()
          || ideaDocumentData(ideaId).createdByUid == request.auth.uid
        );
    }

    function validIdeaEvidenceFile() {
      return request.resource.size < 25 * 1024 * 1024;
    }

    function validTechnicalInstallationEvidenceFile() {
      return (
          request.resource.contentType.matches('image/(jpeg|png|webp)')
          && request.resource.size < 10 * 1024 * 1024
        ) || (
          request.resource.contentType in ['video/mp4', 'video/quicktime', 'video/webm']
          && request.resource.size < 100 * 1024 * 1024
        );
    }

    function validSignatureImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    function validCertificateTemplateImage() {
      return request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    function validGeneratedCertificatePdf() {
      return request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == "application/pdf";
    }


    function isAllowedDashboardAttachmentType() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('audio/.*')
        || request.resource.contentType.matches('video/.*')
        || request.resource.contentType == "application/pdf"
        || request.resource.contentType == "text/plain"
        || request.resource.contentType == "text/csv"
        || request.resource.contentType == "application/zip"
        || request.resource.contentType == "application/msword"
        || request.resource.contentType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        || request.resource.contentType == "application/vnd.ms-excel"
        || request.resource.contentType == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        || request.resource.contentType == "application/vnd.ms-powerpoint"
        || request.resource.contentType == "application/vnd.openxmlformats-officedocument.presentationml.presentation"
        || request.resource.contentType == "application/octet-stream";
    }

    function validDashboardAttachmentFile() {
      return isAllowedDashboardAttachmentType()
        && (
          (request.resource.contentType.matches('video/.*')
            && request.resource.size < 80 * 1024 * 1024)
          || (!request.resource.contentType.matches('video/.*')
            && request.resource.size < 25 * 1024 * 1024)
        );
    }

    function validBugReportEvidenceFile() {
      return (
          request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
          && request.resource.size < 15 * 1024 * 1024
        ) || (
          request.resource.contentType in ['video/mp4', 'video/quicktime', 'video/webm']
          && request.resource.size < 120 * 1024 * 1024
        );
    }


    function departmentMessagePath(messageId) {
      return /databases/(default)/documents/departmentMessages/$(messageId);
    }

    function departmentMessageExists(messageId) {
      return firestore.exists(departmentMessagePath(messageId));
    }

    function canReadDepartmentMessageAttachment(messageId) {
      return hasProfile()
        && departmentMessageExists(messageId)
        && (
          isAdmin()
          || request.auth.uid in firestore.get(departmentMessagePath(messageId)).data.memberIds
        );
    }



    /*
      Adjuntos del tablero general de anuncios:
      dashboard/announcements/{announcementId}/{fileName}

      Los colaboradores activos pueden leerlos.
      Solo administradores pueden subir, actualizar o eliminar archivos.
    */
    match /dashboard/announcements/{announcementId}/{fileName} {
      allow read: if hasProfile();

      allow create, update: if signedIn()
        && isAdmin()
        && validDashboardAttachmentFile();

      allow delete: if signedIn() && isAdmin();
    }

    /*
      Adjuntos privados de notas personales:
      dashboard/personalNotes/{userUid}/{noteId}/{fileName}

      Solo el dueño de la nota puede leer, subir o eliminar archivos.
      Los administradores no reciben permiso especial aquí.
    */
    match /dashboard/personalNotes/{userUid}/{noteId}/{fileName} {
      allow read: if signedIn()
        && hasProfile()
        && request.auth.uid == userUid;

      allow create, update: if signedIn()
        && hasProfile()
        && request.auth.uid == userUid
        && validDashboardAttachmentFile();

      allow delete: if signedIn()
        && hasProfile()
        && request.auth.uid == userUid;
    }

    /*
      Adjuntos privados de mensajes internos:
      dashboard/internalMessages/{fromUid}/{toUid}/{messageId}/{fileName}

      Solo el remitente y destinatario pueden leerlos.
      Solo el remitente puede subirlos o eliminarlos.
    */
    match /dashboard/internalMessages/{fromUid}/{toUid}/{messageId}/{fileName} {
      allow read: if signedIn()
        && hasProfile()
        && (request.auth.uid == fromUid || request.auth.uid == toUid);

      allow create, update: if signedIn()
        && hasProfile()
        && request.auth.uid == fromUid
        && validDashboardAttachmentFile();

      allow delete: if signedIn()
        && hasProfile()
        && request.auth.uid == fromUid;
    }


    /*
      Adjuntos de chats por departamento:
      dashboard/departmentMessages/{departmentId}/{fromUid}/{messageId}/{fileName}

      Los miembros incluidos en el mensaje y administradores pueden leerlos.
      Solo el remitente puede subirlos antes de guardar el mensaje.
    */
    match /dashboard/departmentMessages/{departmentId}/{fromUid}/{messageId}/{fileName} {
      allow read: if signedIn()
        && canReadDepartmentMessageAttachment(messageId);

      allow create, update: if signedIn()
        && hasProfile()
        && request.auth.uid == fromUid
        && validDashboardAttachmentFile();

      allow delete: if signedIn()
        && hasProfile()
        && (request.auth.uid == fromUid || isAdmin());
    }

    /*
      Evidencias de instalaciones técnicas:
      technical-installations/{installationId}/evidence/{userUid}/{fileName}
    */
    match /technical-installations/{installationId}/evidence/{userUid}/{fileName} {
      allow read: if hasProfile();

      allow create: if signedIn()
        && canAccessTechnicalSupport()
        && request.auth.uid == userUid
        && validTechnicalInstallationEvidenceFile();

      allow update: if false;

      allow delete: if signedIn() && canAccessTechnicalSupport();
    }

    /*
      Evidencias de proyectos:
      evidence/{projectId}/{userUid}/{fileName}
    */
    match /evidence/{projectId}/{userUid}/{fileName} {
      allow read: if canAccessProject(projectId);

      allow create: if signedIn()
        && hasProfile()
        && request.auth.uid == userUid
        && canAccessProject(projectId)
        && validEvidenceSize();

      allow update, delete: if false;
    }

    /*
      Ruta anterior de evidencias:
      evidence/{projectId}/{fileName}
    */
    match /evidence/{projectId}/{fileName} {
      allow read: if canAccessProject(projectId);

      allow create: if signedIn()
        && hasProfile()
        && canAccessProject(projectId)
        && validEvidenceSize();

      allow update, delete: if false;
    }

    /*
      Firmas para certificados:
      printshop/signatures/principals/{userUid}/{fileName}
      printshop/signatures/teachers/{userUid}/{fileName}
    */
    match /printshop/signatures/{signerType}/{userUid}/{fileName} {
      allow read: if hasProfile();

      allow create, update: if signedIn()
        && isAdmin()
        && request.auth.uid == userUid
        && signerType in ["principals", "teachers"]
        && validSignatureImage();

      allow delete: if isAdmin();
    }

    /*
      Plantillas base para certificados:
      printshop/certificate-templates/{userUid}/{fileName}
    */
    match /printshop/certificate-templates/{userUid}/{fileName} {
      allow read: if hasProfile();

      allow create, update: if signedIn()
        && isAdmin()
        && request.auth.uid == userUid
        && validCertificateTemplateImage();

      allow delete: if isAdmin();
    }

    /*
      Plantillas base para credenciales:
      printshop/credential-templates/front/{userUid}/{fileName}
      printshop/credential-templates/back/{userUid}/{fileName}
    */
    match /printshop/credential-templates/{side}/{userUid}/{fileName} {
      allow read: if canAccessPrintshop();

      allow create, update: if signedIn()
        && isAdmin()
        && request.auth.uid == userUid
        && side in ["front", "back"]
        && validCertificateTemplateImage();

      allow delete: if isAdmin();
    }

    /*
      Imagenes personalizadas de plantillas:
      printshop/template-assets/{userUid}/{fileName}
    */
    match /printshop/template-assets/{userUid}/{fileName} {
      allow read: if hasProfile();

      allow create, update: if signedIn()
        && isAdmin()
        && request.auth.uid == userUid
        && validCertificateTemplateImage();

      allow delete: if isAdmin();
    }

    /*
      Imagenes personalizadas de credenciales:
      printshop/credential-assets/{userUid}/{fileName}
    */
    match /printshop/credential-assets/{userUid}/{fileName} {
      allow read: if canAccessPrintshop();

      allow create, update: if signedIn()
        && isAdmin()
        && request.auth.uid == userUid
        && validCertificateTemplateImage();

      allow delete: if isAdmin();
    }

    /*
      PDF originales de certificados generados:
      printshop/generated-certificates/{requestId}/{year}/{fileName}
      (para certificados individuales sin solicitud, requestId no coincide con
      ningun printRequests y solo canAccessPrintshop() puede subir/leer)
    */
    match /printshop/generated-certificates/{requestId}/{year}/{fileName} {
      allow read: if canAccessPrintRequest(requestId);

      allow create, update: if signedIn()
        && canAccessPrintRequest(requestId)
        && validGeneratedCertificatePdf();

      allow delete: if isAdmin();
    }

    /*
      Ruta anterior de PDFs de certificados generados (compatibilidad de lectura):
      printshop/generated-certificates/{year}/{fileName}
    */
    match /printshop/generated-certificates/{year}/{fileName} {
      allow read: if canAccessPrintshop();

      allow create, update: if false;

      allow delete: if isAdmin();
    }



    /*
      Evidencias de reportes de errores:
      bugReports/{userUid}/{reportId}/{fileName}
    */
    match /bugReports/{userUid}/{reportId}/{fileName} {
      allow read: if signedIn()
        && hasProfile()
        && (isAdmin() || request.auth.uid == userUid);

      allow create: if signedIn()
        && hasProfile()
        && request.auth.uid == userUid
        && validBugReportEvidenceFile();

      allow update: if false;

      allow delete: if signedIn()
        && hasProfile()
        && (isAdmin() || request.auth.uid == userUid);
    }


    /*
      Evidencias de ideas:
      ideas/{userUid}/{ideaId}/evidence/{fileName}
    */
    match /ideas/{userUid}/{ideaId}/evidence/{fileName} {
      allow read: if canReadIdeaEvidence(ideaId);

      allow create: if signedIn()
        && hasProfile()
        && request.auth.uid == userUid
        && canReadIdeaEvidence(ideaId)
        && validIdeaEvidenceFile();

      allow update: if false;

      allow delete: if isAdmin();
    }

    match /digital-signage/assets/{assetId}/{fileName} {
      allow read: if true;

      allow create: if signedIn()
        && isAdmin()
        && request.resource.size < 250 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );

      allow update: if false;

      allow delete: if signedIn() && isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
