{
  "name": "desarrollo-proyectos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "VITE_USE_FIREBASE_EMULATORS=true vite",
    "emulators": "bash scripts/start-firebase-emulators.sh",
    "emulators:seed": "node functions/seedEmulators.js",
    "build": "vite build",
    "lint": "eslint .",
    "test:production": "node --test tests/production-batches.test.cjs",
    "test:operations": "node --test tests/operational-notifications-tools.test.cjs",
    "test:reports": "node --test tests/print-request-report.test.mjs",
    "test:material-corrections": "node --test tests/material-corrections-backend.test.cjs tests/material-corrections-ui.test.mjs",
    "test:active-classroom": "node --test tests/active-classroom-utils.test.mjs",
    "test:rules": "XDG_CONFIG_HOME=.firebase/cli-config firebase emulators:exec --config firebase.rules-test.json --project security-rules-audit --only firestore,storage \"node --test tests/firebase-rules.test.mjs\"",
    "active-classroom:install": "npm --prefix active-classroom-desktop ci",
    "active-classroom:web": "npm --prefix active-classroom-desktop run dev",
    "active-classroom:admin": "npm --prefix active-classroom-desktop run admin:dev",
    "active-classroom:desktop": "npm --prefix active-classroom-desktop run tauri:dev",
    "active-classroom:test": "npm --prefix active-classroom-desktop run admin:test && npm --prefix active-classroom-desktop run local:integration:test",
    "active-classroom:build": "npm --prefix active-classroom-desktop run build",
    "active-classroom:admin:build": "npm --prefix active-classroom-desktop run admin:build",
    "active-classroom:tauri:build": "npm --prefix active-classroom-desktop run tauri:build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "firebase": "^12.15.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "konva": "^10.3.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-konva": "^19.2.5",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
