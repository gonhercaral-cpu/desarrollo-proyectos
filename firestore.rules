    function validPrintRequestDeliveryType(deliveryType) {
      return deliveryType in [
        "Impresa",
        "Digital",
        "Ambas"
      ];
    }

    function validPrintRequestLevel(level) {
      return level in [
        "No aplica",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "Smile 1",
        "Smile 2",
        "Smile 3",
        "Smile 4",
        "Smile 5",
        "Smile 6",
        "Mega Flash",
        "Otro"
      ];
    }

    function isCertificateOrDiplomaRequest() {
      return request.resource.data.requestType in [
        "Certificado",
        "Diploma"
      ];
    }

    function validPrintRequestData() {
      let incomingData = request.resource.data;
      return validNonEmptyStringField(incomingData, "folio")
        && validStringSix(incomingData, "productId", "responsibleUid", "responsibleName", "responsibleEmail", "requestDate", "dueDate")
        && validStringTriple(incomingData, "notes", "group", "teacherName")
        && validStringField(incomingData, "schedule")
        && (validNonEmptyStringField((incomingData), ("productName"))
          && validNonEmptyStringField((incomingData), ("requesterName"))
          && validNonEmptyStringField((incomingData), ("requesterArea"))
          && validNonEmptyStringField((incomingData), ("campus"))
          && validNonEmptyStringField((incomingData), ("assignedUserId"))
          && validNonEmptyStringField((incomingData), ("assignedUserName")))
        && validNonEmptyStringPair(incomingData, "supportUserId", "supportUserName")
        && validOptionalStringSix(incomingData, "requesterId", "collaboratorUid", "collaboratorName", "collaboratorEmail", "certificateIssueDate", "certificateTemplateId")
        && validOptionalStringSix(incomingData, "certificateTemplateName", "certificateTemplateLevel", "certificateTemplateProgramName", "certificateTemplateAudience", "certificateTemplateBodyText", "certificateTemplateImageUrl")
        && validOptionalStringSix(incomingData, "certificateTemplateImageDataUrl", "certificateTemplateStoragePath", "principalSignerId", "principalSignerName", "principalSignerRole", "principalSignatureUrl")
        && validOptionalStringSix(incomingData, "principalSignatureDataUrl", "teacherSignerId", "teacherSignerName", "teacherSignerRole", "teacherSignatureUrl", "teacherSignatureDataUrl")
        && validNonNegativeNumberTriple(incomingData, "deliveredQuantity", "printedQuantity", "digitalQuantity")
        && validOptionalListTriple(incomingData, "certificateTemplateBodySegments", "certificateTemplateCustomTexts", "certificateTemplateCustomImages")
        && (
          (
            incomingData.productId.size() > 0
            && exists(/databases/$(database)/documents/printProducts/$(incomingData.productId))
          )
          || (
            validCertificateTemplateType(incomingData.requestType)
            && validNonEmptyStringField(incomingData, "productName")
          )
        )
        && ((incomingData.requestType) in [
        "Certificado",
        "Diploma",
        "Volante",
        "Vinil",
        "Hoja de canciones",
        "Hoja de actividades",
        "Material interno",
        "Otro"
      ])
        && ((incomingData.priority) in [
        "Baja",
        "Normal",
        "Alta",
        "Urgente"
      ])
        && validNumberField(incomingData, "requestedQuantity")
        && (
          incomingData.requestedQuantity > 0
          || (
            isCertificateOrDiplomaRequest()
            && validListField(incomingData, "students")
            && incomingData.students.size() == 0
            && incomingData.printedQuantity == 0
            && incomingData.digitalQuantity == 0
          )
        )
        && incomingData.deliveredQuantity <= incomingData.requestedQuantity
        && validPrintRequestDeliveryType(incomingData.deliveryType)
        && validPrintRequestStatus(incomingData.status)
        && (!(("certificateTemplatePositions") in (incomingData)) || (incomingData)[("certificateTemplatePositions")] is map)
        && validPrintRequestLevel(incomingData.level)
        && validListField(incomingData, "students")
        && (
          !isCertificateOrDiplomaRequest()
          || (
            incomingData.group.size() > 0
            && incomingData.teacherName.size() > 0
            && incomingData.schedule.size() > 0
            && (
              !(("principalSignerId" in incomingData) || ("teacherSignerId" in incomingData))
              || (
                incomingData.principalSignerId.size() > 0
                && incomingData.principalSignerName.size() > 0
                && incomingData.principalSignerRole.size() > 0
                && incomingData.principalSignatureUrl.size() > 0
                && incomingData.teacherSignerId.size() > 0
                && incomingData.teacherSignerName.size() > 0
                && incomingData.teacherSignerRole.size() > 0
                && incomingData.teacherSignatureUrl.size() > 0
              )
            )
            && incomingData.printedQuantity + incomingData.digitalQuantity == incomingData.requestedQuantity
          )
        );
    }

    function requestUserMatchesStringField(data, field) {
      return data[field] == request.auth.uid;
    }

    function requestUserInListField(data, field) {
      return data[field] is list && request.auth.uid in data[field];
    }

    function matchesPrintRequestAssignedData(printRequest) {
      return requestUserMatchesStringField(printRequest, "assignedUserId")
        || requestUserMatchesStringField(printRequest, "responsibleUid")
        || requestUserMatchesStringField(printRequest, "assignedToUid")
        || requestUserMatchesStringField(printRequest, "productionAssigneeUid")
        || requestUserMatchesStringField(printRequest, "assignedCollaboratorUid")
        || requestUserMatchesStringField(printRequest, "responsibleId");
    }

    function matchesPrintRequestSupportData(printRequest) {
      return requestUserMatchesStringField(printRequest, "supportUserId")
        || requestUserMatchesStringField(printRequest, "collaboratorUid")
        || requestUserMatchesStringField(printRequest, "collaboratorId")
        || requestUserMatchesStringField(printRequest, "supportCollaboratorUid")
        || requestUserMatchesStringField(printRequest, "productionSupportUid")
        || requestUserMatchesStringField(printRequest, "supportUid")
        || requestUserInListField(printRequest, "supportUserIds")
        || requestUserInListField(printRequest, "supportCollaboratorIds")
        || requestUserInListField(printRequest, "supportCollaborators")
        || requestUserInListField(printRequest, "collaboratorUids")
        || requestUserInListField(printRequest, "collaboratorIds");
    }







    function canManagePrintRequestData(printRequest) {
      return hasProfile()
        && (
          hasAdminRole()
          || matchesPrintRequestAssignedData(printRequest)
          || matchesPrintRequestSupportData(printRequest)
        );
    }





    function validPrintRequestAutoAssignUpdate() {
      let incomingData = request.resource.data;
      let storedData = resource.data;
      return isAdmin()
        && validNonEmptyStringPair(incomingData, "responsibleUid", "responsibleName")
        && validStringTriple(incomingData, "responsibleEmail", "defaultResponsibleName", "updatedByName")
        && storedData.publicRequestSource == "certificate-public-form"
        && storedData.requestType == "Certificado"
        && storedData.responsibleUid == ""
        && changesOnly(incomingData, storedData, [
          "responsibleUid",
          "responsibleName",
          "responsibleEmail",
          "defaultResponsibleName",
          "responsibleAutoAssigned",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && incomingData.responsibleAutoAssigned == true
        && incomingData.updatedByUid == request.auth.uid
        && validStringField(incomingData, "updatedByEmail");
    }

    function responsiblePrintRequestUpdate() {
      let incomingData = request.resource.data;
      return canManagePrintRequestData(resource.data)
        && validNonNegativeNumberTriple(incomingData, "requestedQuantity", "deliveredQuantity", "printedQuantity")
        && validNonNegativeNumberField(incomingData, "digitalQuantity")
        && changesOnly(incomingData, resource.data, [
          "status",
          "statusLabel",
          "requestedQuantity",
          "deliveredQuantity",
          "deliveryType",
          "notes",
          "students",
          "dueDate",
          "certificateIssueDate",
          "certificateTemplateId",
          "certificateTemplateName",
          "certificateTemplateLevel",
          "certificateTemplateProgramName",
          "certificateTemplateAudience",
          "certificateTemplateBodyText",
          "certificateTemplateBodySegments",
          "certificateTemplateCustomTexts",
          "certificateTemplateCustomImages",
          "certificateTemplateImageUrl",
          "certificateTemplateImageDataUrl",
          "certificateTemplateStoragePath",
          "certificateTemplatePositions",
          "level",
          "group",
          "teacherName",
          "schedule",
          "printedQuantity",
          "digitalQuantity",
          "principalSignerId",
          "principalSignerName",
          "principalSignerRole",
          "principalSignatureUrl",
          "principalSignatureDataUrl",
          "teacherSignerId",
          "teacherSignerName",
          "teacherSignerRole",
          "teacherSignatureUrl",
          "teacherSignatureDataUrl",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",
          "deliveredAt",
          "deliveredByUid",
          "deliveredByName",
          "deliveredByEmail"
        ])
        && validPrintRequestStatus(incomingData.status)
        && (!("statusLabel" in incomingData) || incomingData.statusLabel == incomingData.status)
        && incomingData.deliveredQuantity <= incomingData.requestedQuantity
        && validPrintRequestDeliveryType(incomingData.deliveryType)
        && validListField(incomingData, "students")
        && incomingData.updatedByUid == request.auth.uid;
    }

    function validPrintSupplyStatusUpdate() {
      let incomingData = request.resource.data;
      return canAccessPrintshop()
        && changesOnly(incomingData, resource.data, [
          "active",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && validBoolField(incomingData, "active")
        && incomingData.updatedByUid == request.auth.uid
        && validStringPair(incomingData, "updatedByName", "updatedByEmail");
    }

    function printshopCertificateStudentsUpdate() {
      let incomingData = request.resource.data;
      let storedData = resource.data;
      return canManagePrintRequestData(storedData)
        && validCertificateTemplateType(storedData.requestType)
        && incomingData.requestType == storedData.requestType
        && changesOnly(incomingData, storedData, [
          "status",
          "statusLabel",
          "requestedQuantity",
          "printedQuantity",
          "digitalQuantity",
          "deliveryType",
          "students",
          "productionStartedAt",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",
          "deliveredAt",
          "deliveredByUid",
          "deliveredByName",
          "deliveredByEmail"
        ])
        && validPrintRequestStatus(incomingData.status)
        && incomingData.updatedByUid == request.auth.uid;
    }

    function printRequestPath(requestId) {
      return /databases/$(database)/documents/printRequests/$(requestId);
    }

    function printRequestExists(requestId) {
      return requestId is string
        && requestId.size() > 0
        && exists(printRequestPath(requestId));
    }



    function canManageGeneratedCertificateRequest(requestId) {
      return hasProfile()
        && requestId is string
        && requestId.size() > 0
        && printRequestExists(requestId)
        && (
          canManagePrintRequestData((get(printRequestPath((requestId))).data))
        );
    }

    function isStandaloneGeneratedCertificateData() {
      return request.resource.data.requestId == ""
        && request.resource.data.generationMode == "individual";
    }



    function canManageGeneratedCertificateData() {
      return canManageGeneratedCertificateRequest(request.resource.data.requestId)
        || (
          canAccessPrintshop()
          && isStandaloneGeneratedCertificateData()
        );
    }

    function canManageGeneratedCertificateResource() {
      return canManageGeneratedCertificateRequest(resource.data.requestId)
        || (
          canAccessPrintshop()
          && (resource.data.requestId == ""
        && resource.data.generationMode == "individual")
        );
    }



    function validGeneratedCertificateStatus(status) {
      return status in [
        "Generado",
        "Entregado",
        "Cancelado"
      ];
    }

    function validPersonalNoteContent(data) {
      return validBoundedStringField(data, "title", 80)
        && validBoolPair(data, "pinned", "completed")
        && validBoundedStringField(data, "content", 700)
        && validTimestampField(data, "updatedAt")
        && (
          !data.keys().hasAny(["color"])
          || validBoundedStringField(data, "color", 20)
        )
        && (
          !data.keys().hasAny(["attachments"])
          || (
            validListField(data, "attachments")
            && data.attachments.size() <= 6
          )
        );
    }

    function validMessageContent(data) {
      return validBoundedStringField(data, "fromUserName", 120)
        && validBoundedStringField(data, "fromUserEmail", 180)
        && validNonEmptyBoundedStringField(data, "message", 1200)
        && validListField(data, "attachments")
        && data.attachments.size() <= 6
        && validBoundedStringField(data, "replyToMessageId", 180)
        && validBoundedStringField(data, "replyToFromUserId", 180)
        && validBoundedStringField(data, "replyToFromUserName", 120)
        && validBoundedStringField(data, "replyToMessage", 240)
        && validTimestampPair(data, "createdAt", "updatedAt");
    }

    function validCertificateCoreData(data) {
      return validNonEmptyStringTriple(data, "folio", "validationCode", "studentName")
        && validStringSix(data, "validationUrl", "requestId", "requestType", "productName", "level", "programName")
        && validStringTriple(data, "templateName", "issueDate", "teacherName")
        && (
          !("generationMode" in data)
          || data.generationMode in ["request", "individual"]
        )
        && validGeneratedCertificateStatus(data.status);
    }

    function validCredentialCoreData(data) {
      return validNonEmptyStringTriple(data, "folio", "validationCode", "fullName")
        && validNonEmptyStringField(data, "department")
        && validStringSix(data, "validationUrl", "position", "employeeId", "templateName", "issueDate", "expiryDate")
        && validGeneratedCertificateStatus(data.status);
    }

    function validGeneratedCertificateData() {
      let incomingData = request.resource.data;
      return validCertificateCoreData(incomingData)
        && validStringSix(incomingData, "studentDeliveryType", "requestFolio", "productId", "responsibleUid", "responsibleName", "responsibleEmail")
        && validStringSix(incomingData, "templateId", "principalName", "pdfFileName", "generatedByUid", "generatedByName", "generatedByEmail")
        && validStringTriple(incomingData, "updatedByUid", "updatedByName", "updatedByEmail")
        && validOptionalStringSix(incomingData, "pdfUrl", "pdfStoragePath", "deliveredByUid", "deliveredByName", "deliveredByEmail", "cancelledByUid")
        && validOptionalStringField(incomingData, "cancelledByName")
        && validNonEmptyStringField(incomingData, "studentId")
        && ((
          request.resource.data.requestId.size() > 0
          && printRequestExists(request.resource.data.requestId)
        )
        || isStandaloneGeneratedCertificateData())
        && (!(("pdfSavedAt") in (incomingData)) || (incomingData)[("pdfSavedAt")] is timestamp)
        && validOptionalStringField(incomingData, "cancelledByEmail");
    }

    function validPublicCertificateValidationData() {
      let incomingData = request.resource.data;
      return validCertificateCoreData(incomingData)
        && validStringPair(incomingData, "campus", "institution")
        && validOptionalStringField(incomingData, "issueYear")
        && (
          (
            incomingData.requestId.size() > 0
            && printRequestExists(incomingData.requestId)
          )
          || (
            incomingData.requestId == ""
            && incomingData.generationMode == "individual"
          )
        );
    }

    function validGeneratedCredentialData() {
      let incomingData = request.resource.data;
      return validCredentialCoreData(incomingData)
        && validStringSix(incomingData, "qrDataUrl", "notes", "generatedByUid", "generatedByName", "generatedByEmail", "updatedByUid")
        && validStringField(incomingData, "updatedByName")
        && validNonEmptyStringField(incomingData, "templateId")
        && exists(/databases/$(database)/documents/credentialTemplates/$(incomingData.templateId))
        && validStringField(incomingData, "updatedByEmail");
    }







    function validCertificateRequestCreate() {
      let incomingData = request.resource.data;
      return hasOnlyFields(incomingData, [
        "folio",
        "campus",
        "academicDirector",
        "requestedDeliveryDate",
        "certificateType",
        "courseLevel",
        "notes",
        "students",
        "status",
        "statusLabel",
        "publicTrackingEnabled",
        "createdAt",
        "updatedAt",
        "createdBy"
      ])
      && validNonEmptyStringField(incomingData, "folio")
      && ((incomingData.campus) in [
        "Plaza Estrella",
        "Plaza Bugambilias",
        "Plaza Aranjuez",
        "Online"
      ])
      && validNonEmptyStringField(incomingData, "academicDirector")
      && validStringField(incomingData, "requestedDeliveryDate")
      && incomingData.certificateType == "Certificado"
      && validNonEmptyStringField(incomingData, "courseLevel")
      && validStringField(incomingData, "notes")
      && validListField(incomingData, "students")
      && incomingData.students.size() > 0
      && incomingData.students.size() <= 100
      && incomingData.status == "received"
      && incomingData.statusLabel == "Solicitud recibida"
      && incomingData.publicTrackingEnabled == true
      && validTimestampPair(incomingData, "createdAt", "updatedAt")
      && incomingData.createdBy == "public-form";
    }

    function validPrintshopSoftDeleteUpdate() {
      let incomingData = request.resource.data;
      return isAdmin()
        && changesOnly(incomingData, resource.data, [
          "active",
          "deleted",
          "deletedAt",
          "deletedByUid",
          "deletedByName",
          "deletedByEmail",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && incomingData.deleted == true
        && incomingData.active == false
        && validCurrentUserIdentityFields(incomingData, "deletedByUid", "deletedByName", "deletedByEmail")
        && incomingData.updatedByUid == request.auth.uid
        && validStringPair(incomingData, "updatedByName", "updatedByEmail");
    }


    function validPrintshopLogData() {
      let incomingData = request.resource.data;
      return validNonEmptyStringTriple(incomingData, "type", "module", "title")
        && validStringSix(incomingData, "description", "referenceType", "referenceId", "requestId", "requestFolio", "certificateId")
        && validStringSix(incomingData, "certificateFolio", "validationCode", "studentName", "batchId", "batchFolio", "productId")
        && validStringTriple(incomingData, "productName", "campus", "level")
        && validCurrentUserIdentityFields(incomingData, "performedByUid", "performedByName", "performedByEmail")
        && validTimestampField(incomingData, "createdAt");
    }

    function validTechnicalLocationCreate() {
      let incomingData = request.resource.data;
      return canManageTechnicalSupport()
        && validNonEmptyStringTriple(incomingData, "name", "campus", "type");
    }

    function validTechnicalLocationUpdate() {
      let incomingData = request.resource.data;
      return canManageTechnicalSupport()
        && (
          !("name" in incomingData) ||
          (
            validNonEmptyStringField(incomingData, "name")
          )
        )
        && (
          !("campus" in incomingData) ||
          (
            validNonEmptyStringField(incomingData, "campus")
          )
        )
        && (
          !("type" in incomingData) ||
          (
            validNonEmptyStringField(incomingData, "type")
          )
        );
    }

    function validTechnicalLocationReviewCreate() {
      let incomingData = request.resource.data;
      return canManageTechnicalSupport()
        && validNonEmptyStringPair(incomingData, "locationId", "locationName");
    }






    function canReadPurchaseRequest() {
      let profileData = userDoc().data;
      return (signedIn() && profileData.active == true)
        && (
          profileDataHasAdminRole(profileData) || resource.data.requestedByUid == request.auth.uid
        );
    }

    function canReadPurchaseRequestId(requestId) {
      let profileData = userDoc().data;
      return (signedIn() && profileData.active == true)
        && exists(/databases/$(database)/documents/purchaseRequests/$(requestId))
        && (
          profileDataHasAdminRole(profileData)
          || get(/databases/$(database)/documents/purchaseRequests/$(requestId)).data.requestedByUid == request.auth.uid
        );
    }

    function validPurchaseRequestCreate() {
      let incomingData = request.resource.data;
      return hasProfile()
        && hasOnlyFields(incomingData, [
          "itemName",
          "description",
          "department",
          "priority",
          "quantity",
          "suggestedLink",
          "projectName",
          "requesterComment",
          "status",
          "adminComment",
          "rejectionReason",
          "requestedByUid",
          "requestedByName",
          "requestedByEmail",
          "createdByUid",
          "createdByName",
          "createdByEmail",
          "purchasedAt",
          "receivedAt",
          "deliveredAt",
          "cancelledAt",
          "createdAt",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && validNonEmptyBoundedStringField(incomingData, "itemName", 120)
        && validNonEmptyBoundedStringField(incomingData, "description", 700)
        && validNonEmptyStringField(incomingData, "department")
        && ((incomingData.priority) in [
        "low",
        "normal",
        "high",
        "urgent"
      ])
        && incomingData.quantity >= 1
        && incomingData.quantity <= 999
        && validBoundedStringField(incomingData, "suggestedLink", 500)
        && validBoundedStringField(incomingData, "projectName", 120)
        && validBoundedStringField(incomingData, "requesterComment", 500)
        && incomingData.status == "pending_review"
        && incomingData.adminComment == ""
        && incomingData.rejectionReason == ""
        && validCurrentUserIdentityFields(incomingData, "requestedByUid", "requestedByName", "requestedByEmail")
        && validCurrentUserIdentityFields(incomingData, "createdByUid", "createdByName", "createdByEmail")
        && incomingData.updatedByUid == request.auth.uid
        && validStringPair(incomingData, "updatedByName", "updatedByEmail");
    }

    function validPurchaseAdminUpdate() {
      let incomingData = request.resource.data;
      return isAdmin()
        && changesOnly(incomingData, resource.data, [
          "status",
          "adminComment",
          "rejectionReason",
          "purchasedAt",
          "receivedAt",
          "deliveredAt",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && ((incomingData.status) in [
        "pending_review",
        "reviewing",
        "approved",
        "purchasing",
        "purchased",
        "received",
        "delivered",
        "rejected",
        "cancelled"
      ])
        && validBoundedStringField(incomingData, "adminComment", 700)
        && validBoundedStringField(incomingData, "rejectionReason", 700)
        && validCurrentUserIdentityFields(incomingData, "updatedByUid", "updatedByName", "updatedByEmail")
        && validTimestampField(incomingData, "updatedAt");
    }

    function validPurchaseRequesterCancel() {
      let incomingData = request.resource.data;
      return hasProfile()
        && resource.data.requestedByUid == request.auth.uid
        && resource.data.status == "pending_review"
        && changesOnly(incomingData, resource.data, [
          "status",
          "cancelledAt",
          "cancelledByUid",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && incomingData.status == "cancelled"
        && incomingData.cancelledByUid == request.auth.uid
        && validCurrentUserIdentityFields(incomingData, "updatedByUid", "updatedByName", "updatedByEmail")
        && validTimestampField(incomingData, "updatedAt");
    }

    function validPurchaseLogCreate(requestId) {
      let incomingData = request.resource.data;
      return hasProfile()
        && canReadPurchaseRequestId(requestId)
        && hasOnlyFields(incomingData, [
          "requestId",
          "type",
          "message",
          "createdByUid",
          "createdByName",
          "createdByEmail",
          "createdAt"
        ])
        && incomingData.requestId == requestId
        && validNonEmptyStringField(incomingData, "type")
        && validNonEmptyBoundedStringField(incomingData, "message", 500)
        && incomingData.createdByUid == request.auth.uid
        && validStringPair(incomingData, "createdByName", "createdByEmail");
    }


    function validAnnouncementReadReceipt(announcementId, userId) {
      let incomingData = request.resource.data;
      return hasProfile()
        && userId == request.auth.uid
        && hasOnlyFields(incomingData, [
          "announcementId",
          "userId",
          "userName",
          "userEmail",
          "readAt"
        ])
        && incomingData.announcementId == announcementId
        && incomingData.userId == request.auth.uid
        && validBoundedStringField(incomingData, "userName", 120)
        && validBoundedStringField(incomingData, "userEmail", 180)
        && validTimestampField(incomingData, "readAt");
    }

    function validPersonalNoteCreate() {
      let incomingData = request.resource.data;
      return hasProfile()
        && hasOnlyFields(incomingData, [
          "userId",
          "title",
          "content",
          "pinned",
          "completed",
          "createdAt",
          "updatedAt",
          "color",
          "attachments"
        ])
        && incomingData.userId == request.auth.uid
        && validTimestampField(incomingData, "createdAt")
        && validPersonalNoteContent(incomingData);
    }

    function validPersonalNoteUpdate() {
      let incomingData = request.resource.data;
      return hasProfile()
        && resource.data.userId == request.auth.uid
        && incomingData.userId == request.auth.uid
        && changesOnly(incomingData, resource.data, [
          "userId",
          "title",
          "content",
          "pinned",
          "completed",
          "updatedAt",
          "color",
          "attachments"
        ])
        && validPersonalNoteContent(incomingData);
    }




    function validInternalMessageCreate() {
      let incomingData = request.resource.data;
      return hasProfile()
        && hasOnlyFields(incomingData, [
          "fromUserId",
          "fromUserName",
          "fromUserEmail",
          "toUserId",
          "toUserName",
          "toUserEmail",
          "subject",
          "message",
          "attachments",
          "replyToMessageId",
          "replyToFromUserId",
          "replyToFromUserName",
          "replyToMessage",
          "read",
          "createdAt",
          "updatedAt"
        ])
        && incomingData.fromUserId == request.auth.uid
        && validNonEmptyStringField(incomingData, "toUserId")
        && incomingData.toUserId != request.auth.uid
        && validBoundedStringField(incomingData, "toUserName", 120)
        && validBoundedStringField(incomingData, "toUserEmail", 180)
        && validNonEmptyBoundedStringField(incomingData, "subject", 120)
        && incomingData.read == false
        && validMessageContent(incomingData);
    }

    function validInternalMessageReadUpdate() {
      let incomingData = request.resource.data;
      let storedData = resource.data;
      return hasProfile()
        && storedData.toUserId == request.auth.uid
        && incomingData.fromUserId == storedData.fromUserId
        && incomingData.toUserId == storedData.toUserId
        && changesOnly(incomingData, storedData, [
          "read",
          "readAt",
          "updatedAt"
        ])
        && incomingData.read == true
        && validTimestampPair(incomingData, "readAt", "updatedAt");
    }


    function userMatchesDepartmentName(departmentName) {
      let profileData = userDoc().data;
      return (signedIn() && profileData.active == true)
        && departmentName is string
        && (
          profileDataHasAdminRole(profileData)
          || ((departmentName) is string
        && userHasAnyDepartmentName([(departmentName)], [(departmentName).lower()]))
        );
    }

    function userMatchesDepartmentId(departmentId) {
      let currentUserData = userDoc().data;
      let profileData = currentUserData;
      return (signedIn() && profileData.active == true)
        && departmentId is string
        && (
          profileDataHasAdminRole(profileData)
          || currentUserData.departmentId == departmentId
          || currentUserData.primaryDepartmentId == departmentId
          || currentUserData.areaId == departmentId
          || (
            currentUserData.departmentIds is list
            && departmentId in currentUserData.departmentIds
          )
        );
    }

    function canReadDepartmentMessage() {
      let profileData = userDoc().data;
      return (signedIn() && profileData.active == true)
        && (
          profileDataHasAdminRole(profileData)
          || (
            request.auth.uid in resource.data.memberIds
            && (
              userMatchesDepartmentId(resource.data.departmentId)
              || userMatchesDepartmentName(resource.data.departmentName)
            )
          )
        );
    }

    function validDepartmentMessageCreate() {
      let incomingData = request.resource.data;
      return hasProfile()
        && hasOnlyFields(incomingData, [
          "departmentId",
          "departmentName",
          "fromUserId",
          "fromUserName",
          "fromUserEmail",
          "message",
          "attachments",
          "replyToMessageId",
          "replyToFromUserId",
          "replyToFromUserName",
          "replyToMessage",
          "memberIds",
          "readBy",
          "createdAt",
          "updatedAt"
        ])
        && incomingData.fromUserId == request.auth.uid
        && validNonEmptyBoundedStringField(incomingData, "departmentId", 120)
        && validNonEmptyBoundedStringField(incomingData, "departmentName", 120)
        && (
          userMatchesDepartmentId(incomingData.departmentId)
          || userMatchesDepartmentName(incomingData.departmentName)
        )
        && validListField(incomingData, "memberIds")
        && incomingData.memberIds.size() <= 80
        && request.auth.uid in incomingData.memberIds
        && validMapField(incomingData, "readBy")
        && hasOnlyFields(incomingData.readBy, [request.auth.uid])
        && incomingData.readBy[request.auth.uid] is timestamp
        && validMessageContent(incomingData);
    }

    function validDepartmentMessageReadUpdate() {
      let incomingData = request.resource.data;
      let storedData = resource.data;
      return hasProfile()
        && canReadDepartmentMessage()
        && incomingData.departmentId == storedData.departmentId
        && incomingData.departmentName == storedData.departmentName
        && incomingData.fromUserId == storedData.fromUserId
        && incomingData.memberIds == storedData.memberIds
        && changesOnly(incomingData, storedData, [
          "readBy",
          "updatedAt"
        ])
        && validMapField(incomingData, "readBy")
        && incomingData.readBy[request.auth.uid] is timestamp
        && validTimestampField(incomingData, "updatedAt");
    }

    function validUserPresenceWrite(userId) {
      let incomingData = request.resource.data;
      return hasProfile()
        && userId == request.auth.uid
        && hasOnlyFields(incomingData, [
          "userId",
          "userName",
          "userEmail",
          "isOnline",
          "lastSeen",
          "currentPage",
          "updatedAt"
        ])
        && incomingData.userId == request.auth.uid
        && validBoundedStringField(incomingData, "userName", 120)
        && validBoundedStringField(incomingData, "userEmail", 180)
        && validBoolField(incomingData, "isOnline")
        && validBoundedStringField(incomingData, "currentPage", 80)
        && validTimestampPair(incomingData, "lastSeen", "updatedAt");
    }



    function validMessageTypingStateWrite() {
      let incomingData = request.resource.data;
      return hasProfile()
        && hasOnlyFields(incomingData, [
          "chatKey",
          "chatType",
          "targetId",
          "userId",
          "userName",
          "memberIds",
          "isTyping",
          "updatedAt"
        ])
        && incomingData.userId == request.auth.uid
        && validNonEmptyBoundedStringField(incomingData, "chatKey", 180)
        && incomingData.chatType in ["direct", "department"]
        && validNonEmptyBoundedStringField(incomingData, "targetId", 180)
        && validBoundedStringField(incomingData, "userName", 120)
        && validListField(incomingData, "memberIds")
        && incomingData.memberIds.size() <= 80
        && request.auth.uid in incomingData.memberIds
        && validBoolField(incomingData, "isTyping")
        && validTimestampField(incomingData, "updatedAt");
    }

    function validActiveClassroomFolderCreate() {
      let incomingData = request.resource.data;
      return isAdmin()
        && validTimestampPair(incomingData, "createdAt", "updatedAt")
        && hasOnlyFields(incomingData, [
          "name",
          "parentId",
          "kind",
          "position",
          "active",
          "createdAt",
          "createdByUid",
          "updatedAt",
          "updatedByUid"
        ])
        && validNonEmptyBoundedStringField(incomingData, "name", 56)
        && incomingData.kind in ["level", "unit"]
        && (
          (incomingData.kind == "level" && incomingData.parentId == null)
          || (
            incomingData.kind == "unit"
            && validNonEmptyStringField(incomingData, "parentId")
            && existsAfter(
              /databases/$(database)/documents/activeClassroomFolders/$(incomingData.parentId)
            )
            && getAfter(
              /databases/$(database)/documents/activeClassroomFolders/$(incomingData.parentId)
            ).data.kind == "level"
          )
        )
        && validNonNegativeNumberField(incomingData, "position")
        && validBoolField(incomingData, "active")
        && incomingData.createdByUid == request.auth.uid
        && incomingData.updatedByUid == request.auth.uid;
    }

    function validActiveClassroomFolderUpdate() {
      let incomingData = request.resource.data;
      let storedData = resource.data;
      return isAdmin()
        && incomingData.kind == storedData.kind
        && incomingData.parentId == storedData.parentId
        && incomingData.createdAt == storedData.createdAt
        && incomingData.createdByUid == storedData.createdByUid
        && changesOnly(incomingData, storedData, [
          "name",
          "position",
          "active",
          "updatedAt",
          "updatedByUid"
        ])
        && validNonEmptyBoundedStringField(incomingData, "name", 56)
        && validNumberField(incomingData, "position")
        && validBoolField(incomingData, "active")
        && validTimestampField(incomingData, "updatedAt")
        && incomingData.updatedByUid == request.auth.uid;
    }

    function validActiveClassroomResourceCreate(resourceId) {
      let incomingData = request.resource.data;
      return isAdmin()
        && validStringPair(incomingData, "storagePath", "createdByName")
        && validBoolPair(incomingData, "published", "archived")
        && validTimestampPair(incomingData, "createdAt", "updatedAt")
        && hasOnlyFields(incomingData, [
          "folderId",
          "name",
          "kind",
          "mimeType",
          "sizeBytes",
          "storagePath",
          "published",
          "archived",
          "createdAt",
          "createdByUid",
          "createdByName",
          "updatedAt",
          "updatedByUid",
          "updatedByName"
        ])
        && validNonEmptyStringField(incomingData, "folderId")
        && exists(
          /databases/$(database)/documents/activeClassroomFolders/$(incomingData.folderId)
        )
        && get(
          /databases/$(database)/documents/activeClassroomFolders/$(incomingData.folderId)
        ).data.kind == "unit"
        && validNonEmptyBoundedStringField(incomingData, "name", 160)
        && incomingData.kind in [
          "presentation",
          "audio",
          "video",
          "document",
          "image"
        ]
        && validBoundedStringField(incomingData, "mimeType", 160)
        && validNonNegativeNumberField(incomingData, "sizeBytes")
        && incomingData.sizeBytes < 250 * 1024 * 1024
        && incomingData.storagePath.matches(
          "^active-classroom/resources/" + resourceId + "/[^/]+$"
        )
        && incomingData.createdByUid == request.auth.uid
        && incomingData.updatedByUid == request.auth.uid
        && validStringField(incomingData, "updatedByName");
    }

    function validActiveClassroomResourceUpdate() {
      let incomingData = request.resource.data;
      let storedData = resource.data;
      return isAdmin()
        && validBoolPair(incomingData, "published", "archived")
        && incomingData.folderId == storedData.folderId
        && incomingData.kind == storedData.kind
        && incomingData.mimeType == storedData.mimeType
        && incomingData.sizeBytes == storedData.sizeBytes
        && incomingData.storagePath == storedData.storagePath
        && incomingData.createdAt == storedData.createdAt
        && incomingData.createdByUid == storedData.createdByUid
        && incomingData.createdByName == storedData.createdByName
        && changesOnly(incomingData, storedData, [
          "name",
          "published",
          "archived",
          "updatedAt",
          "updatedByUid",
          "updatedByName"
        ])
        && validNonEmptyBoundedStringField(incomingData, "name", 160)
        && validTimestampField(incomingData, "updatedAt")
        && incomingData.updatedByUid == request.auth.uid
        && validStringField(incomingData, "updatedByName");
    }

    match /{collectionName}/{documentId} {
      allow get: if collectionName in ["activeClassroomFolders", "announcements", "areas", "attendanceLocations", "departments", "printProducts", "scheduleAdjustments", "userPresence", "workSchedules"]
        && (hasProfile());
      allow list: if collectionName in ["activeClassroomFolders", "announcements", "areas", "attendanceLocations", "departments", "messageTypingStates", "printProducts", "scheduleAdjustments", "userPresence", "workSchedules"]
        && (hasProfile());
      allow create: if collectionName in ["announcements", "areas", "attendanceLocations", "departments", "digitalSignageAssets", "digitalSignageAuditLogs", "digitalSignageCampaigns", "digitalSignagePlaylists", "digitalSignageVisualTemplates", "subscriptions", "users", "workSchedules"]
        && (isAdmin());
      allow update: if collectionName in ["announcements", "areas", "attendanceLocations", "departments", "digitalSignageAssets", "digitalSignageCampaigns", "digitalSignagePlaylists", "digitalSignageVisualTemplates", "scheduleAdjustments", "scheduleRequests", "subscriptions", "workSchedules"]
        && (isAdmin());
      allow delete: if collectionName in ["activeClassroomResources", "announcements", "attendanceLocations", "bugReports", "certificateSigners", "departmentMessages", "digitalSignageAssets", "digitalSignageCampaigns", "digitalSignageDevices", "digitalSignagePairingSessions", "digitalSignagePlaylists", "digitalSignageVisualTemplates", "generatedCredentials", "ideas", "internalMessages", "printRequests", "purchaseRequests", "scheduleAdjustments", "scheduleRequests", "subscriptions", "technicalAssets", "technicalInstallationTemplates", "technicalInstallations", "technicalLocationReviews", "technicalLocations", "technicalMaintenances", "technicalSpareParts", "workSchedules", "workSessions"]
        && (isAdmin());
      allow get, list: if collectionName in ["driveActivityLogs", "driveDepartmentFolders", "protectLogs", "systemSettings"]
        && (isAdminRole());
      allow create, update, delete: if collectionName in ["driveDepartmentFolders", "systemSettings"]
        && (isAdminRole());
      allow get, list: if collectionName in ["evidence", "projectLogs", "projectUpdates"]
        && ((
                  hasProfile()
                  && resource.data.projectId is string
                  && canAccessProjectId(resource.data.projectId)
                ));
      allow get: if collectionName in ["digitalSignageAuditLogs", "digitalSignagePlaybackLogs", "digitalSignageVisualTemplates", "printProductionReplenishment", "projectInternalNotes", "scheduleLogs", "subscriptions"]
        && (isAdmin());
      allow list: if collectionName in ["digitalSignageAssets", "digitalSignageAuditLogs", "digitalSignageDevices", "digitalSignagePairingSessions", "digitalSignagePlaybackLogs", "digitalSignagePlaylists", "digitalSignageVisualTemplates", "editorialProjects", "printProductionReplenishment", "projectInternalNotes", "scheduleLogs", "subscriptions", "workSessions"]
        && (isAdmin());
      allow get: if collectionName in ["credentialTemplates", "generatedCredentials", "printFinishedInventory", "printInventoryMovements", "printProductionBatches", "printSupplyItems", "printSupplyMovements", "printshopLogs"]
        && (canAccessPrintshop());
      allow list: if collectionName in ["certificateRequests", "credentialTemplates", "generatedCredentials", "printFinishedInventory", "printInventoryMovements", "printProductionBatches", "printSupplyItems", "printSupplyMovements", "printshopLogs"]
        && (canAccessPrintshop());
      allow get, list: if collectionName in ["certificateSigners", "certificateTemplates"]
        && (hasProfile() || resource.data.active == true);
      allow get: if collectionName in ["digitalSignageCampaigns", "digitalSignagePairingSessions", "publicCertificateValidations", "publicCredentialValidations"]
        && (true);
      allow list: if collectionName in ["digitalSignageCampaigns", "publicCertificateValidations", "publicCredentialValidations"]
        && (true);
      allow get, list: if collectionName in ["supportTools", "technicalAssetLogs", "technicalAssets", "technicalInstallationTemplates", "technicalInstallations", "technicalLocationReviews", "technicalLocations", "technicalMaintenances", "technicalSparePartMovements", "technicalSpareParts"]
        && (canAccessTechnicalSupport());
      allow create: if collectionName in ["technicalAssetLogs", "technicalAssets", "technicalInstallationTemplates", "technicalInstallations", "technicalMaintenances", "technicalSparePartMovements", "technicalSpareParts"]
        && (canManageTechnicalSupport());
      allow update: if collectionName in ["technicalAssets", "technicalInstallationTemplates", "technicalLocationReviews", "technicalMaintenances", "technicalSpareParts"]
        && (canManageTechnicalSupport());
      allow get: if collectionName in ["digitalSignageAssets", "digitalSignagePlaylists"]
        && (resource.data.active == true);
    }

    match /{adminCollection}/{adminDocumentId} {
      allow get, list: if adminCollection in ["activeClassroomResources"]
        && isAdmin();
      allow list: if adminCollection in ["projects", "purchaseRequests", "users"]
        && isAdmin();
      allow update: if adminCollection in ["digitalSignageDevices", "digitalSignagePairingSessions", "editorialTemplates", "ideas", "printRequests", "users", "workSessions"]
        && isAdmin();
      allow read: if adminCollection in ["editorialTemplates", "evidence", "projectLogs", "projectUpdates", "scheduleRequests"]
        && isAdmin();
      allow create: if adminCollection in ["editorialTemplates", "scheduleAdjustments", "scheduleLogs"]
        && isAdmin();
      allow get: if adminCollection in ["digitalSignageAssets", "digitalSignageDevices", "digitalSignagePlaylists", "workSessions"]
        && isAdmin();
      allow delete: if adminCollection in ["editorialProjects", "editorialTemplates"]
        && isAdmin();
    }

    match /announcements/{announcementId} {




      match /reads/{userId} {
        allow get: if isAdmin()
          || (hasProfile() && userId == request.auth.uid);

