      return type in [
        "Certificado",
        "Diploma"
      ];
    }

    function validCertificateTemplateData() {
      let incomingData = request.resource.data;
      return validNonEmptyStringTriple(incomingData, "name", "programName", "templateImageUrl")
        && validNonEmptyStringPair(incomingData, "templateImageDataUrl", "storagePath")
        && validStringPair(incomingData, "bodyText", "notes")
        && validOptionalListTriple(incomingData, "bodySegments", "customTexts", "customImages")
        && validPrintRequestLevel(incomingData.level)
        && ((incomingData.audience) in [
        "Adultos",
        "Kids",
        "Otro"
      ])
        && validCertificateTemplateType(incomingData.certificateType)
        && validBoolField(incomingData, "active")
        && validMapField(incomingData, "positions");
