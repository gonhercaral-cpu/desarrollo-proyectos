        && request.resource.data.deleted == true
        && request.resource.data.active == false
        && request.resource.data.deletedByUid == request.auth.uid
        && request.resource.data.deletedByName is string
        && request.resource.data.deletedByEmail is string
        && request.resource.data.updatedByUid == request.auth.uid
