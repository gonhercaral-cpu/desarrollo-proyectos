    }


    match /printProductionBatches/{batchId} {


      allow create: if (isAdmin()
        && validPrintProductionBatchData()
        && request.resource.data.inventoryApplied == false);

      // Toda actualización operativa usa Cloud Functions para preservar historial,
      // separación producción/calidad y fechas de etapa.

      // Las bajas pasan por Cloud Functions para preservar contabilidad y supresión.

      match /history/{historyId} {
        allow read: if canAccessPrintshop();
      }
    }

    match /materialCorrectionReports/{reportId} {
      allow get, list: if canAccessMaterialCorrections();
      // Toda mutación usa Cloud Functions. Ahí se valida asignación, rol,
