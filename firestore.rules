    function validPublicCertificateFormCreate(requestData) {
      return hasAllFields(requestData, [
          "folio",
          "publicTrackingEnabled"
        ])
        && validNonEmptyStringField(requestData, "folio")
        && requestData.publicTrackingEnabled == true
        && (
          (
            hasAllFields(requestData, [
              "publicRequestSource",
              "requestType",
              "status",
              "createdByUid"
            ])
            && requestData.publicRequestSource == "certificate-public-form"
            && requestData.requestType == "Certificado"
            && requestData.status in ["Solicitud recibida", "received"]
            && requestData.createdByUid == "public-form"
          )
          ||
          (
            hasAllFields(requestData, [
              "certificateType",
              "status",
              "createdBy"
            ])
            && requestData.certificateType == "Certificado"
            && requestData.status in ["Solicitud recibida", "received"]
            && requestData.createdBy in ["public-form", "public-certificate-form"]
          )
        );
    }





    function validPublicPrintRequestUpdate() {
      let incomingData = request.resource.data;
      return (resource.data.publicTrackingEnabled == true
        && resource.data.publicRequestSource == "certificate-public-form"
        && resource.data.status in [
          "Solicitud recibida",
          "Datos incompletos",
          "En revisión",
          "Aprobada"
        ])
        && validNonEmptyStringTriple(incomingData, "productName", "requesterName", "group")
        && validNonEmptyStringField(incomingData, "courseLevel")
        && validStringSix(incomingData, "dueDate", "requestedDeliveryDate", "notes", "level", "teacherName", "schedule")
        && validStringTriple(incomingData, "teacherSignerName", "principalSignerName", "principalSignerRole")
        && validStringPair(incomingData, "certificateDirectorName", "academicDirector")
        && validNonNegativeNumberPair(incomingData, "printedQuantity", "digitalQuantity")
        && changesOnly(incomingData, resource.data, [
          "requesterName",
          "requesterId",
          "campus",
          "dueDate",
          "requestedDeliveryDate",
          "notes",
          "requestedQuantity",
          "printedQuantity",
          "digitalQuantity",
          "deliveryType",
          "students",
          "productName",
          "level",
          "group",
          "courseLevel",
          "courseProgramName",
          "courseAudience",
          "certificateTemplateLevel",
          "certificateTemplateProgramName",
          "certificateTemplateAudience",
          "teacherName",
          "schedule",
          "teacherSignerId",
          "teacherSignerName",
          "teacherSignerRole",
          "teacherSignatureUrl",
          "teacherSignatureDataUrl",
          "academicDirector",
          "certificateDirectorName",
          "principalSignerId",
          "principalSignerName",
          "principalSignerRole",
          "principalSignatureUrl",
          "principalSignatureDataUrl",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && incomingData.status == resource.data.status
        && incomingData.publicTrackingEnabled == true
        && incomingData.publicRequestSource == "certificate-public-form"
        && incomingData.requestType == "Certificado"
        && incomingData.requesterArea == "Dirección Académica"
        && validOptionalStringField(incomingData, "requesterId")
        && incomingData.campus in [
          "Plaza Estrella",
          "Plaza Bugambilias",
          "Plaza Aranjuez",
          "Online"
        ]
        && validPositiveNumberField(incomingData, "requestedQuantity")
        && incomingData.requestedQuantity <= 150
        && incomingData.printedQuantity + incomingData.digitalQuantity == incomingData.requestedQuantity
        && incomingData.deliveryType in [
          "Impresa",
          "Digital",
          "Ambas"
        ]
        && validListField(incomingData, "students")
        && incomingData.students.size() == incomingData.requestedQuantity
        && incomingData.updatedByUid == "public-form"
        && validNonEmptyStringField(incomingData, "updatedByName");
    }




    match /certificateRequests/{requestId} {
      allow create: if validCertificateRequestCreate()
        || validPublicCertificateFormCreate(request.resource.data);

      allow get: if resource.data.publicTrackingEnabled == true
        || canAccessPrintshop();



      allow update: if canAccessPrintshop();

    }

    match /printRequests/{requestId} {
      allow get: if canAccessPrintshop()
        || resource.data.publicTrackingEnabled == true
        || ((hasProfile() && matchesPrintRequestAssignedData((resource.data))))
        || ((hasProfile() && matchesPrintRequestSupportData((resource.data))));

      allow list: if canAccessPrintshop()
        || (
          hasProfile()
          && (hasProfile()
        && (
          matchesPrintRequestAssignedData((resource.data))
          || matchesPrintRequestSupportData((resource.data))
        ))
        );

      allow create: if isAdmin()
        && (
          (
            request.resource.data.createdByUid == request.auth.uid
            && validPrintRequestData()
          )
          || (validPublicCertificateFormCreate((request.resource.data))
        && validNonEmptyStringTriple((request.resource.data), "assignedUserId", "assignedUserName", "supportUserId")
        && validNonEmptyStringField((request.resource.data), "supportUserName")
        && hasAllFields((request.resource.data), [
          "publicRequestSource",
          "requestType",
          "createdByUid",
          "assignedUserId",
          "assignedUserName",
          "supportUserId",
          "supportUserName",
          "assignmentSource"
        ])
        && (request.resource.data).supportUserId != (request.resource.data).assignedUserId
        && (request.resource.data).assignmentSource in [
          "agenda:tony",
          "agenda:ernesto",
          "fallback:tony-default"
        ])
        );

      allow update: if responsiblePrintRequestUpdate()
        || printshopCertificateStudentsUpdate()
        || validPrintRequestAutoAssignUpdate()
        || validPublicPrintRequestUpdate()
        || validPrintshopSoftDeleteUpdate();


    }



    match /supportTools/{toolId} {


      // Altas y cambios pasan por Functions: folios, historial y transacciones
      // no pueden ser omitidos mediante escrituras directas del cliente.

      match /movements/{movementId} {
        allow read: if canAccessTechnicalSupport();
      }

      match /maintenance/{maintenanceId} {
        allow read: if canAccessTechnicalSupport();
      }

      match /history/{historyId} {
        allow read: if canAccessTechnicalSupport();
      }
    }







    match /technicalLocations/{locationId} {


      allow create: if validTechnicalLocationCreate();

      allow update: if validTechnicalLocationUpdate();


    }

    match /technicalLocationReviews/{reviewId} {


      allow create: if validTechnicalLocationReviewCreate();




    }













    match /technicalInstallations/{installationId} {




      allow update: if canManageTechnicalSupport()
        && (
          !(resource.data.status == "completed" || resource.data.status == "cancelled") ||
          isAdmin() ||
          ((resource.data.status == "completed") && (changesOnly(request.resource.data, resource.data, [
        "evidenceItems",
        "evidenceCount",
        "imageEvidenceCount",
        "videoEvidenceCount",
        "updatedAt",
        "updatedBy",
        "updatedByEmail",
        "updatedById"
      ])))
        );


    }








    function validIdeaCreate() {
      let incomingData = request.resource.data;
      return hasProfile()
        && validNonEmptyStringTriple(incomingData, "title", "area", "currentProblem")
        && validNonEmptyStringPair(incomingData, "proposedIdea", "expectedBenefit")
        && hasOnlyFields(incomingData, [
          "title",
          "category",
          "area",
          "currentProblem",
          "proposedIdea",
          "implementationSuggestion",
          "expectedBenefit",
          "priority",
          "impact",
          "evidenceFiles",
          "evidenceCount",
          "status",
          "createdByUid",
          "createdByName",
          "createdByEmail",
          "createdAt",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",
          "reviewedAt",
          "reviewedByUid",
          "reviewedByName",
          "reviewedByEmail",
          "convertedProjectId"
        ])
        && incomingData.createdByUid == request.auth.uid
        && incomingData.updatedByUid == request.auth.uid
        && validStringField(incomingData, "implementationSuggestion")
        && incomingData.priority in ["baja", "media", "alta", "urgente"]
        && incomingData.impact in ["bajo", "medio", "alto", "muy_alto"]
        && validListField(incomingData, "evidenceFiles")
        && incomingData.evidenceFiles.size() == 0
        && incomingData.evidenceCount == 0
        && incomingData.reviewedAt == null
        && incomingData.reviewedByUid == ""
        && incomingData.reviewedByName == ""
        && incomingData.reviewedByEmail == ""
        && incomingData.convertedProjectId == null
        && incomingData.status == "nueva";
    }



    match /ideas/{ideaId} {
      allow get, list: if (isAdmin()
        || (
          hasProfile()
          && resource.data.createdByUid == request.auth.uid
        ));

      allow create: if validIdeaCreate();

      allow update: if (hasProfile()
        && resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByUid == resource.data.createdByUid
        && changesOnly(request.resource.data, resource.data, [
          "evidenceFiles",
          "evidenceCount",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ]));



      match /comments/{commentId} {
        allow get, list: if (isAdmin()
        || (
          hasProfile()
          && exists(/databases/$(database)/documents/ideas/$((ideaId)))
          && get(/databases/$(database)/documents/ideas/$((ideaId))).data.createdByUid == request.auth.uid
        ));

        allow create: if isAdmin()
          && request.resource.data.ideaId == ideaId
          && request.resource.data.comment is string
          && request.resource.data.comment.size() > 0
          && request.resource.data.createdByUid == request.auth.uid;

      }
    }

    match /bugReports/{reportId} {
      allow get, list: if (isAdmin()
        || (
          hasProfile()
          && resource.data.reporterUid == request.auth.uid
        ));

      allow create: if validBugReportCreate();

      allow update: if isAdmin()
        && request.resource.data.status is string
        && ((request.resource.data.status) in [
        "nuevo",
        "en_revision",
        "en_proceso",
        "resuelto",
        "no_reproducible",
        "cerrado"
      ]);


    }


    match /purchaseRequests/{requestId} {
      allow get: if canReadPurchaseRequest();

      allow list: if canReadPurchaseRequest();

      allow create: if validPurchaseRequestCreate();

      allow update: if validPurchaseAdminUpdate()
        || validPurchaseRequesterCancel();



      match /logs/{logId} {
        allow read: if canReadPurchaseRequestId(requestId);

        allow create: if validPurchaseLogCreate(requestId);

      }
    }

    match /projectInternalNotes/{noteId} {


      allow create: if validInternalNoteCreate();

    }













    match /digitalSignagePlaybackLogs/{logId} {

      allow create: if hasOnlyFields(request.resource.data, [
          "deviceId",
          "deviceTokenHash",
          "deviceName",
          "plantel",
          "location",
          "eventType",
          "assetId",
          "assetTitle",
          "assetType",
          "playlistId",
          "playlistName",
          "campaignId",
          "campaignName",
          "source",
          "durationSeconds",
          "errorMessage",
          "createdAt",
          "localTimestamp",
          "playerVersion"
        ])
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() > 0
        && request.resource.data.eventType in [
          "play_start",
          "play_end",
          "play_error",
          "playlist_resolved",
          "no_content",
          "offline_cache",
          "heartbeat_status"
        ]
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt <= request.time;
    }

    match /digitalSignageDevices/{deviceId} {
      allow get: if resource.data.deviceToken == deviceId;

      allow create: if isAdmin()
        && request.resource.data.deviceToken == deviceId;
      allow update: if (
          resource.data.deviceToken == deviceId
          && request.resource.data.deviceToken == resource.data.deviceToken
          && changesOnly(request.resource.data, resource.data, [
            "lastSeenAt",
            "lastSeenMillis",
            "updatedAt"
          ])
          && request.resource.data.lastSeenMillis is number
        );

    }

    match /editorialProjects/{projectId} {
      allow get: if canAccessEditorialProjectData(resource.data);

      allow list: if hasProfile()
        && resource.data.ownerUid == request.auth.uid;
      allow list: if hasProfile()
        && request.auth.uid in resource.data.collaboratorUids;
      allow create: if validEditorialProjectCreate();
      allow update: if request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          isAdmin()
          || (hasProfile() && resource.data.ownerUid == request.auth.uid)
          || (
            (hasProfile() && matchesEditorialProjectCollaborator((resource.data)))
            && changesOnly(request.resource.data, resource.data, [
              "name",
              "type",
              "size",
              "orientation",
              "margins",
              "bleedIn",
              "widthIn",
              "heightIn",
              "academicMetadata",
              "seriesId",
              "seriesName",
              "levelId",
              "levelName",
              "bookId",
              "bookName",
              "unitNumber",
              "unitTitle",
              "lessonNumber",
              "lessonTitle",
              "academicType",
              "activityNumber",
              "updatedBy",
              "updatedAt"
            ])
          )
        );
      allow delete: if (hasProfile() && resource.data.ownerUid == request.auth.uid);

      match /documents/{documentId} {
        allow read: if canAccessEditorialProject(projectId);
        allow create: if canCreateEditorialProjectChild(projectId);
        allow update, delete: if canEditEditorialContent(projectId);

        match /sections/{sectionId} {
          allow read: if canAccessEditorialProject(projectId);
          allow create: if canCreateEditorialProjectChild(projectId)
            || canEditEditorialContent(projectId);
          allow update, delete: if canEditEditorialContent(projectId);
        }

        match /pages/{pageId} {
          allow read: if canAccessEditorialProject(projectId);
          allow create: if canCreateEditorialProjectChild(projectId)
            || canEditEditorialContent(projectId);
          allow update, delete: if canEditEditorialContent(projectId);

          match /elements/{elementId} {
            allow read: if canAccessEditorialProject(projectId);
            allow create, update, delete: if canEditEditorialContent(projectId);
          }
        }

        match /masterPages/{masterPageId} {
          allow read: if canAccessEditorialProject(projectId);
          allow create, update, delete: if canEditEditorialContent(projectId);

          match /elements/{elementId} {
            allow read: if canAccessEditorialProject(projectId);
            allow create, update, delete: if canEditEditorialContent(projectId);
          }
        }

        match /comments/{commentId} {
          allow read: if canAccessEditorialProject(projectId);
          allow create, update, delete: if (canEditEditorialProject((projectId))
        && (isEditorialOwnerOrAdmin((projectId)) || editorialUserLevel((projectId)) != "viewer"));
        }

        match /versions/{versionId} {
          allow read: if canAccessEditorialProject(projectId);
          allow create, update, delete: if canEditEditorialContent(projectId);
        }

        match /exports/{exportId} {
          allow read: if canAccessEditorialProject(projectId);
          allow create, update, delete: if canEditEditorialContent(projectId);
        }

        // Fase 7 — Publicaciones editoriales inmutables. Publicar/actualizar
        // estado requiere capacidad de publicación. No se permite delete: las
        // publicaciones se archivan, conservando historial y dependencias.
        match /publications/{publicationId} {
          allow read: if canAccessEditorialProject(projectId);
          allow create, update: if (canAccessEditorialProject((projectId))
        && (
          isEditorialOwnerOrAdmin((projectId))
          || editorialUserLevel((projectId)) == "publisher"
          || editorialUserLevel((projectId)) == "manager"
        ));
        }
      }

      match /components/{componentId} {
        allow read: if canAccessEditorialProject(projectId);
        allow create, update, delete: if canEditEditorialContent(projectId);

        match /elements/{elementId} {
          allow read: if canAccessEditorialProject(projectId);
          allow create, update, delete: if canEditEditorialContent(projectId);
        }
      }

      match /styles/{styleId} {
        allow read: if canAccessEditorialProject(projectId);
        allow create, update, delete: if canEditEditorialContent(projectId);
      }

      match /variables/{variableId} {
        allow read: if canAccessEditorialProject(projectId);
        allow create, update, delete: if canEditEditorialContent(projectId);
      }
    }

    match /editorialTemplates/{templateId} {
      allow read: if (hasProfile() && resource.data.visibility == "institutional")
        || (
          resource.data.projectId is string
          && canAccessEditorialProject(resource.data.projectId)
        );
      allow create: if (
          request.resource.data.visibility == "project"
          && request.resource.data.projectId is string
          && request.resource.data.ownerUid == request.auth.uid
          && canEditEditorialProject(request.resource.data.projectId)
        );
      allow update: if (
          resource.data.visibility == "project"
          && request.resource.data.visibility == "project"
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.projectId == resource.data.projectId
          && canEditEditorialProject(resource.data.projectId)
        );
      allow delete: if (
          resource.data.visibility == "project"
          && resource.data.ownerUid == request.auth.uid
          && canEditEditorialProject(resource.data.projectId)
        );

      match /pages/{pageId} {
        allow read: if canAccessEditorialTemplate(templateId);
        allow create, update, delete: if canEditEditorialTemplate(templateId);

        match /elements/{elementId} {
          allow read: if canAccessEditorialTemplate(templateId);
          allow create, update, delete: if canEditEditorialTemplate(templateId);
        }
      }
    }

    match /editorialAssets/{assetId} {
      allow read: if resource.data.projectId is string
        && canAccessEditorialProject(resource.data.projectId);
      allow create: if request.resource.data.projectId is string
        && request.resource.data.ownerUid == request.auth.uid
        && canEditEditorialProject(request.resource.data.projectId);
      allow update: if resource.data.projectId == request.resource.data.projectId
        && resource.data.ownerUid == request.resource.data.ownerUid
        && canEditEditorialProject(resource.data.projectId);
      allow delete: if canEditEditorialProject(resource.data.projectId);
    }

    match /digitalSignagePairingSessions/{sessionId} {


      allow create: if hasOnlyFields(request.resource.data, [
          "code",
          "status",
          "deviceToken",
          "createdAt",
          "expiresAt",
          "claimedAt",
          "claimedBy",
          "userAgent",
          "lastSeenAt",
          "setupSecret"
        ])
        && request.resource.data.code is string
        && request.resource.data.code.matches("^AES-[0-9]{4,6}$")
        && request.resource.data.status == "pending"
        && request.resource.data.deviceToken == null
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt <= request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.claimedAt == null
        && request.resource.data.claimedBy == ""
        && request.resource.data.userAgent is string
        && request.resource.data.lastSeenAt is timestamp
        && request.resource.data.lastSeenAt <= request.time
        && request.resource.data.setupSecret is string
        && request.resource.data.setupSecret.size() >= 16;
      allow update: if (
          resource.data.status == "pending"
          && request.resource.data.status == resource.data.status
          && request.resource.data.setupSecret == resource.data.setupSecret
          && changesOnly(request.resource.data, resource.data, [
            "lastSeenAt",
            "setupSecret"
          ])
          && request.resource.data.lastSeenAt is timestamp
        );

    }

    match /userDashboardPreferences/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.ownerUid == userId
        && request.resource.data.version is int
        && request.resource.data.layout is list
        && request.resource.data.updatedAt is timestamp
        && hasOnlyFields(request.resource.data, [
          "ownerUid",
          "version",
          "layout",
          "updatedAt"
        ]);
      allow update: if signedIn()
        && request.auth.uid == userId
        && resource.data.ownerUid == userId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.version is int
        && request.resource.data.layout is list
        && request.resource.data.updatedAt is timestamp
        && changesOnly(request.resource.data, resource.data, [
          "version",
          "layout",
          "updatedAt"
        ]);
      allow delete: if signedIn() && request.auth.uid == userId;
    }


  }
}
