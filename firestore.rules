        && request.resource.data.productId is string
        && request.resource.data.productName is string
        && request.resource.data.campus is string
        && request.resource.data.level is string
        && request.resource.data.performedByUid == request.auth.uid
        && request.resource.data.performedByName is string
        && request.resource.data.performedByEmail is string
        && request.resource.data.createdAt is timestamp;
    }

    function validTechnicalLocationCreate() {
      return canManageTechnicalSupport()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.campus is string
        && request.resource.data.campus.size() > 0
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0;
    }

    function validTechnicalLocationUpdate() {
      return canManageTechnicalSupport()
        && (
          !("name" in request.resource.data) ||
          (
            request.resource.data.name is string
            && request.resource.data.name.size() > 0
          )
        )
        && (
          !("campus" in request.resource.data) ||
          (
            request.resource.data.campus is string
            && request.resource.data.campus.size() > 0
          )
        )
        && (
          !("type" in request.resource.data) ||
          (
            request.resource.data.type is string
            && request.resource.data.type.size() > 0
          )
        );
    }

    function validTechnicalLocationReviewCreate() {
      return canManageTechnicalSupport()
        && request.resource.data.locationId is string
        && request.resource.data.locationId.size() > 0
        && request.resource.data.locationName is string
        && request.resource.data.locationName.size() > 0;
    }


    function validPurchasePriority(priority) {
      return priority in [
        "low",
        "normal",
        "high",
        "urgent"
      ];
    }

    function validPurchaseStatus(status) {
      return status in [
        "pending_review",
        "reviewing",
        "approved",
        "purchasing",
        "purchased",
        "received",
        "delivered",
        "rejected",
        "cancelled"
      ];
    }

    function canReadPurchaseRequest() {
      return hasProfile()
        && (
          isAdmin() || resource.data.requestedByUid == request.auth.uid
        );
    }

    function canReadPurchaseRequestId(requestId) {
      return hasProfile()
        && exists(/databases/$(database)/documents/purchaseRequests/$(requestId))
        && (
          isAdmin()
          || get(/databases/$(database)/documents/purchaseRequests/$(requestId)).data.requestedByUid == request.auth.uid
        );
    }

    function validPurchaseRequestCreate() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          "itemName",
          "description",
          "department",
          "priority",
          "quantity",
          "suggestedLink",
          "projectName",
          "requesterComment",
          "status",
          "adminComment",
          "rejectionReason",
          "requestedByUid",
          "requestedByName",
          "requestedByEmail",
          "createdByUid",
          "createdByName",
          "createdByEmail",
          "purchasedAt",
          "receivedAt",
          "deliveredAt",
          "cancelledAt",
          "createdAt",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && request.resource.data.itemName is string
        && request.resource.data.itemName.size() > 0
        && request.resource.data.itemName.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 700
        && request.resource.data.department is string
        && request.resource.data.department.size() > 0
        && request.resource.data.priority is string
        && validPurchasePriority(request.resource.data.priority)
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 999
        && request.resource.data.suggestedLink is string
        && request.resource.data.suggestedLink.size() <= 500
        && request.resource.data.projectName is string
        && request.resource.data.projectName.size() <= 120
        && request.resource.data.requesterComment is string
        && request.resource.data.requesterComment.size() <= 500
        && request.resource.data.status == "pending_review"
        && request.resource.data.adminComment == ""
        && request.resource.data.rejectionReason == ""
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.requestedByName is string
        && request.resource.data.requestedByEmail is string
        && request.resource.data.createdByName is string
        && request.resource.data.createdByEmail is string
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedByEmail is string;
    }

    function validPurchaseAdminUpdate() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "adminComment",
          "rejectionReason",
          "purchasedAt",
          "receivedAt",
          "deliveredAt",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && request.resource.data.status is string
        && validPurchaseStatus(request.resource.data.status)
        && request.resource.data.adminComment is string
        && request.resource.data.adminComment.size() <= 700
        && request.resource.data.rejectionReason is string
        && request.resource.data.rejectionReason.size() <= 700
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedByEmail is string
        && request.resource.data.updatedAt is timestamp;
    }

    function validPurchaseRequesterCancel() {
      return hasProfile()
        && resource.data.requestedByUid == request.auth.uid
        && resource.data.status == "pending_review"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "cancelledAt",
          "cancelledByUid",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && request.resource.data.status == "cancelled"
        && request.resource.data.cancelledByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedByEmail is string
        && request.resource.data.updatedAt is timestamp;
    }

    function validPurchaseLogCreate(requestId) {
      return hasProfile()
        && canReadPurchaseRequestId(requestId)
        && request.resource.data.keys().hasOnly([
          "requestId",
          "type",
          "message",
          "createdByUid",
          "createdByName",
          "createdByEmail",
          "createdAt"
        ])
        && request.resource.data.requestId == requestId
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByEmail is string;
    }


    function validAnnouncementReadReceipt(announcementId, userId) {
      return hasProfile()
        && userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "announcementId",
          "userId",
          "userName",
          "userEmail",
          "readAt"
        ])
        && request.resource.data.announcementId == announcementId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 120
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail.size() <= 180
        && request.resource.data.readAt is timestamp;
    }

    function validPersonalNoteCreate() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          "userId",
          "title",
          "content",
          "pinned",
          "completed",
          "createdAt",
          "updatedAt",
          "color",
          "attachments"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 700
        && request.resource.data.pinned is bool
        && request.resource.data.completed is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(["color"])
          || (request.resource.data.color is string
            && request.resource.data.color.size() <= 20))
        && (!request.resource.data.keys().hasAny(["attachments"])
          || (request.resource.data.attachments is list
            && request.resource.data.attachments.size() <= 6));
    }

    function validPersonalNoteUpdate() {
      return hasProfile()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "userId",
          "title",
          "content",
          "pinned",
          "completed",
          "updatedAt",
          "color",
          "attachments"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 700
        && request.resource.data.pinned is bool
        && request.resource.data.completed is bool
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(["color"])
          || (request.resource.data.color is string
            && request.resource.data.color.size() <= 20))
        && (!request.resource.data.keys().hasAny(["attachments"])
          || (request.resource.data.attachments is list
            && request.resource.data.attachments.size() <= 6));
    }


    function canReadInternalMessage() {
      return hasProfile()
        && (
          resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid
        );
    }

    function validInternalMessageCreate() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          "fromUserId",
          "fromUserName",
          "fromUserEmail",
          "toUserId",
          "toUserName",
          "toUserEmail",
          "subject",
          "message",
          "attachments",
          "replyToMessageId",
          "replyToFromUserId",
          "replyToFromUserName",
          "replyToMessage",
          "read",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId.size() > 0
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.fromUserName is string
        && request.resource.data.fromUserName.size() <= 120
        && request.resource.data.fromUserEmail is string
        && request.resource.data.fromUserEmail.size() <= 180
        && request.resource.data.toUserName is string
        && request.resource.data.toUserName.size() <= 120
        && request.resource.data.toUserEmail is string
        && request.resource.data.toUserEmail.size() <= 180
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1200
        && request.resource.data.attachments is list
        && request.resource.data.attachments.size() <= 6
        && request.resource.data.replyToMessageId is string
        && request.resource.data.replyToMessageId.size() <= 180
        && request.resource.data.replyToFromUserId is string
        && request.resource.data.replyToFromUserId.size() <= 180
        && request.resource.data.replyToFromUserName is string
        && request.resource.data.replyToFromUserName.size() <= 120
        && request.resource.data.replyToMessage is string
        && request.resource.data.replyToMessage.size() <= 240
        && request.resource.data.read == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validInternalMessageReadUpdate() {
      return hasProfile()
        && resource.data.toUserId == request.auth.uid
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "read",
          "readAt",
          "updatedAt"
        ])
        && request.resource.data.read == true
        && request.resource.data.readAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }


    function userMatchesDepartmentName(departmentName) {
      return hasProfile()
        && departmentName is string
        && (
          isAdmin()
          || userHasDepartmentName(departmentName)
        );
    }

    function userMatchesDepartmentId(departmentId) {
      return hasProfile()
        && departmentId is string
        && (
          isAdmin()
          || userDoc().data.departmentId == departmentId
          || userDoc().data.primaryDepartmentId == departmentId
          || userDoc().data.areaId == departmentId
          || (
            userDoc().data.departmentIds is list
            && departmentId in userDoc().data.departmentIds
          )
        );
    }

    function canReadDepartmentMessage() {
      return hasProfile()
        && (
          isAdmin()
          || request.auth.uid in resource.data.memberIds
        );
    }

    function validDepartmentMessageCreate() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          "departmentId",
          "departmentName",
          "fromUserId",
          "fromUserName",
          "fromUserEmail",
          "message",
          "attachments",
          "replyToMessageId",
          "replyToFromUserId",
          "replyToFromUserName",
          "replyToMessage",
          "memberIds",
          "readBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.departmentId is string
        && request.resource.data.departmentId.size() > 0
        && request.resource.data.departmentId.size() <= 120
        && request.resource.data.departmentName is string
        && request.resource.data.departmentName.size() > 0
        && request.resource.data.departmentName.size() <= 120
        && (
          userMatchesDepartmentId(request.resource.data.departmentId)
          || userMatchesDepartmentName(request.resource.data.departmentName)
        )
        && request.resource.data.fromUserName is string
        && request.resource.data.fromUserName.size() <= 120
        && request.resource.data.fromUserEmail is string
        && request.resource.data.fromUserEmail.size() <= 180
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1200
        && request.resource.data.attachments is list
        && request.resource.data.attachments.size() <= 6
        && request.resource.data.replyToMessageId is string
        && request.resource.data.replyToMessageId.size() <= 180
        && request.resource.data.replyToFromUserId is string
        && request.resource.data.replyToFromUserId.size() <= 180
        && request.resource.data.replyToFromUserName is string
        && request.resource.data.replyToFromUserName.size() <= 120
        && request.resource.data.replyToMessage is string
        && request.resource.data.replyToMessage.size() <= 240
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() <= 80
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.readBy is map
        && request.resource.data.readBy.keys().hasOnly([request.auth.uid])
        && request.resource.data.readBy[request.auth.uid] is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validDepartmentMessageReadUpdate() {
      return hasProfile()
        && canReadDepartmentMessage()
        && request.resource.data.departmentId == resource.data.departmentId
        && request.resource.data.departmentName == resource.data.departmentName
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "readBy",
          "updatedAt"
        ])
        && request.resource.data.readBy is map
        && request.resource.data.readBy[request.auth.uid] is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validUserPresenceWrite(userId) {
      return hasProfile()
        && userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "userId",
          "userName",
          "userEmail",
          "isOnline",
          "lastSeen",
          "currentPage",
          "updatedAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 120
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail.size() <= 180
        && request.resource.data.isOnline is bool
        && request.resource.data.currentPage is string
        && request.resource.data.currentPage.size() <= 80
        && request.resource.data.lastSeen is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function canReadMessageTypingState() {
      return hasProfile()
        && request.auth.uid in resource.data.memberIds;
    }

    function validMessageTypingStateWrite() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          "chatKey",
          "chatType",
          "targetId",
          "userId",
          "userName",
          "memberIds",
          "isTyping",
          "updatedAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.chatKey is string
        && request.resource.data.chatKey.size() > 0
        && request.resource.data.chatKey.size() <= 180
        && request.resource.data.chatType in ["direct", "department"]
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 180
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 120
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() <= 80
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.isTyping is bool
        && request.resource.data.updatedAt is timestamp;
    }

    match /announcements/{announcementId} {
      allow read: if hasProfile();

      allow create, update, delete: if isAdmin();

      match /reads/{userId} {
        allow get: if isAdmin()
          || (hasProfile() && userId == request.auth.uid);

        allow list: if isAdmin();

        allow create, update: if validAnnouncementReadReceipt(announcementId, userId);

        allow delete: if isAdmin();
      }
    }

    match /personalNotes/{noteId} {
      allow get, list: if hasProfile()
        && resource.data.userId == request.auth.uid;

      allow create: if validPersonalNoteCreate();

      allow update: if validPersonalNoteUpdate();

      allow delete: if hasProfile()
        && resource.data.userId == request.auth.uid;
    }

    match /userPresence/{userId} {
      allow get, list: if hasProfile();

      allow create, update: if validUserPresenceWrite(userId);

      allow delete: if false;
    }

    match /systemSettings/{settingId} {
      allow get, list: if isAdminRole();

      allow create, update, delete: if isAdminRole();
    }

    match /driveDepartmentFolders/{folderId} {
      allow get, list: if isAdminRole();

      allow create, update, delete: if isAdminRole();
    }

    match /driveActivityLogs/{logId} {
      allow get, list: if isAdminRole();

      allow create, update, delete: if false;
    }

    match /protectLogs/{logId} {
      allow get, list: if isAdminRole();

      allow create, update, delete: if false;
    }

    match /drivePrivateItems/{fileId} {
      allow read, write: if false;
    }

    match /driveShares/{shareId} {
      allow read, write: if false;
    }

    match /messageTypingStates/{stateId} {
      allow get: if canReadMessageTypingState();

      allow list: if hasProfile();

      allow create: if validMessageTypingStateWrite();

      allow update: if resource.data.userId == request.auth.uid
        && validMessageTypingStateWrite();

      allow delete: if false;
    }

    match /internalMessages/{messageId} {
      allow get, list: if canReadInternalMessage();

      allow create: if validInternalMessageCreate();

      allow update: if validInternalMessageReadUpdate();

      allow delete: if false;
    }


    match /departmentMessages/{messageId} {
      allow get, list: if canReadDepartmentMessage();

      allow create: if validDepartmentMessageCreate();

      allow update: if validDepartmentMessageReadUpdate();

      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if hasProfile() && resource.data.recipientId == request.auth.uid;

      allow create: if validNotificationCreate();

      allow update: if validNotificationReadUpdate();

      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if signedIn() && (
        userId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isAdmin()
        || (
          hasProfile()
          && resource.data.active == true
        );

      allow create: if isAdmin();

      allow update: if isAdmin()
        || (signedIn() && userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "phone", "bio", "photoURL", "notificationPreferences", "profileUpdatedAt"
          ])
          && request.resource.data.bio is string
          && request.resource.data.bio.size() <= 400);

      allow delete: if false;
    }

    match /projects/{projectId} {
      allow get: if canAccessProject();

      allow list: if isAdmin() || canAccessProject();
      allow list: if hasProfile()
        && request.auth.uid in resource.data.collaboratorIds;

      allow create: if adminValidProjectCreate();

      allow update: if adminValidProjectUpdate()
        || collaboratorAllowedProjectUpdate();

      allow delete: if false;
    }

    match /projectUpdates/{updateId} {
      allow read: if isAdmin()
        || (
          hasProfile()
          && resource.data.projectId is string
          && canAccessProjectId(resource.data.projectId)
        );

      allow create: if validProjectUpdateCreate();

      allow update, delete: if false;
    }

    match /projectLogs/{logId} {
      allow read: if isAdmin()
        || (
          hasProfile()
          && resource.data.projectId is string
          && canAccessProjectId(resource.data.projectId)
        );

      allow create: if validProjectLogCreate();

      allow update, delete: if false;
    }

    match /evidence/{evidenceId} {
      allow read: if isAdmin()
        || (
          hasProfile()
          && resource.data.projectId is string
          && canAccessProjectId(resource.data.projectId)
        );

      allow create: if validEvidenceCreate();

      allow update: if validEvidenceUpdate();

      allow delete: if false;
    }

    match /areas/{areaId} {
      allow read: if hasProfile();

      allow create, update: if isAdmin();

      allow delete: if false;
    }

    match /departments/{departmentId} {
      allow read: if hasProfile();

      allow create, update: if isAdmin();

      allow delete: if false;
    }


    match /workSchedules/{scheduleId} {
      allow read: if hasProfile();

      allow create, update, delete: if isAdmin();
    }


    match /scheduleRequests/{requestId} {
      allow read: if isAdmin()
        || isOwnScheduleRequest();

      allow create: if validScheduleRequestCreate();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    match /scheduleAdjustments/{adjustmentId} {
      allow read: if hasProfile();

      allow create: if isAdmin()
        || validAutoScheduleAdjustmentCreate();

      allow update, delete: if isAdmin();
    }

    match /scheduleLogs/{logId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        || validAutoScheduleLogCreate();

      allow update, delete: if false;
    }

    match /attendanceLocations/{locationId} {
      allow read: if hasProfile();

      allow create, update, delete: if isAdmin();
    }

    match /workSessions/{sessionId} {
      allow get: if isAdmin()
        || isOwnWorkSession();

      allow list: if isAdmin();

      allow create: if validWorkSessionCreate();

      allow update: if isAdmin()
        || validWorkSessionUpdate();

      allow delete: if isAdmin();
    }


    match /printProducts/{productId} {
      allow read: if hasProfile();

      allow create: if canAccessPrintshop()
        && validPrintProductData();

      allow update: if (
          canAccessPrintshop()
          && validPrintProductData()
        )
        || validPrintProductStatusUpdate()
        || validPrintshopSoftDeleteUpdate();

      allow delete: if false;
    }


    match /printFinishedInventory/{inventoryId} {
      allow read: if canAccessPrintshop();

      allow create: if isAdmin()
        && validPrintFinishedInventoryData();

      allow update: if (
          isAdmin()
          && validPrintFinishedInventoryData()
        )
        || responsibleInventoryEntryUpdate()
        || validPrintshopSoftDeleteUpdate();

      allow delete: if false;
    }

    match /printInventoryMovements/{movementId} {
      allow read: if canAccessPrintshop();

      allow create: if (
          isAdmin()
          || responsibleBatchInventoryMovementCreate()
        )
        && validPrintInventoryMovementData();

      allow update, delete: if false;
    }


    match /printSupplyItems/{supplyId} {
      allow read: if canAccessPrintshop();

      allow create: if canAccessPrintshop()
        && validPrintSupplyItemData();

      allow update: if (
          canAccessPrintshop()
          && validPrintSupplyItemData()
        )
        || validSupplyStockMovementUpdate()
        || validPrintSupplyStatusUpdate()
        || validPrintshopSoftDeleteUpdate();

      allow delete: if false;
    }

    match /printSupplyMovements/{movementId} {
      allow read: if canAccessPrintshop();

      allow create: if canAccessPrintshop()
        && validPrintSupplyMovementData();

      allow update, delete: if false;
    }


    match /printProductionBatches/{batchId} {
      allow read: if canAccessPrintshop();

      allow create: if isAdmin()
        && validPrintProductionBatchData();

      allow update: if (
          isAdmin()
          && validPrintProductionBatchData()
        )
        || responsibleProductionBatchUpdate()
        || auditorQualityBatchUpdate()
        || responsibleInventoryBatchApplyUpdate()
        || validPrintshopSoftDeleteUpdate();

      allow delete: if isAdmin();
    }


    match /certificateSigners/{signerId} {
      allow read: if hasProfile() || resource.data.active == true;

      allow create: if isAdmin()
        && validCertificateSignerData();

      allow update: if (
          isAdmin()
          && validCertificateSignerData()
        )
        || validPrintshopSoftDeleteUpdate();

      allow delete: if isAdmin();
    }

    match /certificateTemplates/{templateId} {
      allow read: if hasProfile() || resource.data.active == true;

      allow create: if isAdmin()
        && validCertificateTemplateData();

      allow update: if (
          isAdmin()
          && validCertificateTemplateData()
        )
        || validPrintshopSoftDeleteUpdate();

      allow delete: if false;
    }

    match /credentialTemplates/{templateId} {
      allow read: if canAccessPrintshop();

      allow create: if isAdmin()
        && validCredentialTemplateData();

      allow update: if (
          isAdmin()
          && validCredentialTemplateData()
        )
        || validPrintshopSoftDeleteUpdate();

      allow delete: if false;
    }

    match /generatedCertificates/{certificateId} {
      allow read: if canAccessPrintshop() || canManageGeneratedCertificateResource();

      allow create: if canManageGeneratedCertificateData()
        && validGeneratedCertificateData();

      allow update: if (
          canManageGeneratedCertificateResource()
          && validGeneratedCertificateData()
        )
        || validPrintshopSoftDeleteUpdate();

      allow delete: if false;
    }

    match /certificateHistoryBatches/{batchId} {
      allow read: if canAccessPrintshop()
        || canManageGeneratedCertificateRequest(resource.data.requestId);

      allow create: if request.resource.data.requestId == batchId
        && canManageGeneratedCertificateRequest(request.resource.data.requestId);

      allow update: if request.resource.data.requestId == resource.data.requestId
        && request.resource.data.requestId == batchId
        && canManageGeneratedCertificateRequest(resource.data.requestId);

      allow delete: if false;
    }

    match /generatedCredentials/{credentialId} {
      allow read: if canAccessPrintshop();

      allow create: if canAccessPrintshop()
        && validGeneratedCredentialData();

      allow update: if (
          canAccessPrintshop()
          && validGeneratedCredentialData()
        )
        || validPrintshopSoftDeleteUpdate();

      allow delete: if isAdmin();
    }

    match /printshopLogs/{logId} {
      allow read: if canAccessPrintshop();

      allow create: if (canAccessPrintshop() || hasProfile())
        && validPrintshopLogData();

      allow update, delete: if false;
    }

    match /publicCertificateValidations/{validationId} {
      allow read: if true;

      allow create, update: if canManageGeneratedCertificateData()
        && validPublicCertificateValidationData();

      allow delete: if false;
    }

    match /publicCertificatePeople/{personId} {
      allow read: if resource.data.active == true
        && resource.data.type in ["Principal", "Teacher"];
      allow create, update, delete: if false;
    }

    match /publicCredentialValidations/{validationId} {
      allow read: if true;

      allow create, update: if canAccessPrintshop()
        && validPublicCredentialValidationData();

      allow delete: if false;
    }



    function validPublicCertificateFormCreate(requestData) {
      return requestData.keys().hasAll([
          "folio",
          "publicTrackingEnabled"
        ])
        && requestData.folio is string
        && requestData.folio.size() > 0
        && requestData.publicTrackingEnabled == true
        && (
          (
            requestData.keys().hasAll([
              "publicRequestSource",
              "requestType",
              "status",
              "createdByUid"
            ])
            && requestData.publicRequestSource == "certificate-public-form"
            && requestData.requestType == "Certificado"
            && requestData.status in ["Solicitud recibida", "received"]
            && requestData.createdByUid == "public-form"
          )
          ||
          (
            requestData.keys().hasAll([
              "certificateType",
              "status",
              "createdBy"
            ])
            && requestData.certificateType == "Certificado"
            && requestData.status in ["Solicitud recibida", "received"]
            && requestData.createdBy in ["public-form", "public-certificate-form"]
          )
        );
    }

    function validPublicPrintRequestCreate(requestData) {
      return validPublicCertificateFormCreate(requestData)
        && requestData.keys().hasAll([
          "publicRequestSource",
          "requestType",
          "createdByUid",
          "assignedUserId",
          "assignedUserName",
          "supportUserId",
          "supportUserName",
          "assignmentSource"
        ])
        && requestData.assignedUserId is string
        && requestData.assignedUserId.size() > 0
        && requestData.assignedUserName is string
        && requestData.assignedUserName.size() > 0
        && requestData.supportUserId is string
        && requestData.supportUserId.size() > 0
        && requestData.supportUserId != requestData.assignedUserId
        && requestData.supportUserName is string
        && requestData.supportUserName.size() > 0
        && requestData.assignmentSource in [
          "agenda:tony",
          "agenda:ernesto",
          "fallback:tony-default"
        ];
    }

    function isPublicCertificateRequestEditable() {
      return resource.data.publicTrackingEnabled == true
        && resource.data.publicRequestSource == "certificate-public-form"
        && resource.data.status in [
          "Solicitud recibida",
          "Datos incompletos",
          "En revisión",
          "Aprobada"
        ];
    }

    function validPublicPrintRequestUpdate() {
      return isPublicCertificateRequestEditable()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "requesterName",
          "requesterId",
          "campus",
          "dueDate",
          "requestedDeliveryDate",
          "notes",
          "requestedQuantity",
          "printedQuantity",
          "digitalQuantity",
          "deliveryType",
          "students",
          "productName",
          "level",
          "group",
          "courseLevel",
          "courseProgramName",
          "courseAudience",
          "certificateTemplateLevel",
          "certificateTemplateProgramName",
          "certificateTemplateAudience",
          "teacherName",
          "schedule",
          "teacherSignerId",
          "teacherSignerName",
          "teacherSignerRole",
          "teacherSignatureUrl",
          "teacherSignatureDataUrl",
          "academicDirector",
          "certificateDirectorName",
          "principalSignerId",
          "principalSignerName",
          "principalSignerRole",
          "principalSignatureUrl",
          "principalSignatureDataUrl",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && request.resource.data.status == resource.data.status
        && request.resource.data.publicTrackingEnabled == true
        && request.resource.data.publicRequestSource == "certificate-public-form"
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.requestType == "Certificado"
        && request.resource.data.requesterName is string
        && request.resource.data.requesterName.size() > 0
        && request.resource.data.requesterArea == "Dirección Académica"
        && (!("requesterId" in request.resource.data) || request.resource.data.requesterId is string)
        && request.resource.data.campus in [
          "Plaza Estrella",
          "Plaza Bugambilias",
          "Plaza Aranjuez",
          "Online"
        ]
        && request.resource.data.dueDate is string
        && request.resource.data.requestedDeliveryDate is string
        && request.resource.data.notes is string
        && request.resource.data.requestedQuantity is number
        && request.resource.data.requestedQuantity > 0
        && request.resource.data.requestedQuantity <= 150
        && request.resource.data.printedQuantity is number
        && request.resource.data.printedQuantity >= 0
        && request.resource.data.digitalQuantity is number
        && request.resource.data.digitalQuantity >= 0
        && request.resource.data.printedQuantity + request.resource.data.digitalQuantity == request.resource.data.requestedQuantity
        && request.resource.data.deliveryType in [
          "Impresa",
          "Digital",
          "Ambas"
        ]
        && request.resource.data.students is list
        && request.resource.data.students.size() == request.resource.data.requestedQuantity
        && request.resource.data.level is string
        && request.resource.data.group is string
        && request.resource.data.group.size() > 0
        && request.resource.data.courseLevel is string
        && request.resource.data.courseLevel.size() > 0
        && request.resource.data.teacherName is string
        && request.resource.data.schedule is string
        && request.resource.data.teacherSignerName is string
        && request.resource.data.principalSignerName is string
        && request.resource.data.principalSignerRole is string
        && request.resource.data.certificateDirectorName is string
        && request.resource.data.academicDirector is string
        && request.resource.data.updatedByUid == "public-form"
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedByName.size() > 0;
    }




    match /certificateRequests/{requestId} {
      allow create: if validCertificateRequestCreate()
        || validPublicCertificateFormCreate(request.resource.data);

      allow get: if resource.data.publicTrackingEnabled == true
        || canAccessPrintshop();

      allow list: if canAccessPrintshop();

      allow update: if canAccessPrintshop();

      allow delete: if false;
    }

    match /printRequests/{requestId} {
      allow get: if canAccessPrintshop()
        || resource.data.publicTrackingEnabled == true
        || isPrintRequestResponsible()
        || isPrintRequestCollaborator();

      allow list: if canAccessPrintshop()
        || (
          hasProfile()
          && isPrintRequestMemberData(resource.data)
        );

      allow create: if isAdmin()
        && (
          (
            request.resource.data.createdByUid == request.auth.uid
            && validPrintRequestData()
          )
          || validPublicPrintRequestCreate(request.resource.data)
        );

      allow update: if isAdmin()
        || responsiblePrintRequestUpdate()
        || printshopCertificateStudentsUpdate()
        || validPrintRequestAutoAssignUpdate()
        || validPublicPrintRequestUpdate()
        || validPrintshopSoftDeleteUpdate();

      allow delete: if isAdmin();
    }

    match /technicalAssets/{assetId} {
      allow read: if canAccessTechnicalSupport();

      allow create, update: if canManageTechnicalSupport();

      allow delete: if isAdmin();
    }

    match /technicalAssetLogs/{logId} {
      allow read: if canAccessTechnicalSupport();

      allow create: if canManageTechnicalSupport();

      allow update, delete: if false;
    }

    match /technicalMaintenances/{maintenanceId} {
      allow read: if canAccessTechnicalSupport();

      allow create, update: if canManageTechnicalSupport();

      allow delete: if isAdmin();
    }

    match /technicalLocations/{locationId} {
      allow read: if canAccessTechnicalSupport();

      allow create: if validTechnicalLocationCreate();

      allow update: if validTechnicalLocationUpdate();

      allow delete: if isAdmin();
    }

    match /technicalLocationReviews/{reviewId} {
      allow read: if canAccessTechnicalSupport();

      allow create: if validTechnicalLocationReviewCreate();

      allow update: if canManageTechnicalSupport();

      allow delete: if isAdmin();
    }

    match /technicalSpareParts/{partId} {
      allow read: if canAccessTechnicalSupport();

      allow create, update: if canManageTechnicalSupport();

      allow delete: if isAdmin();
    }

    match /technicalSparePartMovements/{movementId} {
      allow read: if canAccessTechnicalSupport();

      allow create: if canManageTechnicalSupport();

      allow update, delete: if false;
    }

    match /technicalInstallationTemplates/{templateId} {
      allow read: if canAccessTechnicalSupport();

      allow create, update: if canManageTechnicalSupport();

      allow delete: if isAdmin();
    }

    function isClosedTechnicalInstallation() {
      return resource.data.status == "completed" || resource.data.status == "cancelled";
    }

    function isCompletedTechnicalInstallation() {
      return resource.data.status == "completed";
    }

    function isInstallationEvidenceOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "evidenceItems",
        "evidenceCount",
        "imageEvidenceCount",
        "videoEvidenceCount",
        "updatedAt",
        "updatedBy",
        "updatedByEmail",
        "updatedById"
      ]);
    }

    match /technicalInstallations/{installationId} {
      allow read: if canAccessTechnicalSupport();

      allow create: if canManageTechnicalSupport();

      allow update: if canManageTechnicalSupport()
        && (
          !isClosedTechnicalInstallation() ||
          isAdmin() ||
          (isCompletedTechnicalInstallation() && isInstallationEvidenceOnlyUpdate())
        );

      allow delete: if isAdmin();
    }




    function canReadIdea() {
      return isAdmin()
        || (
          hasProfile()
          && resource.data.createdByUid == request.auth.uid
        );
    }

    function canReadIdeaId(ideaId) {
      return isAdmin()
        || (
          hasProfile()
          && exists(/databases/$(database)/documents/ideas/$(ideaId))
          && get(/databases/$(database)/documents/ideas/$(ideaId)).data.createdByUid == request.auth.uid
        );
    }

    function validIdeaCreate() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          "title",
          "category",
          "currentProblem",
          "proposedIdea",
          "expectedBenefit",
          "evidenceFiles",
          "evidenceCount",
          "status",
          "createdByUid",
          "createdByName",
          "createdByEmail",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.currentProblem is string
        && request.resource.data.currentProblem.size() > 0
        && request.resource.data.proposedIdea is string
        && request.resource.data.proposedIdea.size() > 0
        && request.resource.data.expectedBenefit is string
        && request.resource.data.expectedBenefit.size() > 0
        && request.resource.data.status == "nueva";
    }

    function validIdeaOwnerEvidenceUpdate() {
      return hasProfile()
        && resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "evidenceFiles",
          "evidenceCount",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ]);
    }

    match /ideas/{ideaId} {
      allow get, list: if canReadIdea();

      allow create: if validIdeaCreate();

      allow update: if isAdmin()
        || validIdeaOwnerEvidenceUpdate();

      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow get, list: if canReadIdeaId(ideaId);

        allow create: if isAdmin()
          && request.resource.data.ideaId == ideaId
          && request.resource.data.comment is string
          && request.resource.data.comment.size() > 0
          && request.resource.data.createdByUid == request.auth.uid;

        allow update, delete: if false;
      }
    }

    match /bugReports/{reportId} {
      allow get, list: if canReadBugReport();

      allow create: if validBugReportCreate();

      allow update: if isAdmin()
        && request.resource.data.status is string
        && validBugReportStatus(request.resource.data.status);

      allow delete: if isAdmin();
    }


    match /purchaseRequests/{requestId} {
      allow get: if canReadPurchaseRequest();

      allow list: if isAdmin() || canReadPurchaseRequest();

      allow create: if validPurchaseRequestCreate();

      allow update: if validPurchaseAdminUpdate()
        || validPurchaseRequesterCancel();

      allow delete: if isAdmin();

      match /logs/{logId} {
        allow read: if canReadPurchaseRequestId(requestId);

        allow create: if validPurchaseLogCreate(requestId);

        allow update, delete: if false;
      }
    }

    match /projectInternalNotes/{noteId} {
      allow read: if isAdmin();

      allow create: if validInternalNoteCreate();

      allow update, delete: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /digitalSignageAssets/{assetId} {
      allow get: if isAdmin()
        || resource.data.active == true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /digitalSignagePlaylists/{playlistId} {
      allow get: if isAdmin()
        || resource.data.active == true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /digitalSignageDevices/{deviceId} {
      allow get: if isAdmin()
        || resource.data.deviceToken == deviceId;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.deviceToken == deviceId;
      allow update: if isAdmin()
        || (
          resource.data.deviceToken == deviceId
          && request.resource.data.deviceToken == resource.data.deviceToken
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "lastSeenAt",
            "lastSeenMillis",
            "updatedAt"
          ])
          && request.resource.data.lastSeenMillis is number
        );
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
