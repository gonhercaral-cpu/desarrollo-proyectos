rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath());
    }

    function hasProfile() {
      return userExists()
        && userDoc().data.active == true;
    }

    function role() {
      return userDoc().data.role;
    }

    function normalizedRole() {
      return role() is string ? role().lower() : role();
    }

    function isAdminRole() {
      return userExists()
        && normalizedRole() is string
        && normalizedRole().matches('^ *admin *$');
    }

    function isAdmin() {
      return hasProfile() && isAdminRole();
    }


    function validAutoApprovalReason(reason) {
      return reason in ["assembly", "specialMeeting", "theocraticEvent"];
    }

    function scheduleRequestPath(requestId) {
      return /databases/$(database)/documents/scheduleRequests/$(requestId);
    }

    function isOwnScheduleRequest() {
      return hasProfile()
        && resource.data.userId == request.auth.uid;
    }

    function validScheduleRequestCreate() {
      return hasProfile()
        && request.resource.data.userId == request.auth.uid
        && (
          request.resource.data.status == "pending"
          || (
            request.resource.data.status == "approved"
            && request.resource.data.autoApproved == true
            && validAutoApprovalReason(request.resource.data.autoApprovalReason)
          )
        );
    }

    function validAutoScheduleAdjustmentCreate() {
      return hasProfile()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sourceRequestId is string
        && request.resource.data.autoApproved == true
        && validAutoApprovalReason(request.resource.data.autoApprovalReason)
        && exists(scheduleRequestPath(request.resource.data.sourceRequestId))
        && get(scheduleRequestPath(request.resource.data.sourceRequestId)).data.userId == request.auth.uid
        && get(scheduleRequestPath(request.resource.data.sourceRequestId)).data.status == "approved"
        && get(scheduleRequestPath(request.resource.data.sourceRequestId)).data.autoApproved == true
        && get(scheduleRequestPath(request.resource.data.sourceRequestId)).data.autoApprovalReason == request.resource.data.autoApprovalReason;
    }

    function validAutoScheduleLogCreate() {
      return hasProfile()
        && request.resource.data.action == "autoApproved"
        && request.resource.data.requestId is string
        && request.resource.data.autoApproved == true
        && validAutoApprovalReason(request.resource.data.autoApprovalReason)
        && exists(scheduleRequestPath(request.resource.data.requestId))
        && get(scheduleRequestPath(request.resource.data.requestId)).data.userId == request.auth.uid
        && get(scheduleRequestPath(request.resource.data.requestId)).data.status == "approved"
        && get(scheduleRequestPath(request.resource.data.requestId)).data.autoApproved == true
        && get(scheduleRequestPath(request.resource.data.requestId)).data.autoApprovalReason == request.resource.data.autoApprovalReason;
    }

    function isOwnWorkSession() {
      return hasProfile()
        && resource.data.userId == request.auth.uid;
    }

    function validWorkSessionCreate() {
      return hasProfile()
        && request.resource.data.userId == request.auth.uid;
    }

    function validWorkSessionUpdate() {
      return hasProfile()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    function isRequester() {
      return hasProfile() && role() == "requester";
    }

    function hasUserArea() {
      return hasProfile() && userDoc().data.area is string;
    }

    function userHasDepartmentName(departmentName) {
      return hasProfile()
        && departmentName is string
        && (
          (userDoc().data.area is string && userDoc().data.area.lower() == departmentName.lower()) ||
          (userDoc().data.department is string && userDoc().data.department.lower() == departmentName.lower()) ||
          (userDoc().data.departmentName is string && userDoc().data.departmentName.lower() == departmentName.lower()) ||
          (userDoc().data.team is string && userDoc().data.team.lower() == departmentName.lower()) ||
          (
            userDoc().data.departmentNames is list
            && departmentName in userDoc().data.departmentNames
          ) ||
          (
            userDoc().data.departments is list
            && departmentName in userDoc().data.departments
          )
        );
    }

    function isTechnicalSupportUser() {
      return hasProfile()
        && (
          userHasDepartmentName("Soporte Técnico") ||
          userHasDepartmentName("Soporte tecnico") ||
          userHasDepartmentName("Soporte técnico")
        );
    }

    function canManageTechnicalSupport() {
      return isAdmin() || isTechnicalSupportUser();
    }

    function canAccessTechnicalSupport() {
      return canManageTechnicalSupport();
    }

    function isPrintshopUser() {
      return hasProfile()
        && (
          userHasDepartmentName("Imprenta") ||
          userHasDepartmentName("Impresión") ||
          userHasDepartmentName("Impresion") ||
          userHasDepartmentName("Soporte Técnico") ||
          userHasDepartmentName("Soporte tecnico") ||
          userHasDepartmentName("Soporte técnico")
        );
    }

    function canAccessPrintshop() {
      return isAdmin() || isPrintshopUser();
    }

    function projectPath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId);
    }

    function projectExists(projectId) {
      return exists(projectPath(projectId));
    }

    function projectData(projectId) {
      return get(projectPath(projectId)).data;
    }

    function isAssignedToProject() {
      return hasProfile()
        && (
          ("assignedToUid" in resource.data && resource.data.assignedToUid == request.auth.uid) ||
          ("assignedToId" in resource.data && resource.data.assignedToId == request.auth.uid) ||
          ("assignedTo" in resource.data && resource.data.assignedTo == request.auth.uid) ||
          ("responsibleUid" in resource.data && resource.data.responsibleUid == request.auth.uid) ||
          ("responsibleId" in resource.data && resource.data.responsibleId == request.auth.uid)
        );
    }

    function isAssignedToProjectId(projectId) {
      return hasProfile()
        && projectExists(projectId)
        && (
          ("assignedToUid" in projectData(projectId) && projectData(projectId).assignedToUid == request.auth.uid) ||
          ("assignedToId" in projectData(projectId) && projectData(projectId).assignedToId == request.auth.uid) ||
          ("assignedTo" in projectData(projectId) && projectData(projectId).assignedTo == request.auth.uid) ||
          ("responsibleUid" in projectData(projectId) && projectData(projectId).responsibleUid == request.auth.uid) ||
          ("responsibleId" in projectData(projectId) && projectData(projectId).responsibleId == request.auth.uid)
        );
    }

    function isCollaboratorInProject() {
      return hasProfile()
        && (
          (
            "collaboratorIds" in resource.data
            && resource.data.collaboratorIds is list
            && request.auth.uid in resource.data.collaboratorIds
          )
          ||
          (
            "collaboratorUids" in resource.data
            && resource.data.collaboratorUids is list
            && request.auth.uid in resource.data.collaboratorUids
          )
          ||
          (
            "collaboratorsIds" in resource.data
            && resource.data.collaboratorsIds is list
            && request.auth.uid in resource.data.collaboratorsIds
          )
          ||
          (
            "collaborators" in resource.data
            && resource.data.collaborators is list
            && request.auth.uid in resource.data.collaborators
          )
        );
    }

    function isCollaboratorInProjectId(projectId) {
      return hasProfile()
        && projectExists(projectId)
        && (
          (
            "collaboratorIds" in projectData(projectId)
            && projectData(projectId).collaboratorIds is list
            && request.auth.uid in projectData(projectId).collaboratorIds
          )
          ||
          (
            "collaboratorUids" in projectData(projectId)
            && projectData(projectId).collaboratorUids is list
            && request.auth.uid in projectData(projectId).collaboratorUids
          )
          ||
          (
            "collaboratorsIds" in projectData(projectId)
            && projectData(projectId).collaboratorsIds is list
            && request.auth.uid in projectData(projectId).collaboratorsIds
          )
          ||
          (
            "collaborators" in projectData(projectId)
            && projectData(projectId).collaborators is list
            && request.auth.uid in projectData(projectId).collaborators
          )
        );
    }

    function isCreatorOfProject() {
      return hasProfile()
        && (
          ("createdByUid" in resource.data && resource.data.createdByUid == request.auth.uid) ||
          ("createdBy" in resource.data && resource.data.createdBy == request.auth.uid)
        );
    }

    function isCreatorOfProjectId(projectId) {
      return hasProfile()
        && projectExists(projectId)
        && (
          ("createdByUid" in projectData(projectId) && projectData(projectId).createdByUid == request.auth.uid) ||
          ("createdBy" in projectData(projectId) && projectData(projectId).createdBy == request.auth.uid)
        );
    }

    function isRequesterForProject() {
      return hasProfile()
        && isRequester()
        && hasUserArea()
        && (
          ("requesterArea" in resource.data && resource.data.requesterArea == userDoc().data.area) ||
          ("responsibleArea" in resource.data && resource.data.responsibleArea == userDoc().data.area)
        );
    }

    function isRequesterForProjectId(projectId) {
      return hasProfile()
        && isRequester()
        && hasUserArea()
        && projectExists(projectId)
        && (
          ("requesterArea" in projectData(projectId) && projectData(projectId).requesterArea == userDoc().data.area) ||
          ("responsibleArea" in projectData(projectId) && projectData(projectId).responsibleArea == userDoc().data.area)
        );
    }

    function canAccessProject() {
      return hasProfile()
        && (
          isAdmin() ||
          isAssignedToProject() ||
          isCollaboratorInProject() ||
          isCreatorOfProject() ||
          isRequesterForProject()
        );
    }

    function canAccessProjectId(projectId) {
      return hasProfile()
        && projectExists(projectId)
        && (
          isAdmin() ||
          isAssignedToProjectId(projectId) ||
          isCollaboratorInProjectId(projectId) ||
          isCreatorOfProjectId(projectId) ||
          isRequesterForProjectId(projectId)
        );
    }

    function canWorkOnProject() {
      return hasProfile()
        && !isHistoricalProject()
        && (
          isAdmin() ||
          isAssignedToProject() ||
          isCollaboratorInProject() ||
          isCreatorOfProject()
        );
    }

    function canWorkOnProjectId(projectId) {
      return hasProfile()
        && projectExists(projectId)
        && !isHistoricalProjectId(projectId)
        && (
          isAdmin() ||
          isAssignedToProjectId(projectId) ||
          isCollaboratorInProjectId(projectId) ||
          isCreatorOfProjectId(projectId)
        );
    }

    function validProjectStatus(status) {
      return status in [
        "Pendiente",
        "Por iniciar",
        "Asignado",
        "En planeación",
        "En proceso",
        "En espera de información",
        "Listo para revisión",
        "Correcciones solicitadas",
        "Aprobado para entrega",
        "Finalizado",
        "Terminado",
        "Cancelado",
        "Pausado",
        "Eliminado",
        "Archivado"
      ];
    }

    function validCollaboratorStatus(status) {
      return status in [
        "Por iniciar",
        "Asignado",
        "En planeación",
        "En proceso",
        "En espera de información",
        "Listo para revisión",
        "Pausado"
      ];
    }

    function hasValidProgress() {
      return request.resource.data.progress is number
        && request.resource.data.progress >= 0
        && request.resource.data.progress <= 100;
    }

    function hasValidStatus() {
      return request.resource.data.status is string
        && validProjectStatus(request.resource.data.status);
    }

    function hasValidCollaboratorStatus() {
      return request.resource.data.status is string
        && validCollaboratorStatus(request.resource.data.status);
    }

    function isHistoricalProject() {
      return resource.data.deleted == true
        || resource.data.archived == true
        || resource.data.status == "Eliminado"
        || resource.data.status == "Finalizado"
        || resource.data.status == "Terminado"
        || resource.data.status == "Cancelado"
        || resource.data.status == "Archivado";
    }

    function isHistoricalProjectId(projectId) {
      return projectExists(projectId)
        && (
          projectData(projectId).deleted == true
          || projectData(projectId).archived == true
          || projectData(projectId).status == "Eliminado"
          || projectData(projectId).status == "Finalizado"
          || projectData(projectId).status == "Terminado"
          || projectData(projectId).status == "Cancelado"
          || projectData(projectId).status == "Archivado"
        );
    }

    function collaboratorAllowedProjectUpdate() {
      return canWorkOnProject()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "reviewStatus",
          "adminReview",
          "reviewedAt",
          "reviewedByUid",
          "reviewedByName",
          "reviewedByEmail",
          "reviewComment"
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "progress",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",

          "closedAt",
          "closedByUid",
          "closedByName",

          "history",
          "formalHistory",
          "projectHistory",

          "comments",
          "projectComments",
          "lastCommentAt",
          "lastCommentByUid",
          "lastCommentByName",
          "lastCommentByEmail",

          "evidenceFiles",
          "evidences",
          "evidence",
          "files",
          "attachments",
          "attachedFiles",
          "projectFiles",
          "documents",
          "uploadedFiles",
          "lastEvidenceAt",
          "lastEvidenceByUid",
          "lastEvidenceByName",
          "lastEvidenceByEmail",

          "advances",
          "projectUpdates",
          "progressUpdates",
          "lastAdvanceAt",
          "lastAdvanceByUid",
          "lastAdvanceByName",
          "lastAdvanceByEmail",

          "activity",
          "recentActivity",
          "lastActivityAt",
          "lastActivityByUid",
          "lastActivityByName",
          "lastActivityByEmail",

          "reviewChecklist"
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "status"
          ])
          || hasValidCollaboratorStatus()
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "progress"
          ])
          || hasValidProgress()
        );
    }

    function adminValidProjectCreate() {
      return isAdmin()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.status is string
        && validProjectStatus(request.resource.data.status)
        && (
          request.resource.data.assignedToId is string ||
          request.resource.data.assignedToUid is string
        );
    }

    function adminValidProjectUpdate() {
      return isAdmin()
        && (
          !("title" in request.resource.data) ||
          (
            request.resource.data.title is string
            && request.resource.data.title.size() > 0
          )
        )
        && (
          !("status" in request.resource.data) ||
          hasValidStatus()
        )
        && (
          !("progress" in request.resource.data) ||
          hasValidProgress()
        );
    }

    function validProjectLogType(type) {
      return type in [
        "PROJECT_CREATED",
        "PROJECT_UPDATED",
        "STATUS_CHANGED",
        "PROGRESS_CHANGED",
        "EVIDENCE_UPLOADED",
        "EVIDENCE_REVIEWED",
        "COMMENT_ADDED",
        "ADVANCE_ADDED",
        "ADVANCE_COMMENT_ADDED",
        "REVIEW_REQUESTED",
        "CORRECTIONS_REQUESTED",
        "PROJECT_APPROVED",
        "PROJECT_FINISHED",
        "PROJECT_CANCELLED",
        "PROJECT_DELETED",
        "PROJECT_RESTORED",
        "INTERNAL_NOTE_UPDATED",
        "INTERNAL_NOTE_ADDED",
        "CHECKLIST_COMPLETED",
        "CHECKLIST_BLOCKED"
      ];
    }

    function validProjectLogCreate() {
      return hasProfile()
        && request.resource.data.projectId is string
        && projectExists(request.resource.data.projectId)
        && (
          isAdmin() ||
          canWorkOnProjectId(request.resource.data.projectId)
        )
        && (
          !("type" in request.resource.data)
          || validProjectLogType(request.resource.data.type)
        );
    }

    function validProjectUpdateCreate() {
      return hasProfile()
        && request.resource.data.projectId is string
        && projectExists(request.resource.data.projectId)
        && (
          isAdmin() ||
          canWorkOnProjectId(request.resource.data.projectId)
        );
    }

    function validEvidenceCreate() {
      return hasProfile()
        && request.resource.data.projectId is string
        && projectExists(request.resource.data.projectId)
        && canWorkOnProjectId(request.resource.data.projectId);
    }

    function validEvidenceUpdate() {
      return isAdmin()
        && resource.data.projectId is string
        && projectExists(resource.data.projectId);
    }

    function validNotificationCreate() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          "recipientId",
          "projectId",
          "tipo",
          "titulo",
          "mensaje",
          "actorId",
          "actorName",
          "read",
          "createdAt"
        ])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId.size() > 0
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.projectId is string
        && projectExists(request.resource.data.projectId)
        && canAccessProjectId(request.resource.data.projectId)
        && request.resource.data.tipo is string
        && request.resource.data.tipo.size() <= 60
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 140
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() <= 600
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() <= 120
        && request.resource.data.read == false
        && request.resource.data.createdAt is timestamp;
    }

    function validNotificationReadUpdate() {
      return hasProfile()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"])
        && request.resource.data.read == true
        && request.resource.data.readAt is timestamp;
    }

    function validInternalNoteCreate() {
      return isAdmin()
        && request.resource.data.projectId is string
        && request.resource.data.projectId.size() > 0
        && projectExists(request.resource.data.projectId)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.createdByUid == request.auth.uid;
    }

    function validBugReportPriority(priority) {
      return priority in ["baja", "media", "alta", "critica"];
    }

    function validBugReportStatus(status) {
      return status in [
        "nuevo",
        "en_revision",
        "en_proceso",
        "resuelto",
        "no_reproducible",
        "cerrado"
      ];
    }

    function canReadBugReport() {
      return isAdmin()
        || (
          hasProfile()
          && resource.data.reporterUid == request.auth.uid
        );
    }

    function validBugReportCreate() {
      return hasProfile()
        && request.resource.data.keys().hasOnly([
          "id",
          "title",
          "module",
          "description",
          "priority",
          "status",
          "steps",
          "evidenceFiles",
          "evidenceCount",
          "imageEvidenceCount",
          "videoEvidenceCount",
          "reporterUid",
          "reporterName",
          "reporterEmail",
          "adminComment",
          "adminHistory",
          "createdAt",
          "updatedAt",
          "lastActivityAt",
          "searchableText"
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.module is string
        && request.resource.data.module.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.priority is string
        && validBugReportPriority(request.resource.data.priority)
        && request.resource.data.status == "nuevo"
        && (!("steps" in request.resource.data) || request.resource.data.steps is string)
        && request.resource.data.evidenceFiles is list
        && (!("evidenceCount" in request.resource.data) || request.resource.data.evidenceCount is number)
        && (!("imageEvidenceCount" in request.resource.data) || request.resource.data.imageEvidenceCount is number)
        && (!("videoEvidenceCount" in request.resource.data) || request.resource.data.videoEvidenceCount is number)
        && (!("reporterName" in request.resource.data) || request.resource.data.reporterName is string)
        && (!("reporterEmail" in request.resource.data) || request.resource.data.reporterEmail is string)
        && (!("adminComment" in request.resource.data) || request.resource.data.adminComment == "")
        && (!("adminHistory" in request.resource.data) || request.resource.data.adminHistory is list)
        && (!("searchableText" in request.resource.data) || request.resource.data.searchableText is string)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.lastActivityAt is timestamp;
    }


    function validPrintProductData() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.category is string
        && request.resource.data.category in [
          "Libro",
          "Certificado",
          "Diploma",
          "Volante",
          "Vinil",
          "Hoja de canciones",
          "Hoja de actividades",
          "Material interno",
          "Otro"
        ]
        && request.resource.data.productionType is string
        && request.resource.data.productionType in [
          "Producto terminado",
          "Trabajo solicitado",
          "Documento generado",
          "Material interno"
        ]
        && request.resource.data.level is string
        && request.resource.data.level in [
          "No aplica",
          "A1",
          "A2",
          "B1",
          "B2",
          "C1",
          "Otro"
        ]
        && request.resource.data.unit is string
        && request.resource.data.unit in [
          "Pieza",
          "Libro",
          "Documento",
          "Paquete",
          "Hoja",
          "Metro",
          "Lote"
        ]
        && request.resource.data.minStock is number
        && request.resource.data.minStock >= 0
        && request.resource.data.idealStock is number
        && request.resource.data.idealStock >= 0
        && request.resource.data.idealStock >= request.resource.data.minStock
        && request.resource.data.requiresPrinting is bool
        && request.resource.data.requiresBinding is bool
        && request.resource.data.requiresCutting is bool
        && request.resource.data.requiresQualityCheck is bool
        && request.resource.data.requiresSignature is bool
        && request.resource.data.requiresValidationQr is bool
        && (!("productionRecipe" in request.resource.data) || request.resource.data.productionRecipe is list)
        && request.resource.data.active is bool
        && request.resource.data.notes is string;
    }

    function validPrintProductStatusUpdate() {
      return canAccessPrintshop()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "active",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && request.resource.data.active is bool
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedByEmail is string;
    }


    function validPrintFinishedInventoryData() {
      return request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && exists(/databases/$(database)/documents/printProducts/$(request.resource.data.productId))
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.category is string
        && request.resource.data.category in [
          "Libro",
          "Certificado",
          "Diploma",
          "Volante",
          "Vinil",
          "Hoja de canciones",
          "Hoja de actividades",
          "Material interno",
          "Otro"
        ]
        && request.resource.data.level is string
        && request.resource.data.level in [
          "No aplica",
          "A1",
          "A2",
          "B1",
          "B2",
          "C1",
          "Otro"
        ]
        && request.resource.data.unit is string
        && request.resource.data.unit in [
          "Pieza",
          "Libro",
          "Documento",
          "Paquete",
          "Hoja",
          "Metro",
          "Lote"
        ]
        && request.resource.data.currentStock is number
        && request.resource.data.currentStock >= 0
        && request.resource.data.minStock is number
        && request.resource.data.minStock >= 0
        && request.resource.data.idealStock is number
        && request.resource.data.idealStock >= 0
        && request.resource.data.idealStock >= request.resource.data.minStock
        && request.resource.data.active is bool
        && request.resource.data.notes is string;
    }

    function validPrintInventoryMovementData() {
      return request.resource.data.inventoryId is string
        && request.resource.data.inventoryId.size() > 0
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.type is string
        && request.resource.data.type in [
          "Entrada",
          "Salida"
        ]
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.previousStock is number
        && request.resource.data.previousStock >= 0
        && request.resource.data.newStock is number
        && request.resource.data.newStock >= 0
        && request.resource.data.notes is string
        && request.resource.data.createdByUid == request.auth.uid;
    }



    function validPrintSupplyCategory(category) {
      return category in [
        "Papel para libros",
        "Papel para portadas",
        "Papel para certificados",
        "Papel para diplomas",
        "Vinil",
        "Laminado",
        "Pegamento / encuadernado",
        "Tintas / tóner",
        "Empaque",
        "Herramientas menores",
        "Otro"
      ];
    }

    function validPrintSupplyMovementType(type) {
      return type in [
        "Entrada",
        "Salida",
        "Ajuste",
        "Merma",
        "Devolución"
      ];
    }

    function validPrintSupplyItemData() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.category is string
        && validPrintSupplyCategory(request.resource.data.category)
        && request.resource.data.stockUnit is string
        && request.resource.data.stockUnit.size() > 0
        && request.resource.data.currentStock is number
        && request.resource.data.currentStock >= 0
        && request.resource.data.minStock is number
        && request.resource.data.minStock >= 0
        && request.resource.data.idealStock is number
        && request.resource.data.idealStock >= 0
        && request.resource.data.idealStock >= request.resource.data.minStock
        && request.resource.data.contentQuantity is number
        && request.resource.data.contentQuantity >= 0
        && request.resource.data.contentUnit is string
        && request.resource.data.color is string
        && request.resource.data.size is string
        && request.resource.data.weight is string
        && request.resource.data.supplier is string
        && request.resource.data.approximateCost is number
        && request.resource.data.approximateCost >= 0
        && request.resource.data.barcode is string
        && request.resource.data.expectedYield is number
        && request.resource.data.expectedYield >= 0
        && request.resource.data.expectedYieldUnit is string
        && request.resource.data.active is bool
        && request.resource.data.notes is string;
    }

    function validSupplyStockMovementUpdate() {
      return canAccessPrintshop()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "currentStock",
          "lastMovementAt",
          "lastMovementType",
          "lastMovementReason",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && request.resource.data.currentStock is number
        && request.resource.data.currentStock >= 0
        && request.resource.data.lastMovementType is string
        && validPrintSupplyMovementType(request.resource.data.lastMovementType)
        && request.resource.data.lastMovementReason is string
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function printSupplyItemPath(supplyId) {
      return /databases/$(database)/documents/printSupplyItems/$(supplyId);
    }

    function printSupplyItemExists(supplyId) {
      return supplyId is string
        && supplyId.size() > 0
        && exists(printSupplyItemPath(supplyId));
    }

    function validPrintSupplyMovementData() {
      return request.resource.data.supplyId is string
        && printSupplyItemExists(request.resource.data.supplyId)
        && request.resource.data.supplyName is string
        && request.resource.data.supplyName.size() > 0
        && request.resource.data.category is string
        && request.resource.data.type is string
        && validPrintSupplyMovementType(request.resource.data.type)
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.stockUnit is string
        && request.resource.data.stockUnit.size() > 0
        && request.resource.data.contentQuantity is number
        && request.resource.data.contentQuantity >= 0
        && request.resource.data.contentUnit is string
        && request.resource.data.expectedYield is number
        && request.resource.data.expectedYield >= 0
        && request.resource.data.expectedYieldUnit is string
        && request.resource.data.previousStock is number
        && request.resource.data.previousStock >= 0
        && request.resource.data.newStock is number
        && request.resource.data.newStock >= 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.relatedType is string
        && request.resource.data.relatedId is string
        && request.resource.data.relatedFolio is string
        && request.resource.data.wasteQuantity is number
        && request.resource.data.wasteQuantity >= 0
        && request.resource.data.notes is string
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByEmail is string;
    }


    function printBatchPath(batchId) {
      return /databases/$(database)/documents/printProductionBatches/$(batchId);
    }

    function printBatchExists(batchId) {
      return exists(printBatchPath(batchId));
    }

    function printBatchData(batchId) {
      return get(printBatchPath(batchId)).data;
    }

    function isPrintBatchResponsible() {
      return hasProfile()
        && resource.data.responsibleUid is string
        && resource.data.responsibleUid == request.auth.uid;
    }

    function isPrintBatchAuditor() {
      return hasProfile()
        && resource.data.auditorUid is string
        && resource.data.auditorUid == request.auth.uid;
    }

    function isPrintBatchResponsibleId(batchId) {
      return hasProfile()
        && printBatchExists(batchId)
        && printBatchData(batchId).responsibleUid is string
        && printBatchData(batchId).responsibleUid == request.auth.uid;
    }

    function isAllowedResponsibleBatchStatus(status) {
      return status in [
        "En impresión",
        "En encuadernado",
        "En revisión de calidad"
      ];
    }

    function isAllowedAuditorBatchStatus(status) {
      return status in [
        "En revisión de calidad",
        "Aprobado",
        "Cancelado"
      ];
    }

    function responsibleProductionBatchUpdate() {
      return isPrintBatchResponsible()
        && validPrintProductionBatchData()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "producedQuantity",
          "notes",
          "students",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && isAllowedResponsibleBatchStatus(request.resource.data.status)
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function auditorQualityBatchUpdate() {
      return isPrintBatchAuditor()
        && validPrintProductionBatchData()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "approvedQuantity",
          "rejectedQuantity",
          "qualityChecklist",
          "qualityStatus",
          "qualityNotes",
          "qualityCompleted",
          "qualityReviewedAt",
          "qualityReviewedByUid",
          "qualityReviewedByName",
          "qualityReviewedByEmail",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && isAllowedAuditorBatchStatus(request.resource.data.status)
        && (
          request.resource.data.status != "Aprobado"
          || request.resource.data.qualityCompleted == true
        )
        && (
          request.resource.data.qualityCompleted == false
          || request.resource.data.qualityReviewedByUid == request.auth.uid
        )
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function responsibleInventoryBatchApplyUpdate() {
      return isPrintBatchResponsible()
        && validPrintProductionBatchData()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "inventoryApplied",
          "inventoryId",
          "inventoryMovementId",
          "inventoryAppliedAt",
          "inventoryAppliedByUid",
          "inventoryAppliedByName",
          "inventoryAppliedByEmail",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && resource.data.inventoryApplied != true
        && resource.data.qualityCompleted == true
        && resource.data.qualityStatus in [
          "Aprobado",
          "Aprobado con observaciones"
        ]
        && request.resource.data.status == "Ingresado a inventario"
        && request.resource.data.inventoryApplied == true
        && request.resource.data.inventoryAppliedByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function responsibleInventoryEntryUpdate() {
      return hasProfile()
        && validPrintFinishedInventoryData()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "currentStock",
          "lastBatchId",
          "lastBatchFolio",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && request.resource.data.lastBatchId is string
        && printBatchExists(request.resource.data.lastBatchId)
        && isPrintBatchResponsibleId(request.resource.data.lastBatchId)
        && printBatchData(request.resource.data.lastBatchId).productId == resource.data.productId
        && printBatchData(request.resource.data.lastBatchId).inventoryApplied != true
        && printBatchData(request.resource.data.lastBatchId).qualityCompleted == true
        && printBatchData(request.resource.data.lastBatchId).qualityStatus in [
          "Aprobado",
          "Aprobado con observaciones"
        ]
        && request.resource.data.currentStock == resource.data.currentStock + printBatchData(request.resource.data.lastBatchId).approvedQuantity
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function responsibleBatchInventoryMovementCreate() {
      return hasProfile()
        && request.resource.data.batchId is string
        && printBatchExists(request.resource.data.batchId)
        && isPrintBatchResponsibleId(request.resource.data.batchId)
        && printBatchData(request.resource.data.batchId).productId == request.resource.data.productId
        && printBatchData(request.resource.data.batchId).inventoryApplied != true
        && printBatchData(request.resource.data.batchId).qualityCompleted == true
        && printBatchData(request.resource.data.batchId).qualityStatus in [
          "Aprobado",
          "Aprobado con observaciones"
        ]
        && request.resource.data.type == "Entrada"
        && request.resource.data.quantity == printBatchData(request.resource.data.batchId).approvedQuantity
        && request.resource.data.reason == "Lote de producción cerrado"
        && request.resource.data.createdByUid == request.auth.uid;
    }

    function validPrintBatchStatus(status) {
      return status in [
        "Planeado",
        "En impresión",
        "En encuadernado",
        "En revisión de calidad",
        "Aprobado",
        "Ingresado a inventario",
        "Cerrado",
        "Cancelado"
      ];
    }

    function validPrintQualityStatus(status) {
      return status in [
        "Pendiente",
        "En revisión",
        "Aprobado",
        "Aprobado con observaciones",
        "Rechazado"
      ];
    }

    function validPrintProductionBatchData() {
      return request.resource.data.folio is string
        && request.resource.data.folio.size() > 0
        && request.resource.data.productId is string
        && (
          (
            request.resource.data.productId.size() > 0
            && exists(/databases/$(database)/documents/printProducts/$(request.resource.data.productId))
          )
          || (
            request.resource.data.category in ["Certificado", "Diploma"]
            && request.resource.data.productName is string
            && request.resource.data.productName.size() > 0
          )
        )
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.category is string
        && request.resource.data.category in [
          "Libro",
          "Certificado",
          "Diploma",
          "Volante",
          "Vinil",
          "Hoja de canciones",
          "Hoja de actividades",
          "Material interno",
          "Otro"
        ]
        && request.resource.data.level is string
        && request.resource.data.level in [
          "No aplica",
          "A1",
          "A2",
          "B1",
          "B2",
          "C1",
          "Otro"
        ]
        && request.resource.data.unit is string
        && request.resource.data.unit in [
          "Pieza",
          "Libro",
          "Documento",
          "Paquete",
          "Hoja",
          "Metro",
          "Lote"
        ]
        && request.resource.data.plannedQuantity is number
        && request.resource.data.plannedQuantity > 0
        && request.resource.data.producedQuantity is number
        && request.resource.data.producedQuantity >= 0
        && request.resource.data.approvedQuantity is number
        && request.resource.data.approvedQuantity >= 0
        && request.resource.data.rejectedQuantity is number
        && request.resource.data.rejectedQuantity >= 0
        && request.resource.data.approvedQuantity + request.resource.data.rejectedQuantity <= request.resource.data.producedQuantity
        && request.resource.data.status is string
        && validPrintBatchStatus(request.resource.data.status)
        && request.resource.data.responsible is string
        && request.resource.data.responsibleUid is string
        && request.resource.data.responsibleUid.size() > 0
        && request.resource.data.responsibleName is string
        && request.resource.data.responsibleName.size() > 0
        && request.resource.data.responsibleEmail is string
        && request.resource.data.auditorUid is string
        && request.resource.data.auditorUid.size() > 0
        && request.resource.data.auditorName is string
        && request.resource.data.auditorName.size() > 0
        && request.resource.data.auditorEmail is string
        && request.resource.data.responsibleUid != request.resource.data.auditorUid
        && request.resource.data.startDate is string
        && request.resource.data.dueDate is string
        && request.resource.data.notes is string
        && request.resource.data.qualityChecklist is list
        && request.resource.data.qualityChecklist.size() == 10
        && request.resource.data.qualityStatus is string
        && validPrintQualityStatus(request.resource.data.qualityStatus)
        && request.resource.data.qualityNotes is string
        && request.resource.data.qualityCompleted is bool
        && (
          request.resource.data.status in [
            "Planeado",
            "En impresión",
            "En encuadernado",
            "En revisión de calidad",
            "Cancelado"
          ]
          || request.resource.data.qualityCompleted == true
        )
        && (
          request.resource.data.qualityCompleted == false
          || request.resource.data.qualityStatus in [
            "Aprobado",
            "Aprobado con observaciones"
          ]
        )
        && (
          !("qualityReviewedByUid" in request.resource.data)
          || request.resource.data.qualityReviewedByUid is string
        )
        && (
          !("qualityReviewedByName" in request.resource.data)
          || request.resource.data.qualityReviewedByName is string
        )
        && (
          !("qualityReviewedByEmail" in request.resource.data)
          || request.resource.data.qualityReviewedByEmail is string
        )
        && request.resource.data.inventoryApplied is bool
        && (
          !("inventoryId" in request.resource.data) ||
          request.resource.data.inventoryId is string
        )
        && (
          !("inventoryMovementId" in request.resource.data) ||
          request.resource.data.inventoryMovementId is string
        );
    }



    function validCertificateSignerType(type) {
      return type in [
        "Principal",
        "Teacher"
      ];
    }

    function validCertificateSignerData() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.role is string
        && request.resource.data.role.size() > 0
        && request.resource.data.type is string
        && validCertificateSignerType(request.resource.data.type)
        && request.resource.data.campus is string
        && request.resource.data.campus.size() > 0
        && request.resource.data.active is bool
        && request.resource.data.notes is string
        && request.resource.data.signatureUrl is string
        && request.resource.data.signatureUrl.size() > 0
        && (
          !("signatureDataUrl" in request.resource.data)
          || request.resource.data.signatureDataUrl is string
        )
        && request.resource.data.storagePath is string
        && (
          !("naturalWidth" in request.resource.data)
          || request.resource.data.naturalWidth is number
        )
        && (
          !("naturalHeight" in request.resource.data)
          || request.resource.data.naturalHeight is number
        )
        && (
          !("aspectRatio" in request.resource.data)
          || request.resource.data.aspectRatio is number
        )
        && (
          !("normalizedAspectRatio" in request.resource.data)
          || request.resource.data.normalizedAspectRatio is number
        );
    }

    function validCertificateTemplateAudience(audience) {
      return audience in [
        "Adultos",
        "Kids",
        "Otro"
      ];
    }

    function validCertificateTemplateType(type) {
      return type in [
        "Certificado",
        "Diploma"
      ];
    }

    function validCertificateTemplateData() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.level is string
        && request.resource.data.level in [
          "No aplica",
          "A1",
          "A2",
          "B1",
          "B2",
          "C1",
          "Otro"
        ]
        && request.resource.data.programName is string
        && request.resource.data.programName.size() > 0
        && request.resource.data.audience is string
        && validCertificateTemplateAudience(request.resource.data.audience)
        && request.resource.data.certificateType is string
        && validCertificateTemplateType(request.resource.data.certificateType)
        && request.resource.data.bodyText is string
        && (
          !("bodySegments" in request.resource.data)
          || request.resource.data.bodySegments is list
        )
        && (
          !("customTexts" in request.resource.data)
          || request.resource.data.customTexts is list
        )
        && (
          !("customImages" in request.resource.data)
          || request.resource.data.customImages is list
        )
        && request.resource.data.active is bool
        && request.resource.data.notes is string
        && request.resource.data.templateImageUrl is string
        && request.resource.data.templateImageUrl.size() > 0
        && request.resource.data.templateImageDataUrl is string
        && request.resource.data.templateImageDataUrl.size() > 0
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.size() > 0
        && request.resource.data.positions is map;
    }

    function validCredentialTemplateData() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && (
          !("orientation" in request.resource.data)
          || (
            request.resource.data.orientation is string
            && request.resource.data.orientation in [
              "horizontal",
              "vertical"
            ]
          )
        )
        && request.resource.data.active is bool
        && request.resource.data.notes is string
        && request.resource.data.frontImageUrl is string
        && request.resource.data.frontImageUrl.size() > 0
        && request.resource.data.frontImageDataUrl is string
        && request.resource.data.frontImageDataUrl.size() > 0
        && request.resource.data.frontStoragePath is string
        && request.resource.data.frontStoragePath.size() > 0
        && request.resource.data.backImageUrl is string
        && request.resource.data.backImageDataUrl is string
        && request.resource.data.backStoragePath is string
        && request.resource.data.positions is map
        && (!("customTexts" in request.resource.data) || request.resource.data.customTexts is list)
        && (!("customImages" in request.resource.data) || request.resource.data.customImages is list);
    }

    function validPrintRequestStatus(status) {
      return status in [
        "Solicitud recibida",
        "Datos incompletos",
        "En revisión",
        "Aprobada",
        "En producción",
        "En revisión de calidad",
        "Lista para entrega",
        "Entregada",
        "Cancelada"
      ];
    }

    function validPrintRequestType(type) {
      return type in [
        "Certificado",
        "Diploma",
        "Volante",
        "Vinil",
        "Hoja de canciones",
        "Hoja de actividades",
        "Material interno",
        "Otro"
      ];
    }

    function validPrintRequestPriority(priority) {
      return priority in [
        "Baja",
        "Normal",
        "Alta",
        "Urgente"
      ];
    }

    function validPrintRequestDeliveryType(deliveryType) {
      return deliveryType in [
        "Impresa",
        "Digital",
        "Ambas"
      ];
    }

    function validPrintRequestLevel(level) {
      return level in [
        "No aplica",
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "Smile 1",
        "Smile 2",
        "Smile 3",
        "Smile 4",
        "Smile 5",
        "Mega Flash",
        "Otro"
      ];
    }

    function isCertificateOrDiplomaRequest() {
      return request.resource.data.requestType in [
        "Certificado",
        "Diploma"
      ];
    }

    function validPrintRequestData() {
      return request.resource.data.folio is string
        && request.resource.data.folio.size() > 0
        && request.resource.data.productId is string
        && (
          (
            request.resource.data.productId.size() > 0
            && exists(/databases/$(database)/documents/printProducts/$(request.resource.data.productId))
          )
          || (
            request.resource.data.requestType in ["Certificado", "Diploma"]
            && request.resource.data.productName is string
            && request.resource.data.productName.size() > 0
          )
        )
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.requestType is string
        && validPrintRequestType(request.resource.data.requestType)
        && request.resource.data.requesterName is string
        && request.resource.data.requesterName.size() > 0
        && (!("requesterId" in request.resource.data) || request.resource.data.requesterId is string)
        && request.resource.data.requesterArea is string
        && request.resource.data.requesterArea.size() > 0
        && request.resource.data.campus is string
        && request.resource.data.campus.size() > 0
        && request.resource.data.assignedUserId is string
        && request.resource.data.assignedUserId.size() > 0
        && request.resource.data.assignedUserName is string
        && request.resource.data.assignedUserName.size() > 0
        && request.resource.data.supportUserId is string
        && request.resource.data.supportUserId.size() > 0
        && request.resource.data.supportUserName is string
        && request.resource.data.supportUserName.size() > 0
        && request.resource.data.responsibleUid is string
        && request.resource.data.responsibleName is string
        && request.resource.data.responsibleEmail is string
        && (!("collaboratorUid" in request.resource.data) || request.resource.data.collaboratorUid is string)
        && (!("collaboratorName" in request.resource.data) || request.resource.data.collaboratorName is string)
        && (!("collaboratorEmail" in request.resource.data) || request.resource.data.collaboratorEmail is string)
        && request.resource.data.priority is string
        && validPrintRequestPriority(request.resource.data.priority)
        && request.resource.data.requestedQuantity is number
        && (
          request.resource.data.requestedQuantity > 0
          || (
            isCertificateOrDiplomaRequest()
            && request.resource.data.students is list
            && request.resource.data.students.size() == 0
            && request.resource.data.printedQuantity == 0
            && request.resource.data.digitalQuantity == 0
          )
        )
        && request.resource.data.deliveredQuantity is number
        && request.resource.data.deliveredQuantity >= 0
        && request.resource.data.deliveredQuantity <= request.resource.data.requestedQuantity
        && request.resource.data.deliveryType is string
        && validPrintRequestDeliveryType(request.resource.data.deliveryType)
        && request.resource.data.status is string
        && validPrintRequestStatus(request.resource.data.status)
        && request.resource.data.requestDate is string
        && request.resource.data.dueDate is string
        && (
          !("certificateIssueDate" in request.resource.data)
          || request.resource.data.certificateIssueDate is string
        )
        && (!("certificateTemplateId" in request.resource.data) || request.resource.data.certificateTemplateId is string)
        && (!("certificateTemplateName" in request.resource.data) || request.resource.data.certificateTemplateName is string)
        && (!("certificateTemplateLevel" in request.resource.data) || request.resource.data.certificateTemplateLevel is string)
        && (!("certificateTemplateProgramName" in request.resource.data) || request.resource.data.certificateTemplateProgramName is string)
        && (!("certificateTemplateAudience" in request.resource.data) || request.resource.data.certificateTemplateAudience is string)
        && (!("certificateTemplateBodyText" in request.resource.data) || request.resource.data.certificateTemplateBodyText is string)
        && (!("certificateTemplateBodySegments" in request.resource.data) || request.resource.data.certificateTemplateBodySegments is list)
        && (!("certificateTemplateCustomTexts" in request.resource.data) || request.resource.data.certificateTemplateCustomTexts is list)
        && (!("certificateTemplateCustomImages" in request.resource.data) || request.resource.data.certificateTemplateCustomImages is list)
        && (!("certificateTemplateImageUrl" in request.resource.data) || request.resource.data.certificateTemplateImageUrl is string)
        && (!("certificateTemplateImageDataUrl" in request.resource.data) || request.resource.data.certificateTemplateImageDataUrl is string)
        && (!("certificateTemplateStoragePath" in request.resource.data) || request.resource.data.certificateTemplateStoragePath is string)
        && (!("certificateTemplatePositions" in request.resource.data) || request.resource.data.certificateTemplatePositions is map)
        && request.resource.data.notes is string
        && request.resource.data.level is string
        && validPrintRequestLevel(request.resource.data.level)
        && request.resource.data.group is string
        && request.resource.data.teacherName is string
        && request.resource.data.schedule is string
        && request.resource.data.printedQuantity is number
        && request.resource.data.printedQuantity >= 0
        && request.resource.data.digitalQuantity is number
        && request.resource.data.digitalQuantity >= 0
        && (!("principalSignerId" in request.resource.data) || request.resource.data.principalSignerId is string)
        && (!("principalSignerName" in request.resource.data) || request.resource.data.principalSignerName is string)
        && (!("principalSignerRole" in request.resource.data) || request.resource.data.principalSignerRole is string)
        && (!("principalSignatureUrl" in request.resource.data) || request.resource.data.principalSignatureUrl is string)
        && (!("principalSignatureDataUrl" in request.resource.data) || request.resource.data.principalSignatureDataUrl is string)
        && (!("teacherSignerId" in request.resource.data) || request.resource.data.teacherSignerId is string)
        && (!("teacherSignerName" in request.resource.data) || request.resource.data.teacherSignerName is string)
        && (!("teacherSignerRole" in request.resource.data) || request.resource.data.teacherSignerRole is string)
        && (!("teacherSignatureUrl" in request.resource.data) || request.resource.data.teacherSignatureUrl is string)
        && (!("teacherSignatureDataUrl" in request.resource.data) || request.resource.data.teacherSignatureDataUrl is string)
        && request.resource.data.students is list
        && (
          !isCertificateOrDiplomaRequest()
          || (
            request.resource.data.group.size() > 0
            && request.resource.data.teacherName.size() > 0
            && request.resource.data.schedule.size() > 0
            && (
              !(("principalSignerId" in request.resource.data) || ("teacherSignerId" in request.resource.data))
              || (
                request.resource.data.principalSignerId.size() > 0
                && request.resource.data.principalSignerName.size() > 0
                && request.resource.data.principalSignerRole.size() > 0
                && request.resource.data.principalSignatureUrl.size() > 0
                && request.resource.data.teacherSignerId.size() > 0
                && request.resource.data.teacherSignerName.size() > 0
                && request.resource.data.teacherSignerRole.size() > 0
                && request.resource.data.teacherSignatureUrl.size() > 0
              )
            )
            && request.resource.data.printedQuantity + request.resource.data.digitalQuantity == request.resource.data.requestedQuantity
          )
        );
    }

    function isPrintRequestAssignedData(printRequest) {
      return hasProfile()
        && (
          ("assignedUserId" in printRequest && printRequest.assignedUserId is string && printRequest.assignedUserId == request.auth.uid) ||
          ("responsibleUid" in printRequest && printRequest.responsibleUid is string && printRequest.responsibleUid == request.auth.uid) ||
          ("assignedToUid" in printRequest && printRequest.assignedToUid is string && printRequest.assignedToUid == request.auth.uid) ||
          ("productionAssigneeUid" in printRequest && printRequest.productionAssigneeUid is string && printRequest.productionAssigneeUid == request.auth.uid) ||
          ("assignedCollaboratorUid" in printRequest && printRequest.assignedCollaboratorUid is string && printRequest.assignedCollaboratorUid == request.auth.uid) ||
          ("responsibleId" in printRequest && printRequest.responsibleId is string && printRequest.responsibleId == request.auth.uid)
        );
    }

    function isPrintRequestSupportData(printRequest) {
      return hasProfile()
        && (
          ("supportUserId" in printRequest && printRequest.supportUserId is string && printRequest.supportUserId == request.auth.uid) ||
          ("collaboratorUid" in printRequest && printRequest.collaboratorUid is string && printRequest.collaboratorUid == request.auth.uid) ||
          ("collaboratorId" in printRequest && printRequest.collaboratorId is string && printRequest.collaboratorId == request.auth.uid) ||
          ("supportCollaboratorUid" in printRequest && printRequest.supportCollaboratorUid is string && printRequest.supportCollaboratorUid == request.auth.uid) ||
          ("productionSupportUid" in printRequest && printRequest.productionSupportUid is string && printRequest.productionSupportUid == request.auth.uid) ||
          ("supportUid" in printRequest && printRequest.supportUid is string && printRequest.supportUid == request.auth.uid) ||
          ("supportUserIds" in printRequest && printRequest.supportUserIds is list && request.auth.uid in printRequest.supportUserIds) ||
          ("supportCollaboratorIds" in printRequest && printRequest.supportCollaboratorIds is list && request.auth.uid in printRequest.supportCollaboratorIds) ||
          ("supportCollaborators" in printRequest && printRequest.supportCollaborators is list && request.auth.uid in printRequest.supportCollaborators) ||
          ("collaboratorUids" in printRequest && printRequest.collaboratorUids is list && request.auth.uid in printRequest.collaboratorUids) ||
          ("collaboratorIds" in printRequest && printRequest.collaboratorIds is list && request.auth.uid in printRequest.collaboratorIds)
        );
    }

    function isPrintRequestMemberData(printRequest) {
      return isPrintRequestAssignedData(printRequest) || isPrintRequestSupportData(printRequest);
    }

    function canManagePrintRequestData(printRequest) {
      return isAdmin() || isPrintRequestMemberData(printRequest);
    }

    function isPrintRequestResponsible() {
      return isPrintRequestAssignedData(resource.data);
    }

    function isPrintRequestCollaborator() {
      return isPrintRequestSupportData(resource.data);
    }

    function validPrintRequestAutoAssignUpdate() {
      return isAdmin()
        && resource.data.publicRequestSource == "certificate-public-form"
        && resource.data.requestType == "Certificado"
        && resource.data.responsibleUid == ""
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "responsibleUid",
          "responsibleName",
          "responsibleEmail",
          "defaultResponsibleName",
          "responsibleAutoAssigned",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && request.resource.data.responsibleUid is string
        && request.resource.data.responsibleUid.size() > 0
        && request.resource.data.responsibleName is string
        && request.resource.data.responsibleName.size() > 0
        && request.resource.data.responsibleEmail is string
        && request.resource.data.defaultResponsibleName is string
        && request.resource.data.responsibleAutoAssigned == true
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedByEmail is string;
    }

    function responsiblePrintRequestUpdate() {
      return canManagePrintRequestData(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "statusLabel",
          "requestedQuantity",
          "deliveredQuantity",
          "deliveryType",
          "notes",
          "students",
          "dueDate",
          "certificateIssueDate",
          "certificateTemplateId",
          "certificateTemplateName",
          "certificateTemplateLevel",
          "certificateTemplateProgramName",
          "certificateTemplateAudience",
          "certificateTemplateBodyText",
          "certificateTemplateBodySegments",
          "certificateTemplateCustomTexts",
          "certificateTemplateCustomImages",
          "certificateTemplateImageUrl",
          "certificateTemplateImageDataUrl",
          "certificateTemplateStoragePath",
          "certificateTemplatePositions",
          "level",
          "group",
          "teacherName",
          "schedule",
          "printedQuantity",
          "digitalQuantity",
          "principalSignerId",
          "principalSignerName",
          "principalSignerRole",
          "principalSignatureUrl",
          "principalSignatureDataUrl",
          "teacherSignerId",
          "teacherSignerName",
          "teacherSignerRole",
          "teacherSignatureUrl",
          "teacherSignatureDataUrl",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && request.resource.data.status in [
          "Solicitud recibida",
          "Datos incompletos",
          "En revisión",
          "Aprobada",
          "En producción",
          "En revisión de calidad",
          "Lista para entrega",
          "Entregada",
          "Cancelada"
        ]
        && (!("statusLabel" in request.resource.data) || request.resource.data.statusLabel == request.resource.data.status)
        && request.resource.data.requestedQuantity is number
        && request.resource.data.requestedQuantity >= 0
        && request.resource.data.deliveredQuantity is number
        && request.resource.data.deliveredQuantity >= 0
        && request.resource.data.deliveredQuantity <= request.resource.data.requestedQuantity
        && request.resource.data.deliveryType in ["Impresa", "Digital", "Ambas"]
        && request.resource.data.printedQuantity is number
        && request.resource.data.printedQuantity >= 0
        && request.resource.data.digitalQuantity is number
        && request.resource.data.digitalQuantity >= 0
        && request.resource.data.students is list
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function validPrintSupplyStatusUpdate() {
      return canAccessPrintshop()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "active",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && request.resource.data.active is bool
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedByEmail is string;
    }

    function printshopCertificateStudentsUpdate() {
      return canManagePrintRequestData(resource.data)
        && resource.data.requestType in ["Certificado", "Diploma"]
        && request.resource.data.requestType == resource.data.requestType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "statusLabel",
          "requestedQuantity",
          "printedQuantity",
          "digitalQuantity",
          "deliveryType",
          "students",
          "productionStartedAt",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail"
        ])
        && request.resource.data.status in [
          "Solicitud recibida",
          "Datos incompletos",
          "En revisión",
          "Aprobada",
          "En producción",
          "En revisión de calidad",
          "Lista para entrega",
          "Entregada",
          "Cancelada"
        ]
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function printRequestPath(requestId) {
      return /databases/$(database)/documents/printRequests/$(requestId);
    }

    function printRequestExists(requestId) {
      return requestId is string
        && requestId.size() > 0
        && exists(printRequestPath(requestId));
    }

    function printRequestData(requestId) {
      return get(printRequestPath(requestId)).data;
    }

    function canManageGeneratedCertificateRequest(requestId) {
      return hasProfile()
        && requestId is string
        && requestId.size() > 0
        && printRequestExists(requestId)
        && (
          canManagePrintRequestData(printRequestData(requestId))
        );
    }

    function isStandaloneGeneratedCertificateData() {
      return request.resource.data.requestId == ""
        && request.resource.data.generationMode == "individual";
    }

    function isStandaloneGeneratedCertificateResource() {
      return resource.data.requestId == ""
        && resource.data.generationMode == "individual";
    }

    function canManageGeneratedCertificateData() {
      return canManageGeneratedCertificateRequest(request.resource.data.requestId)
        || (
          canAccessPrintshop()
          && isStandaloneGeneratedCertificateData()
        );
    }

    function canManageGeneratedCertificateResource() {
      return canManageGeneratedCertificateRequest(resource.data.requestId)
        || (
          canAccessPrintshop()
          && isStandaloneGeneratedCertificateResource()
        );
    }

    function validGeneratedCertificateRequestReference() {
      return (
          request.resource.data.requestId.size() > 0
          && printRequestExists(request.resource.data.requestId)
        )
        || isStandaloneGeneratedCertificateData();
    }

    function validGeneratedCertificateStatus(status) {
      return status in [
        "Generado",
        "Entregado",
        "Cancelado"
      ];
    }

    function validGeneratedCertificateData() {
      return request.resource.data.folio is string
        && request.resource.data.folio.size() > 0
        && request.resource.data.validationCode is string
        && request.resource.data.validationCode.size() > 0
        && request.resource.data.validationUrl is string
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() > 0
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentDeliveryType is string
        && request.resource.data.requestId is string
        && validGeneratedCertificateRequestReference()
        && request.resource.data.requestFolio is string
        && (!("generationMode" in request.resource.data) || request.resource.data.generationMode in ["request", "individual"])
        && request.resource.data.requestType is string
        && request.resource.data.productId is string
        && request.resource.data.productName is string
        && request.resource.data.responsibleUid is string
        && request.resource.data.responsibleName is string
        && request.resource.data.responsibleEmail is string
        && request.resource.data.level is string
        && request.resource.data.programName is string
        && request.resource.data.templateId is string
        && request.resource.data.templateName is string
        && request.resource.data.issueDate is string
        && request.resource.data.principalName is string
        && request.resource.data.teacherName is string
        && request.resource.data.status is string
        && validGeneratedCertificateStatus(request.resource.data.status)
        && request.resource.data.pdfFileName is string
        && (!("pdfUrl" in request.resource.data) || request.resource.data.pdfUrl is string)
        && (!("pdfStoragePath" in request.resource.data) || request.resource.data.pdfStoragePath is string)
        && request.resource.data.generatedByUid is string
        && request.resource.data.generatedByName is string
        && request.resource.data.generatedByEmail is string
        && (!("pdfSavedAt" in request.resource.data) || request.resource.data.pdfSavedAt is timestamp)
        && request.resource.data.updatedByUid is string
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedByEmail is string
        && (!("deliveredByUid" in request.resource.data) || request.resource.data.deliveredByUid is string)
        && (!("deliveredByName" in request.resource.data) || request.resource.data.deliveredByName is string)
        && (!("deliveredByEmail" in request.resource.data) || request.resource.data.deliveredByEmail is string)
        && (!("cancelledByUid" in request.resource.data) || request.resource.data.cancelledByUid is string)
        && (!("cancelledByName" in request.resource.data) || request.resource.data.cancelledByName is string)
        && (!("cancelledByEmail" in request.resource.data) || request.resource.data.cancelledByEmail is string);
    }

    function validPublicCertificateValidationData() {
      return request.resource.data.validationCode is string
        && request.resource.data.validationCode.size() > 0
        && request.resource.data.folio is string
        && request.resource.data.folio.size() > 0
        && request.resource.data.validationUrl is string
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.level is string
        && request.resource.data.programName is string
        && request.resource.data.requestType is string
        && request.resource.data.productName is string
        && request.resource.data.templateName is string
        && request.resource.data.issueDate is string
        && (!("issueYear" in request.resource.data) || request.resource.data.issueYear is string)
        && request.resource.data.campus is string
        && request.resource.data.teacherName is string
        && request.resource.data.status is string
        && validGeneratedCertificateStatus(request.resource.data.status)
        && request.resource.data.institution is string
        && request.resource.data.requestId is string
        && (
          (
            request.resource.data.requestId.size() > 0
            && printRequestExists(request.resource.data.requestId)
          )
          || (
            request.resource.data.requestId == ""
            && request.resource.data.generationMode == "individual"
          )
        )
        && (!("generationMode" in request.resource.data) || request.resource.data.generationMode in ["request", "individual"]);
    }

    function validGeneratedCredentialData() {
      return request.resource.data.folio is string
        && request.resource.data.folio.size() > 0
        && request.resource.data.validationCode is string
        && request.resource.data.validationCode.size() > 0
        && request.resource.data.validationUrl is string
        && request.resource.data.qrDataUrl is string
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.department is string
        && request.resource.data.department.size() > 0
        && request.resource.data.position is string
        && request.resource.data.employeeId is string
        && request.resource.data.templateId is string
        && request.resource.data.templateId.size() > 0
        && exists(/databases/$(database)/documents/credentialTemplates/$(request.resource.data.templateId))
        && request.resource.data.templateName is string
        && request.resource.data.issueDate is string
        && request.resource.data.expiryDate is string
        && request.resource.data.status is string
        && validGeneratedCertificateStatus(request.resource.data.status)
        && request.resource.data.notes is string
        && request.resource.data.generatedByUid is string
        && request.resource.data.generatedByName is string
        && request.resource.data.generatedByEmail is string
        && request.resource.data.updatedByUid is string
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedByEmail is string;
    }

    function validPublicCredentialValidationData() {
      return request.resource.data.validationCode is string
        && request.resource.data.validationCode.size() > 0
        && request.resource.data.folio is string
        && request.resource.data.folio.size() > 0
        && request.resource.data.validationUrl is string
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.department is string
        && request.resource.data.department.size() > 0
        && request.resource.data.position is string
        && request.resource.data.employeeId is string
        && request.resource.data.templateName is string
        && request.resource.data.issueDate is string
        && request.resource.data.expiryDate is string
        && request.resource.data.status is string
        && validGeneratedCertificateStatus(request.resource.data.status)
        && request.resource.data.institution is string;
