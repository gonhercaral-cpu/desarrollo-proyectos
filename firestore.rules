rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasOnlyFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function hasAllFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function changesOnly(incomingData, storedData, fields) {
      return incomingData.diff(storedData).affectedKeys().hasOnly(fields);
    }

    function changesAny(incomingData, storedData, fields) {
      return incomingData.diff(storedData).affectedKeys().hasAny(fields);
    }

    function validStringField(data, field) {
      return data[field] is string;
    }

    function validNumberField(data, field) {
      return data[field] is number;
    }

    function validBoolField(data, field) {
      return data[field] is bool;
    }

    function validListField(data, field) {
      return data[field] is list;
    }

    function validMapField(data, field) {
      return data[field] is map;
    }

    function validTimestampField(data, field) {
      return data[field] is timestamp;
    }

    function validNonEmptyStringField(data, field) {
      return data[field] is string && data[field].size() > 0;
    }

    function validStringPair(data, field1, field2) {
      return validStringField(data, field1)
          && validStringField(data, field2);
    }

    function validStringTriple(data, field1, field2, field3) {
      return validStringField(data, field1)
          && validStringField(data, field2)
          && validStringField(data, field3);
    }

    function validStringSix(data, field1, field2, field3, field4, field5, field6) {
      return validStringField(data, field1)
          && validStringField(data, field2)
          && validStringField(data, field3)
          && validStringField(data, field4)
          && validStringField(data, field5)
          && validStringField(data, field6);
    }

    function validNonEmptyStringPair(data, field1, field2) {
      return validNonEmptyStringField(data, field1)
          && validNonEmptyStringField(data, field2);
    }

    function validNonEmptyStringTriple(data, field1, field2, field3) {
      return validNonEmptyStringField(data, field1)
          && validNonEmptyStringField(data, field2)
          && validNonEmptyStringField(data, field3);
    }





    function validOptionalStringTriple(data, field1, field2, field3) {
      return validOptionalStringField(data, field1)
          && validOptionalStringField(data, field2)
          && validOptionalStringField(data, field3);
    }

    function validOptionalStringSix(data, field1, field2, field3, field4, field5, field6) {
      return validOptionalStringField(data, field1)
          && validOptionalStringField(data, field2)
          && validOptionalStringField(data, field3)
          && validOptionalStringField(data, field4)
          && validOptionalStringField(data, field5)
          && validOptionalStringField(data, field6);
    }

    function validNonNegativeNumberPair(data, field1, field2) {
      return validNonNegativeNumberField(data, field1)
          && validNonNegativeNumberField(data, field2);
    }

    function validNonNegativeNumberTriple(data, field1, field2, field3) {
      return validNonNegativeNumberField(data, field1)
          && validNonNegativeNumberField(data, field2)
          && validNonNegativeNumberField(data, field3);
    }

    function validNonNegativeNumberSix(data, field1, field2, field3, field4, field5, field6) {
      return validNonNegativeNumberField(data, field1)
          && validNonNegativeNumberField(data, field2)
          && validNonNegativeNumberField(data, field3)
          && validNonNegativeNumberField(data, field4)
          && validNonNegativeNumberField(data, field5)
          && validNonNegativeNumberField(data, field6);
    }



    function validOptionalListTriple(data, field1, field2, field3) {
      return validOptionalListField(data, field1)
          && validOptionalListField(data, field2)
          && validOptionalListField(data, field3);
    }



    function validOptionalNumberTriple(data, field1, field2, field3) {
      return validOptionalNumberField(data, field1)
          && validOptionalNumberField(data, field2)
          && validOptionalNumberField(data, field3);
    }

    function validTimestampPair(data, field1, field2) {
      return validTimestampField(data, field1)
          && validTimestampField(data, field2);
    }

    function validBoolPair(data, field1, field2) {
      return validBoolField(data, field1)
          && validBoolField(data, field2);
    }



    function validCurrentUserIdentityFields(data, uidField, nameField, emailField) {
      return data[uidField] == request.auth.uid
        && validStringField(data, nameField)
        && validStringField(data, emailField);
    }

    function validBoundedStringField(data, field, maximum) {
      return data[field] is string && data[field].size() <= maximum;
    }

    function validNonEmptyBoundedStringField(data, field, maximum) {
      return data[field] is string
        && data[field].size() > 0
        && data[field].size() <= maximum;
    }

    function validNonNegativeNumberField(data, field) {
      return data[field] is number && data[field] >= 0;
    }

    function validPositiveNumberField(data, field) {
      return data[field] is number && data[field] > 0;
    }

    function validOptionalStringField(data, field) {
      return !(field in data) || data[field] is string;
    }



    function validOptionalBoolField(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function validOptionalListField(data, field) {
      return !(field in data) || data[field] is list;
    }



    function validOptionalNumberField(data, field) {
      return !(field in data) || data[field] is number;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }



    function userDoc() {
      return get(userPath());
    }

    function hasProfile() {
      return signedIn() && userDoc().data.active == true;
    }

    function role() {
      return userDoc().data.role;
    }



    function profileDataHasAdminRole(profileData) {
      return profileData.role is string
        && profileData.role.lower().matches('^ *admin *$');
    }

    function profileDataHasAnyDepartmentName(profileData, exactNames, normalizedNames) {
      return (
          profileData.area is string
          && profileData.area.lower() in normalizedNames
        )
        || (
          profileData.department is string
          && profileData.department.lower() in normalizedNames
        )
        || (
          profileData.departmentName is string
          && profileData.departmentName.lower() in normalizedNames
        )
        || (
          profileData.team is string
          && profileData.team.lower() in normalizedNames
        )
        || (
          profileData.departmentNames is list
          && profileData.departmentNames.hasAny(exactNames)
        )
        || (
          profileData.departments is list
          && profileData.departments.hasAny(exactNames)
        );
    }

    function profileDataIsTechnicalSupport(profileData) {
      return profileDataHasAnyDepartmentName(
        profileData,
        [
          "Soporte Técnico",
          "Soporte tecnico",
          "Soporte técnico",
          "Soporte Técnico / Imprenta",
          "Soporte Tecnico / Imprenta"
        ],
        [
          "soporte técnico",
          "soporte tecnico",
          "soporte técnico / imprenta",
          "soporte tecnico / imprenta"
        ]
      );
    }

    function profileDataIsPrintshop(profileData) {
      return profileDataHasAnyDepartmentName(
        profileData,
        [
          "Imprenta",
          "Impresión",
          "Impresion",
          "Soporte Técnico",
          "Soporte tecnico",
          "Soporte técnico"
        ],
        [
          "imprenta",
          "impresión",
          "impresion",
          "soporte técnico",
          "soporte tecnico"
        ]
      );
    }



    function hasAdminRole() {
      return profileDataHasAdminRole(userDoc().data);
    }







    function isAdminRole() {
      let profileData = userDoc().data;
      return signedIn() && profileDataHasAdminRole(profileData);
    }

    function isAdmin() {
      let profileData = userDoc().data;
      return signedIn()
        && profileData.active == true
        && profileDataHasAdminRole(profileData);
    }

    function isMaterialDevelopmentDepartment() {
      let currentUserData = userDoc().data;
      return (
          currentUserData.get("area", "") is string
          && currentUserData.get("area", "").lower() in [
            "desarrollo de material",
            "desarrollo-de-material"
          ]
        )
        || (
          currentUserData.get("department", "") is string
          && currentUserData.get("department", "").lower() in [
            "desarrollo de material",
            "desarrollo-de-material"
          ]
        )
        || (
          currentUserData.get("departmentName", "") is string
          && currentUserData.get("departmentName", "").lower() in [
            "desarrollo de material",
            "desarrollo-de-material"
          ]
        )
        || (
          currentUserData.get("primaryDepartmentId", "") in [
            "desarrollo-de-material",
            "Desarrollo de Material"
          ]
        )
        || (
          currentUserData.get("departmentIds", []) is list
          && (
            "desarrollo-de-material" in currentUserData.get("departmentIds", [])
            || "Desarrollo de Material" in currentUserData.get("departmentIds", [])
          )
        )
        || (
          currentUserData.get("departments", []) is list
          && (
            "desarrollo-de-material" in currentUserData.get("departments", [])
            || "Desarrollo de Material" in currentUserData.get("departments", [])
          )
        );
    }

    function canAccessMaterialCorrections() {
      return isAdmin()
        || (
          hasProfile()
          && (role() is string ? role().lower() : role()) == "collaborator"
          && isMaterialDevelopmentDepartment()
        );
    }

    function editorialProjectPath(projectId) {
      return /databases/$(database)/documents/editorialProjects/$(projectId);
    }



    function editorialProjectData(projectId) {
      return get(editorialProjectPath(projectId)).data;
    }

    function matchesEditorialProjectCollaborator(data) {
      return data.get("collaboratorUids", []) is list
        && request.auth.uid in data.get("collaboratorUids", []);
    }



    function canAccessEditorialProjectData(data) {
      return hasProfile()
        && (
          hasAdminRole()
          || data.get("ownerUid", "") == request.auth.uid
          || matchesEditorialProjectCollaborator(data)
        );
    }

    function canAccessEditorialProject(projectId) {
      return canAccessEditorialProjectData(editorialProjectData(projectId));
    }

    function canEditEditorialProject(projectId) {
      return canAccessEditorialProject(projectId);
    }

    function canCreateEditorialProjectChild(projectId) {
      return hasProfile()
        && getAfter(editorialProjectPath(projectId)).data.ownerUid == request.auth.uid;
    }

    // Fase 7 — Permisos editoriales por usuario (mínimo privilegio). El nivel
    // explícito puede degradar a viewer/commenter aunque sea colaborador. Los
    // niveles por departamento no se evalúan aquí (limitación de reglas); el
    // control fino de departamento vive en la capa de servicios/UI.
    function editorialUserLevel(projectId) {
      return editorialProjectData(projectId).get("editorialPermissions", {}).get("users", {}).get(request.auth.uid, "");
    }

    function isEditorialOwnerOrAdmin(projectId) {
      return hasProfile()
        && (
          hasAdminRole()
          || editorialProjectData(projectId).ownerUid == request.auth.uid
        );
    }

    // Edición de contenido: colaborador con acceso y cuyo nivel explícito no sea
    // viewer ni commenter (sin nivel explícito = editor de contenido por
    // compatibilidad con Fases 1–6).
    function canEditEditorialContent(projectId) {
      return canEditEditorialProject(projectId)
        && (
          isEditorialOwnerOrAdmin(projectId)
          || (editorialUserLevel(projectId) != "viewer" && editorialUserLevel(projectId) != "commenter")
        );
    }

    // Comentarios: viewer bloqueado; commenter y superiores permitidos.


    // Publicar/despublicar/archivar: publisher, manager, propietario o admin.


    function editorialTemplatePath(templateId) {
      return /databases/$(database)/documents/editorialTemplates/$(templateId);
    }

    function editorialTemplateData(templateId) {
      return get(editorialTemplatePath(templateId)).data;
    }

    function canAccessEditorialTemplate(templateId) {
      return exists(editorialTemplatePath(templateId))
        && (
          isAdmin()
          || (hasProfile() && editorialTemplateData(templateId).visibility == "institutional")
          || (
            editorialTemplateData(templateId).projectId is string
            && canAccessEditorialProject(editorialTemplateData(templateId).projectId)
          )
        );
    }

    function canEditEditorialTemplate(templateId) {
      return (
          isAdmin()
          || (
            getAfter(editorialTemplatePath(templateId)).data.visibility == "project"
            && getAfter(editorialTemplatePath(templateId)).data.ownerUid == request.auth.uid
            && canEditEditorialProject(getAfter(editorialTemplatePath(templateId)).data.projectId)
          )
        );
    }

    function validEditorialProjectCreate() {
      let incomingData = request.resource.data;
      return hasProfile()
        && hasAllFields(incomingData, [
          "name",
          "type",
          "size",
          "orientation",
          "margins",
          "bleedIn",
          "ownerUid",
          "collaboratorUids",
          "archived",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && validNonEmptyStringField(incomingData, "name")
        && incomingData.type in [
          "book",
          "booklet",
          "activity_sheet",
          "song_sheet",
          "exam",
          "teacher_guide",
          "extra_material",
          "custom"
        ]
        && validStringField(incomingData, "size")
        && incomingData.orientation in ["portrait", "landscape"]
        && validMapField(incomingData, "margins")
        && validNumberField(incomingData, "bleedIn")
        && incomingData.ownerUid == request.auth.uid
        && validListField(incomingData, "collaboratorUids")
        && incomingData.archived == false
        && incomingData.status == "active";
    }


    function validAutoApprovalReason(reason) {
      return reason in ["assembly", "specialMeeting", "theocraticEvent"];
    }

    function scheduleRequestPath(requestId) {
      return /databases/$(database)/documents/scheduleRequests/$(requestId);
    }



    function validScheduleRequestCreate() {
      let incomingData = request.resource.data;
      return hasProfile()
        && incomingData.userId == request.auth.uid
        && (
          incomingData.status == "pending"
          || (
            incomingData.status == "approved"
            && incomingData.autoApproved == true
            && validAutoApprovalReason(incomingData.autoApprovalReason)
          )
        );
    }

    function validAutoScheduleAdjustmentCreate() {
      let incomingData = request.resource.data;
      return hasProfile()
        && incomingData.userId == request.auth.uid
        && validStringField(incomingData, "sourceRequestId")
        && incomingData.autoApproved == true
        && validAutoApprovalReason(incomingData.autoApprovalReason)
        && exists(scheduleRequestPath(incomingData.sourceRequestId))
        && get(scheduleRequestPath(incomingData.sourceRequestId)).data.userId == request.auth.uid
        && get(scheduleRequestPath(incomingData.sourceRequestId)).data.status == "approved"
        && get(scheduleRequestPath(incomingData.sourceRequestId)).data.autoApproved == true
        && get(scheduleRequestPath(incomingData.sourceRequestId)).data.autoApprovalReason == incomingData.autoApprovalReason;
    }

    function validAutoScheduleLogCreate() {
      let incomingData = request.resource.data;
      return hasProfile()
        && incomingData.action == "autoApproved"
        && validStringField(incomingData, "requestId")
        && incomingData.autoApproved == true
        && validAutoApprovalReason(incomingData.autoApprovalReason)
        && exists(scheduleRequestPath(incomingData.requestId))
        && get(scheduleRequestPath(incomingData.requestId)).data.userId == request.auth.uid
        && get(scheduleRequestPath(incomingData.requestId)).data.status == "approved"
        && get(scheduleRequestPath(incomingData.requestId)).data.autoApproved == true
        && get(scheduleRequestPath(incomingData.requestId)).data.autoApprovalReason == incomingData.autoApprovalReason;
    }







    function isRequester() {
      return hasProfile() && role() == "requester";
    }

    function hasUserArea() {
      return hasProfile() && userDoc().data.area is string;
    }

    function userHasAnyDepartmentName(exactNames, normalizedNames) {
      let profileData = userDoc().data;
      return signedIn()
        && profileData.active == true
        && profileDataHasAnyDepartmentName(profileData, exactNames, normalizedNames);
    }





    function canManageTechnicalSupport() {
      let profileData = userDoc().data;
      return signedIn()
        && profileData.active == true
        && (
          profileDataHasAdminRole(profileData)
          || profileDataIsTechnicalSupport(profileData)
        );
    }

    function canAccessTechnicalSupport() {
      return canManageTechnicalSupport();
    }



    function canAccessPrintshop() {
      let profileData = userDoc().data;
      return signedIn()
        && profileData.active == true
        && (
          profileDataHasAdminRole(profileData)
          || profileDataIsPrintshop(profileData)
        );
    }

    function canCreatePrintProduct() {
      let profileData = userDoc().data;
      return signedIn()
        && profileData.active == true
        && (
          profileDataHasAdminRole(profileData)
          || (
            profileData.role is string
            && profileData.role.lower() == "collaborator"
            && (profileDataHasAnyDepartmentName(
        (profileData),
        ["Imprenta", "Impresión", "Impresion"],
        ["imprenta", "impresión", "impresion"]
      ))
          )
        );
    }

    function projectPath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId);
    }

    function projectExists(projectId) {
      return exists(projectPath(projectId));
    }

    function projectData(projectId) {
      return get(projectPath(projectId)).data;
    }

    function projectUserMatchesField(data, field) {
      return data[field] == request.auth.uid;
    }

    function projectUserInListField(data, field) {
      return data[field] is list && request.auth.uid in data[field];
    }

    function projectMatchesAssignment(data) {
      return projectUserMatchesField(data, "assignedToUid")
        || projectUserMatchesField(data, "assignedToId")
        || projectUserMatchesField(data, "assignedTo")
        || projectUserMatchesField(data, "responsibleUid")
        || projectUserMatchesField(data, "responsibleId");
    }

    function projectMatchesCollaboration(data) {
      return projectUserInListField(data, "collaboratorIds")
        || projectUserInListField(data, "collaboratorUids")
        || projectUserInListField(data, "collaboratorsIds")
        || projectUserInListField(data, "collaborators");
    }

    function projectMatchesCreator(data) {
      return projectUserMatchesField(data, "createdByUid")
        || projectUserMatchesField(data, "createdBy");
    }

    function projectMatchesRequesterArea(data) {
      let currentUserData = userDoc().data;
      return (
          "requesterArea" in data
          && data.requesterArea == currentUserData.area
        )
        || (
          "responsibleArea" in data
          && data.responsibleArea == currentUserData.area
        );
    }

    function isHistoricalProjectData(data) {
      return data.deleted == true
        || data.archived == true
        || data.status == "Eliminado"
        || data.status == "Finalizado"
        || data.status == "Terminado"
        || data.status == "Cancelado"
        || data.status == "Archivado";
    }

    function isAssignedToProject() {
      return hasProfile() && projectMatchesAssignment(resource.data);
    }

    function isAssignedToProjectId(projectId) {
      return hasProfile() && projectMatchesAssignment(projectData(projectId));
    }

    function isCollaboratorInProject() {
      return hasProfile() && projectMatchesCollaboration(resource.data);
    }

    function isCollaboratorInProjectId(projectId) {
      return hasProfile() && projectMatchesCollaboration(projectData(projectId));
    }

    function isCreatorOfProject() {
      return hasProfile() && projectMatchesCreator(resource.data);
    }

    function isCreatorOfProjectId(projectId) {
      return hasProfile() && projectMatchesCreator(projectData(projectId));
    }





    function canAccessProject() {
      let profileData = userDoc().data;
      return (signedIn() && profileData.active == true)
        && (
          profileDataHasAdminRole(profileData) ||
          isAssignedToProject() ||
          isCollaboratorInProject() ||
          isCreatorOfProject() ||
          (hasProfile()
        && isRequester()
        && hasUserArea()
        && projectMatchesRequesterArea(resource.data))
        );
    }

    function canAccessProjectId(projectId) {
      let profileData = userDoc().data;
      return (signedIn() && profileData.active == true)
        && projectExists(projectId)
        && (
          profileDataHasAdminRole(profileData) ||
          isAssignedToProjectId(projectId) ||
          isCollaboratorInProjectId(projectId) ||
          isCreatorOfProjectId(projectId) ||
          (hasProfile()
        && isRequester()
        && hasUserArea()
        && projectMatchesRequesterArea(projectData((projectId))))
        );
    }

    function canWorkOnProject() {
      let profileData = userDoc().data;
      return (signedIn() && profileData.active == true)
        && !(isHistoricalProjectData(resource.data))
        && (
          profileDataHasAdminRole(profileData) ||
          isAssignedToProject() ||
          isCollaboratorInProject() ||
          isCreatorOfProject()
        );
    }

    function canWorkOnProjectId(projectId) {
      let profileData = userDoc().data;
      return (signedIn() && profileData.active == true)
        && projectExists(projectId)
        && !(isHistoricalProjectData(projectData((projectId))))
        && (
          profileDataHasAdminRole(profileData) ||
          isAssignedToProjectId(projectId) ||
          isCollaboratorInProjectId(projectId) ||
          isCreatorOfProjectId(projectId)
        );
    }

    function validProjectStatus(status) {
      return status in [
        "Pendiente",
        "Por iniciar",
        "Asignado",
        "En planeación",
        "En proceso",
        "En espera de información",
        "Listo para revisión",
        "Correcciones solicitadas",
        "Aprobado para entrega",
        "Finalizado",
        "Terminado",
        "Cancelado",
        "Pausado",
        "Eliminado",
        "Archivado"
      ];
    }



    function hasValidProgress() {
      return request.resource.data.progress is number
        && request.resource.data.progress >= 0
        && request.resource.data.progress <= 100;
    }









    function collaboratorAllowedProjectUpdate() {
      let incomingData = request.resource.data;
      let storedData = resource.data;
      return canWorkOnProject()
        && !changesAny(incomingData, storedData, [
          "reviewStatus",
          "adminReview",
          "reviewedAt",
          "reviewedByUid",
          "reviewedByName",
          "reviewedByEmail",
          "reviewComment"
        ])
        && changesOnly(incomingData, storedData, [
          "status",
          "progress",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
          "updatedByEmail",

          "closedAt",
          "closedByUid",
          "closedByName",

          "history",
          "formalHistory",
          "projectHistory",

          "comments",
          "projectComments",
          "lastCommentAt",
          "lastCommentByUid",
          "lastCommentByName",
          "lastCommentByEmail",

          "evidenceFiles",
          "evidences",
          "evidence",
          "files",
          "attachments",
          "attachedFiles",
          "projectFiles",
          "documents",
          "uploadedFiles",
          "lastEvidenceAt",
          "lastEvidenceByUid",
          "lastEvidenceByName",
          "lastEvidenceByEmail",

          "advances",
          "projectUpdates",
          "progressUpdates",
          "lastAdvanceAt",
          "lastAdvanceByUid",
          "lastAdvanceByName",
          "lastAdvanceByEmail",

          "activity",
          "recentActivity",
          "lastActivityAt",
          "lastActivityByUid",
          "lastActivityByName",
          "lastActivityByEmail",

          "reviewChecklist"
        ])
        && (
          !changesAny(incomingData, storedData, [
            "status"
          ])
          || (request.resource.data.status is string
        && ((request.resource.data.status) in [
        "Por iniciar",
        "Asignado",
        "En planeación",
        "En proceso",
        "En espera de información",
        "Listo para revisión",
        "Pausado"
      ]))
        )
        && (
          !changesAny(incomingData, storedData, [
            "progress"
          ])
          || hasValidProgress()
        );
    }

    function adminValidProjectCreate() {
      let incomingData = request.resource.data;
      return isAdmin()
        && incomingData.createdByUid == request.auth.uid
        && validNonEmptyStringField(incomingData, "title")
        && validProjectStatus(incomingData.status)
        && (
          validStringField(incomingData, "assignedToId") ||
          validStringField(incomingData, "assignedToUid")
        );
    }

    function adminValidProjectUpdate() {
      let incomingData = request.resource.data;
      return isAdmin()
        && (
          !("title" in incomingData) ||
          (
            validNonEmptyStringField(incomingData, "title")
          )
        )
        && (
          !("status" in incomingData) ||
          (request.resource.data.status is string
        && validProjectStatus(request.resource.data.status))
        )
        && (
          !("progress" in incomingData) ||
          hasValidProgress()
        );
