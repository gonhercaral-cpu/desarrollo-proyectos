      allow create: if validDepartmentMessageCreate();

      allow update: if validDepartmentMessageReadUpdate();


    }

    match /notifications/{notificationId} {
      allow get, list: if hasProfile() && resource.data.recipientId == request.auth.uid;

      // Las notificaciones operativas solo se crean desde Cloud Functions.

      allow update: if validNotificationReadUpdate();

    }

    match /users/{userId} {
      allow get: if signedIn() && (
        userId == request.auth.uid ||
        isAdmin()
      );

      allow list: if (
