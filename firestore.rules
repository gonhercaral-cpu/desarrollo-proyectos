    match /printshopLogs/{logId} {


      allow create: if (hasProfile())
        && validPrintshopLogData();

    }

    match /publicCertificateValidations/{validationId} {


      allow create, update: if canManageGeneratedCertificateData()
        && validPublicCertificateValidationData();

    }

    match /publicCertificatePeople/{personId} {
      allow read: if resource.data.active == true
        && resource.data.type in ["Principal", "Teacher"];
    }

    match /publicCredentialValidations/{validationId} {


      allow create, update: if canAccessPrintshop()
        && (validCredentialCoreData(request.resource.data)
        && validStringField(request.resource.data, "institution"));

