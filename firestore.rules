        && canManageGeneratedCertificateRequest(request.resource.data.requestId);

      allow update: if request.resource.data.requestId == resource.data.requestId
        && request.resource.data.requestId == batchId
        && canManageGeneratedCertificateRequest(resource.data.requestId);

