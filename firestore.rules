    function validCertificateRequestCampus(campus) {
      return campus in [
        "Plaza Estrella",
        "Plaza Bugambilias",
        "Plaza Aranjuez",
        "Online"
      ];
    }

    function validCertificateRequestCreate() {
      return request.resource.data.keys().hasOnly([
        "folio",
        "campus",
        "academicDirector",
        "requestedDeliveryDate",
        "certificateType",
        "courseLevel",
        "notes",
        "students",
        "status",
        "statusLabel",
        "publicTrackingEnabled",
        "createdAt",
        "updatedAt",
        "createdBy"
      ])
      && request.resource.data.folio is string
      && request.resource.data.folio.size() > 0
      && request.resource.data.campus is string
      && validCertificateRequestCampus(request.resource.data.campus)
      && request.resource.data.academicDirector is string
      && request.resource.data.academicDirector.size() > 0
      && request.resource.data.requestedDeliveryDate is string
      && request.resource.data.certificateType == "Certificado"
      && request.resource.data.courseLevel is string
      && request.resource.data.courseLevel.size() > 0
      && request.resource.data.notes is string
      && request.resource.data.students is list
      && request.resource.data.students.size() > 0
      && request.resource.data.students.size() <= 100
      && request.resource.data.status == "received"
      && request.resource.data.statusLabel == "Solicitud recibida"
      && request.resource.data.publicTrackingEnabled == true
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp
      && request.resource.data.createdBy == "public-form";
    }

    function validPrintshopSoftDeleteUpdate() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "active",
          "deleted",
          "deletedAt",
          "deletedByUid",
          "deletedByName",
          "deletedByEmail",
          "updatedAt",
          "updatedByUid",
          "updatedByName",
