    function validPrintProductionBatchData() {
      let incomingData = request.resource.data;
      return validNonEmptyStringField(incomingData, "folio")
        && validStringSix(incomingData, "productId", "responsible", "responsibleUid", "responsibleName", "responsibleEmail", "auditorUid")
        && validStringSix(incomingData, "auditorName", "auditorEmail", "startDate", "dueDate", "notes", "qualityNotes")
        && validNonNegativeNumberTriple(incomingData, "producedQuantity", "approvedQuantity", "rejectedQuantity")
        && (validOptionalBoolField((incomingData), ("assignmentSinglePersonFallback"))
          && validOptionalBoolField((incomingData), ("assignmentLocked"))
          && validOptionalBoolField((incomingData), ("assignmentPending")))
        && validBoolPair(incomingData, "qualityCompleted", "inventoryApplied")
        && validOptionalStringSix(incomingData, "qualityReviewedByUid", "qualityReviewedByName", "qualityReviewedByEmail", "assignmentSource", "assignedByUid", "assignedByName")
        && (validOptionalStringField((incomingData), ("assignedByEmail"))
          && validOptionalStringField((incomingData), ("inventoryId")))
        && (
          (
            incomingData.productId.size() > 0
            && exists(/databases/$(database)/documents/printProducts/$(incomingData.productId))
          )
          || (
            validCertificateTemplateType(incomingData.category)
            && validNonEmptyStringField(incomingData, "productName")
          )
        )
        && validNonEmptyStringField(incomingData, "productName")
        && validPrintProductCategory(incomingData.category)
        && validFinishedPrintLevel(incomingData.level)
        && validPrintUnit(incomingData.unit)
        && validPositiveNumberField(incomingData, "plannedQuantity")
        && incomingData.approvedQuantity + incomingData.rejectedQuantity <= incomingData.producedQuantity
        && ((incomingData.status) in [
        "Planeado",
        "Pendiente de asignación",
        "En impresión",
        "En encuadernado",
        "En revisión de calidad",
        "Aprobado",
        "Aprobado con observaciones",
        "Ingresado a inventario",
        "Cerrado",
        "Cancelado"
      ])
        && (
          (
            incomingData.status == "Pendiente de asignación"
            && incomingData.responsibleUid.size() == 0
            && incomingData.auditorUid.size() == 0
          )
          || (
            incomingData.responsibleUid.size() > 0
            && incomingData.responsibleName.size() > 0
            && incomingData.auditorUid.size() > 0
            && incomingData.auditorName.size() > 0
            && (
              incomingData.responsibleUid != incomingData.auditorUid
              || (
                incomingData.responsibleUid == incomingData.auditorUid
                && incomingData.assignmentSinglePersonFallback == true
                && incomingData.assignmentSource == "automatic"
              )
            )
          )
        )
        && validListField(incomingData, "qualityChecklist")
        && incomingData.qualityChecklist.size() == 10
        && ((incomingData.qualityStatus) in [
        "Pendiente",
        "En revisión",
        "Aprobado",
        "Aprobado con observaciones",
        "Rechazado"
      ])
        && (
          incomingData.status in [
            "Planeado",
            "Pendiente de asignación",
            "En impresión",
            "En encuadernado",
            "En revisión de calidad",
            "Cancelado"
          ]
          || incomingData.qualityCompleted == true
        )
        && (
          incomingData.qualityCompleted == false
          || incomingData.qualityStatus in [
            "Aprobado",
            "Aprobado con observaciones",
            "Rechazado"
          ]
        )
        && (
          !incomingData.inventoryApplied
          || incomingData.status in ["Ingresado a inventario", "Cerrado"]
        )
        && (
          !(incomingData.status in ["Ingresado a inventario", "Cerrado"])
          || incomingData.inventoryApplied == true
        )
        && (
          !("assignmentVersion" in incomingData)
          || (
            validNonNegativeNumberField(incomingData, "assignmentVersion")
          )
        )
        && (
          !("assignedAt" in incomingData)
          || incomingData.assignedAt == null
          || validTimestampField(incomingData, "assignedAt")
        )
        && (
          !("progress" in incomingData)
          || (
            validNonNegativeNumberField(incomingData, "progress")
            && incomingData.progress <= 100
          )
        )
        && validOptionalStringField(incomingData, "inventoryMovementId");
    }









    function validCertificateSignerData() {
