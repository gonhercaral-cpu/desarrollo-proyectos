          "adminComment",
          "adminHistory",
          "createdAt",
          "updatedAt",
          "lastActivityAt",
          "searchableText"
        ])
        && incomingData.reporterUid == request.auth.uid
        && validNonEmptyBoundedStringField(incomingData, "title", 140)
        && ((incomingData.priority) in ["baja", "media", "alta", "critica"])
        && incomingData.status == "nuevo"
        && validListField(incomingData, "evidenceFiles")
        && (!("adminComment" in incomingData) || incomingData.adminComment == "")
        && validOptionalListField(incomingData, "adminHistory")
        && validTimestampField(incomingData, "lastActivityAt");
