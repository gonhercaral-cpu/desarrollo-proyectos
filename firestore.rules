      match /comments/{commentId} {
        allow get, list: if canAccessMaterialCorrections();
      }

      match /history/{historyId} {
        allow get, list: if canAccessMaterialCorrections();
      }

      match /evidences/{evidenceId} {
        allow get, list: if canAccessMaterialCorrections();
      }

      match /duplicateReporters/{duplicateId} {
        allow get, list: if canAccessMaterialCorrections();
      }
    }








    match /certificateSigners/{signerId} {


