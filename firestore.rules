    function validCredentialTemplateData() {
      let incomingData = request.resource.data;
      return validNonEmptyStringField(incomingData, "name")
        && validStringTriple(incomingData, "notes", "backImageUrl", "backImageDataUrl")
        && validStringField(incomingData, "backStoragePath")
        && validNonEmptyStringTriple(incomingData, "frontImageUrl", "frontImageDataUrl", "frontStoragePath")
        && (
          !("orientation" in incomingData)
          || (
            incomingData.orientation in [
              "horizontal",
              "vertical"
            ]
          )
        )
        && validBoolField(incomingData, "active")
        && validMapField(incomingData, "positions")
        && (validOptionalListField((incomingData), ("customTexts"))
          && validOptionalListField((incomingData), ("customImages")));
    }

    function validPrintRequestStatus(status) {
      return status in [
        "Solicitud recibida",
        "Datos incompletos",
        "En revisión",
        "Aprobada",
        "En producción",
        "En revisión de calidad",
        "Lista para entrega",
        "Entregada",
        "Cancelada"
      ];
