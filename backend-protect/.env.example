PORT=8080

# Debe incluir el prefijo de la integration API de Protect, ej:
# https://192.168.1.1/proxy/protect/integration/v1
UNIFI_PROTECT_BASE_URL=
UNIFI_PROTECT_API_KEY=

# Solo desarrollo: consolas locales usan certificado autofirmado.
UNIFI_PROTECT_ALLOW_SELF_SIGNED=false

FIREBASE_PROJECT_ID=
# Opcional: ruta al archivo de credenciales de servicio si no usas ADC.
GOOGLE_APPLICATION_CREDENTIALS=

ALLOWED_ORIGINS=http://localhost:5173,https://sistema-desarrollo-proyectos.web.app
